POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
# 64 个十六进制字符（32 字节）。WIF 身份联合必须使用固定值，留空时后端会拒绝创建 WIF 账号。
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# ParaGateway default: skip the upstream first-login administrator acknowledgement gate.
PARAGATEWAY_DISABLE_ADMIN_COMPLIANCE=true
SERVER_PORT=8080
TZ=Asia/Shanghai
