{
  admin off
  auto_https off
}

:8282 {
  bind 127.0.0.1
  root * %RELEASE_ROOT%
  @backend path /api /api/* /v1 /v1/* /models /models/* /health /setup/status
  handle @backend {
    reverse_proxy 127.0.0.1:8284
    flush_interval -1
  }
  handle {
    try_files {path} /index.html
    file_server
  }
}
