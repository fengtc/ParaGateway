[Unit]
Description=ParaGateway backend (%i)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=sub2api
Group=sub2api
WorkingDirectory=/opt/paragateway/releases/%i/backend
EnvironmentFile=/etc/paragateway/%i/backend.env
Environment=CONFIG_FILE=/etc/paragateway/%i/config.yaml
Environment=SERVER_HOST=127.0.0.1
Environment=SERVER_PORT=8284
ExecStart=/opt/paragateway/releases/%i/backend/paragateway-backend
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
LimitNOFILE=524288
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paragateway-backend-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StateDirectory=paragateway-backend-%i
ReadWritePaths=/var/lib/paragateway-backend
