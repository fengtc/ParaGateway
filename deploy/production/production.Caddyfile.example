{
  admin off
  auto_https off
}

:8182 {
  bind 127.0.0.1

  root * %RELEASE_ROOT%

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    X-Frame-Options DENY
  }

  @backend path /api /api/* /v1 /v1/* /v1beta /v1beta/* /models /models/* /backend-api /backend-api/* /antigravity /antigravity/* /responses /responses/* /messages /messages/* /chat /chat/* /embeddings /embeddings/* /images /images/* /videos /videos/* /tts /tts/* /stt /stt/* /custom-voices /custom-voices/* /realtime /realtime/* /live /live/* /web_search /web_search/* /x_search /x_search/* /alpha /alpha/* /openai /openai/* /health /setup/status /setup/test-db /setup/test-redis /setup/install /api/event_logging/batch

  handle @backend {
    reverse_proxy 127.0.0.1:8184 {
      trusted_proxies 127.0.0.1/32
      header_up Host {upstream_hostport}
      flush_interval -1
    }
  }

  @entry path / /index.html /admin/*
  header @entry Cache-Control "no-store, max-age=0"

  @framework path /_framework/*
  header @framework Cache-Control "public, max-age=31536000, immutable"

  handle {
    try_files {path} /index.html
    file_server {
      precompressed br gzip
    }
  }
}
