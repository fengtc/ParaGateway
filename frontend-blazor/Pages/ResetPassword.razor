@page "/reset-password"
@layout AuthLayout
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>重置密码 · ParaGateway</PageTitle>

<div class="login-page">
    <div class="login-brand"><BrandMark /><span><strong>ParaGateway</strong><small>Gateway</small></span></div>
    <section class="login-panel">
        @if (completed)
        {
            <header><h1>密码已重置</h1><p>可以使用新密码登录。</p></header>
            <a class="button primary login-button" href="/login">登录</a>
        }
        else
        {
            <header><h1>重置密码</h1><p>重置链接仅可使用一次，并且会在有效期后失效。</p></header>
            @if (error is not null) { <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@error</span></div> }
            <EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="reset-password">
                <DataAnnotationsValidator />
                <div class="form-field"><label for="reset-email">邮箱</label><InputText id="reset-email" @bind-Value="form.Email" type="email" readonly="@(!string.IsNullOrWhiteSpace(form.Email))" /><ValidationMessage For="() => form.Email" /></div>
                <div class="form-field"><label for="reset-token">重置 token</label><InputText id="reset-token" @bind-Value="form.Token" /><ValidationMessage For="() => form.Token" /></div>
                <div class="form-field"><label for="reset-password">新密码</label><InputText id="reset-password" @bind-Value="form.NewPassword" type="password" autocomplete="new-password" /><ValidationMessage For="() => form.NewPassword" /></div>
                <div class="form-field"><label for="reset-confirm">确认新密码</label><InputText id="reset-confirm" @bind-Value="form.ConfirmPassword" type="password" autocomplete="new-password" /><ValidationMessage For="() => form.ConfirmPassword" /></div>
                <button type="submit" class="button primary login-button" disabled="@busy">@(busy ? "正在重置…" : "重置密码")</button>
            </EditForm>
            <div class="auth-footer"><a href="/forgot-password">重新申请链接</a></div>
        }
    </section>
</div>

@code {
    private readonly ResetPasswordRequest form = new();
    private bool busy;
    private bool completed;
    private string? error;

    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var pair in query)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2) continue;
            var key = Uri.UnescapeDataString(parts[0]);
            var value = Uri.UnescapeDataString(parts[1].Replace('+', ' '));
            if (key.Equals("email", StringComparison.OrdinalIgnoreCase)) form.Email = value;
            if (key.Equals("token", StringComparison.OrdinalIgnoreCase)) form.Token = value;
        }
    }

    private async Task SubmitAsync()
    {
        busy = true; error = null;
        try { await Api.ResetPasswordAsync(form); completed = true; }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
