@page "/admin/announcements"
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>公告管理 · ParaGateway</PageTitle>
<div class="page-header"><div><h1>公告管理</h1><p>发布、定时和维护面板公告；支付相关页面不会在此显示。</p></div><button type="button" class="button primary" @onclick="OpenCreate"><Icon Name="plus" Size="17" /> 新建公告</button></div>
<div class="toolbar"><div class="search-box"><Icon Name="search" Size="17" /><input value="@search" @oninput="SearchChanged" placeholder="搜索标题" aria-label="搜索公告" /></div><span class="result-count">@Filtered.Count 条公告</span><button type="button" class="icon-button" title="刷新" aria-label="刷新" disabled="@loading" @onclick="LoadAsync"><Icon Name="refresh" Size="17" /></button></div>
@if (loading) { <LoadingState Text="正在载入公告" /> } else if (error is not null) { <ErrorState Message="@error" OnRetry="LoadAsync" /> } else if (Filtered.Count == 0) { <EmptyState Title="暂无公告" Description="创建公告后，用户可以在自己的面板中查看。" /> } else { <DxGrid Data="@Filtered" KeyFieldName="Id" ShowFilterRow="true" ShowSearchPanel="true" PageSize="20"><Columns><DxGridDataColumn FieldName="Title" Caption="标题" MinWidth="220" /><DxGridDataColumn FieldName="Status" Caption="状态" Width="100" /><DxGridDataColumn FieldName="NotifyMode" Caption="通知方式" Width="110" /><DxGridDataColumn FieldName="StartsAt" Caption="开始时间" DisplayFormat="yyyy-MM-dd HH:mm" /><DxGridDataColumn FieldName="EndsAt" Caption="结束时间" DisplayFormat="yyyy-MM-dd HH:mm" /><DxGridDataColumn Caption="操作" Width="150"><CellDisplayTemplate Context="context">@{ var item = (AnnouncementDto)context.DataItem; }<button type="button" class="icon-button" title="编辑" aria-label="编辑" @onclick="() => OpenEdit(item)"><Icon Name="pencil" Size="16" /></button><button type="button" class="icon-button danger" title="删除" aria-label="删除" @onclick="() => DeleteAsync(item)"><Icon Name="trash" Size="16" /></button></CellDisplayTemplate></DxGridDataColumn></Columns></DxGrid> }
<AppModal Open="editorOpen" Title="@(editingId is null ? "新建公告" : "编辑公告")" OnClose="CloseEditor"><ChildContent><EditForm id="announcement-editor" Model="form" OnValidSubmit="SaveAsync" FormName="announcement-editor"><DataAnnotationsValidator /><ValidationSummary />@if (modalError is not null) { <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@modalError</span></div> }<div class="form-grid"><div class="form-field full"><label for="announcement-title">标题</label><InputText id="announcement-title" @bind-Value="form.Title" /><ValidationMessage For="() => form.Title" /></div><div class="form-field full"><label for="announcement-content">内容</label><InputTextArea id="announcement-content" @bind-Value="form.Content" rows="8" /><ValidationMessage For="() => form.Content" /></div><div class="form-field"><label for="announcement-status">状态</label><InputSelect id="announcement-status" @bind-Value="form.Status"><option value="draft">草稿</option><option value="active">发布</option><option value="archived">归档</option></InputSelect></div><div class="form-field"><label for="announcement-notify">通知方式</label><InputSelect id="announcement-notify" @bind-Value="form.NotifyMode"><option value="silent">静默</option><option value="popup">弹窗</option></InputSelect></div><div class="form-field"><label for="announcement-start">开始时间</label><InputDate id="announcement-start" @bind-Value="form.StartsAt" Type="InputDateType.DateTimeLocal" /></div><div class="form-field"><label for="announcement-end">结束时间</label><InputDate id="announcement-end" @bind-Value="form.EndsAt" Type="InputDateType.DateTimeLocal" /></div><div class="form-field full"><label for="announcement-targeting">目标规则 JSON</label><InputTextArea id="announcement-targeting" @bind-Value="form.TargetingJson" rows="5" placeholder='{"any_of":[]}' /></div></div></EditForm></ChildContent><Footer><button type="button" class="button secondary" @onclick="CloseEditor">取消</button><button type="submit" form="announcement-editor" class="button primary" disabled="@saving">保存</button></Footer></AppModal>
@code { private List<AnnouncementDto> announcements = []; private AnnouncementInput form = new(); private string search = string.Empty; private string? editingId; private string? error; private string? modalError; private bool loading = true; private bool saving; private bool editorOpen; private List<AnnouncementDto> Filtered => announcements.Where(x => string.IsNullOrWhiteSpace(search) || x.Title.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList(); protected override Task OnInitializedAsync() => LoadAsync(); private async Task LoadAsync() { loading = true; error = null; try { announcements = await Api.GetAnnouncementsAsync(); } catch (ApiException ex) { error = ex.Message; } finally { loading = false; } } private void SearchChanged(ChangeEventArgs args) => search = args.Value?.ToString() ?? string.Empty; private void OpenCreate() { editingId = null; form = new AnnouncementInput(); modalError = null; editorOpen = true; } private void OpenEdit(AnnouncementDto item) { editingId = item.Id.ToString(); form = new AnnouncementInput { Title = item.Title, Content = item.Content, Status = item.Status, NotifyMode = item.NotifyMode, StartsAt = item.StartsAt, EndsAt = item.EndsAt, TargetingJson = item.Targeting?.GetRawText() ?? "{}" }; modalError = null; editorOpen = true; } private void CloseEditor() => editorOpen = false; private async Task SaveAsync() { saving = true; modalError = null; try { if (editingId is null) await Api.CreateAnnouncementAsync(form); else await Api.UpdateAnnouncementAsync(editingId, form); editorOpen = false; Toasts.Success("公告已保存"); await LoadAsync(); } catch (ApiException ex) { modalError = ex.Message; } finally { saving = false; } } private async Task DeleteAsync(AnnouncementDto item) { try { await Api.DeleteAnnouncementAsync(item.Id.ToString()); Toasts.Success("公告已删除"); await LoadAsync(); } catch (ApiException ex) { error = ex.Message; } } }
