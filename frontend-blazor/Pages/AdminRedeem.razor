@page "/admin/redeem"
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>兑换码管理 · ParaGateway</PageTitle>
<div class="page-header"><div><h1>兑换码管理</h1><p>生成、查看和作废兑换码，不包含支付订单。</p></div><button type="button" class="button primary" @onclick="GenerateAsync"><Icon Name="plus" Size="16" /> 生成一组</button></div>
@if (loading) { <LoadingState Text="正在载入兑换码" /> } else if (error is not null) { <ErrorState Message="@error" OnRetry="LoadAsync" /> } else { <DxGrid Data="@rows" ShowFilterRow="true" ShowSearchPanel="true" PageSize="25"><Columns><DxGridDataColumn FieldName="Code" Caption="兑换码" /><DxGridDataColumn FieldName="Type" Caption="类型" /><DxGridDataColumn FieldName="Value" Caption="值" /><DxGridDataColumn FieldName="Status" Caption="状态" /><DxGridDataColumn FieldName="CreatedAt" Caption="创建时间" DisplayFormat="yyyy-MM-dd HH:mm" /><DxGridDataColumn Caption="操作" Width="120"><CellDisplayTemplate Context="context">@{var row=(RedeemRow)context.DataItem;}<button type="button" class="icon-button" title="作废" aria-label="作废" @onclick="() => ExpireAsync(row)"><Icon Name="ban" Size="16" /></button><button type="button" class="icon-button danger" title="删除" aria-label="删除" @onclick="() => DeleteAsync(row)"><Icon Name="trash" Size="16" /></button></CellDisplayTemplate></DxGridDataColumn></Columns></DxGrid> }
@code { private bool loading=true; private string? error; private List<RedeemRow> rows=[]; protected override Task OnInitializedAsync()=>LoadAsync(); private async Task LoadAsync(){loading=true;error=null;try{rows=(await Api.GetAdminRedeemCodesRawAsync()).Select((x,n)=>RedeemRow.From(x,n)).ToList();}catch(ApiException ex){error=ex.Message;}finally{loading=false;}} private async Task GenerateAsync(){try{await Api.GenerateRedeemCodesAsync(new{count=1,type="balance",value=1});Toasts.Success("已生成兑换码");await LoadAsync();}catch(ApiException ex){error=ex.Message;}} private async Task ExpireAsync(RedeemRow row){try{await Api.ExpireRedeemCodeAsync(row.Id);Toasts.Success("兑换码已作废");await LoadAsync();}catch(ApiException ex){error=ex.Message;}} private async Task DeleteAsync(RedeemRow row){try{await Api.DeleteRedeemCodeAsync(row.Id);Toasts.Success("兑换码已删除");await LoadAsync();}catch(ApiException ex){error=ex.Message;}} private sealed class RedeemRow{public string Id{get;set;}="";public string Code{get;set;}="-";public string Type{get;set;}="-";public string Value{get;set;}="-";public string Status{get;set;}="-";public DateTimeOffset? CreatedAt{get;set;}public static RedeemRow From(JsonElement x,int n)=>new(){Id=Get(x,"id",n.ToString()),Code=Get(x,"code"),Type=Get(x,"type"),Value=Get(x,"value"),Status=Get(x,"status"),CreatedAt=Date(x,"created_at")};}private static string Get(JsonElement x,string n,string f="-")=>x.ValueKind==JsonValueKind.Object&&x.TryGetProperty(n,out var p)?p.ToString():f;private static DateTimeOffset? Date(JsonElement x,string n){if(x.ValueKind!=JsonValueKind.Object||!x.TryGetProperty(n,out var p))return null;if(p.ValueKind==JsonValueKind.Number&&p.TryGetInt64(out var ms))return DateTimeOffset.FromUnixTimeMilliseconds(ms);return DateTimeOffset.TryParse(p.ToString(),out var d)?d:null;}}
