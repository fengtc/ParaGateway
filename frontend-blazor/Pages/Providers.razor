    </ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseBulkOpenAISettings">取消</button><button type="button" class="button primary" disabled="@bulkOpenAISaving" @onclick="SaveBulkOpenAISettingsAsync">@(bulkOpenAISaving ? "保存中…" : "应用设置")</button></Footer>
</AppModal>

<AppModal Open="deleteOpen" Title="删除账号" MaxWidth="520px" OnClose="CloseDelete">
    <ChildContent><p>确定要删除账号“<strong>@deletingAccount?.Name</strong>”吗？此操作无法撤销。</p></ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseDelete">取消</button><button type="button" class="button danger" disabled="@busy" @onclick="ConfirmDeleteAsync">删除</button></Footer>
</AppModal>

<AccountStatsModal Open="@statsOpen" Account="@statsAccount" OnClose="CloseStats" />

<AppModal Open="crsOpen" Title="从 CRS 同步账号" MaxWidth="720px" OnClose="CloseCrsSync">
    <ChildContent>
        <EditForm id="crs-sync-form" Model="crsForm" OnValidSubmit="PreviewCrsAsync" FormName="crs-sync-form"><DataAnnotationsValidator />
            <p class="muted-text">将 claude-relay-service（CRS）中的账号同步到当前系统；请求由 Go 后端发起。</p>
            <div class="inline-alert warning"><Icon Name="alert" Size="18" /><span>CRS 版本必须 ≥ v1.1.240。</span></div>
            <div class="form-grid"><div class="form-field full"><label for="crs-url">CRS 服务地址</label><InputText id="crs-url" @bind-Value="crsForm.BaseUrl" placeholder="http://127.0.0.1:3000" /><ValidationMessage For="() => crsForm.BaseUrl" /></div><div class="form-field"><label for="crs-user">用户名</label><InputText id="crs-user" @bind-Value="crsForm.Username" /><ValidationMessage For="() => crsForm.Username" /></div><div class="form-field"><label for="crs-password">密码</label><InputText id="crs-password" @bind-Value="crsForm.Password" type="password" autocomplete="new-password" /><ValidationMessage For="() => crsForm.Password" /></div><label class="toggle-row full"><InputCheckbox @bind-Value="crsForm.SyncProxies" /><span><strong>同时同步代理</strong><small>按 host、port 和账号匹配或自动创建。</small></span></label></div>
            @if (!string.IsNullOrWhiteSpace(crsResultJson)) { <pre class="json-preview compact-json">@crsResultJson</pre> }
        </EditForm>
    </ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseCrsSync">取消</button><button type="submit" form="crs-sync-form" class="button secondary" disabled="@crsBusy">@(crsBusy ? "预览中…" : "预览")</button><button type="button" class="button primary" disabled="@(crsBusy || !crsPreviewReady)" @onclick="SyncCrsAsync">开始同步</button></Footer>
</AppModal>

@code {
    private static readonly int[] AutoRefreshIntervals = [5, 10, 15, 30];
    private static readonly (string Key, string Label)[] ToggleableColumns =
    [
        ("id", "账号ID"), ("platform", "平台/类型"), ("endpoint", "API 地址"), ("auth", "认证"),
        ("capacity", "容量"), ("status", "状态"),
        ("schedulable", "调度"), ("today", "今日统计"), ("groups", "分组"), ("usage", "用量窗口"),
        ("proxy", "代理"), ("priority", "优先级"), ("score", "实时调度评分"), ("rate", "计费倍率"),
        ("upstream-rate", "上游声明倍率"), ("last", "最近使用"), ("created", "创建时间"),
        ("expires", "过期时间"), ("notes", "备注")
    ];
    private static readonly JsonSerializerOptions PrettyJson = new() { WriteIndented = true };
    private const string HiddenColumnsKey = "account-hidden-columns";
    private const string AutoRefreshKey = "account-auto-refresh";
    private const string SortKey = "account-table-sort";
    private const string PageSizeKey = "table-page-size";

    private List<AccountDto> accounts = [];
    private List<GroupDto> groups = [];
    private List<ProxyDto> proxies = [];
    private readonly HashSet<string> selectedIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> hiddenColumns = new(StringComparer.OrdinalIgnoreCase) { "today", "proxy", "notes", "priority", "score", "rate" };
    private readonly Dictionary<string, AccountTodayStatsDto> todayStats = new(StringComparer.Ordinal);
    private readonly Dictionary<string, AccountUsageInfoDto> usageByAccountId = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> usageErrors = new(StringComparer.Ordinal);
    private readonly HashSet<string> usageLoadingIds = new(StringComparer.Ordinal);
    private AccountInput form = new();
    private EditContext? editorContext;
    private CrsSyncInput crsForm = new();
    private CancellationTokenSource? searchCancellation;
    private readonly CancellationTokenSource disposeCancellation = new();
    private Task? autoRefreshTask;
    private string search = string.Empty, platformFilter = string.Empty, typeFilter = string.Empty, statusFilter = string.Empty, privacyFilter = string.Empty, groupFilter = string.Empty;
    private string sortBy = "name", sortOrder = "asc", formExpiryLocal = string.Empty;
    private string? editingId, rowMenuId, error, modalError, editorTestMessage, editorTestFingerprint, crsResultJson, bulkOpenAIError;
    private string copilotBillingValidationMessage = string.Empty;
    private FloatingMenuPosition? rowMenuPosition;
    private long? copilotBillingValidationProxyId;
    private AccountDto? deletingAccount, statsAccount;
    private int page = 1, pageSize = 20, total, totalPages = 1;
    private bool loading = true, todayStatsLoading, busy, saving, editorTesting, editorOpen, createOpen, deleteOpen, statsOpen, toolsMenuOpen, autoRefreshMenuOpen;
    private bool autoRefreshEnabled, selectingAll, exporting, includeProxiesOnExport, crsOpen, crsBusy, crsPreviewReady;
    private bool bulkOpenAISettingsOpen, bulkOpenAISaving, applyOpenAILongContext, openAILongContextEnabled;
    private bool editingIsCopilot, copilotBillingValidating, copilotBillingValidationOk;
    private bool applyOpenAICapabilities, openAIChatCapability = true, openAIEmbeddingsCapability = true, applyOpenAIResponsesMode;
    private string openAIResponsesMode = "auto";
    private int autoRefreshIntervalSeconds = 30, autoRefreshCountdown = 30;

    private int StartRow => total == 0 ? 0 : ((page - 1) * pageSize) + 1;
    private int EndRow => Math.Min(total, page * pageSize);
    private bool AllCurrentPageSelected => accounts.Count > 0 && accounts.All(x => selectedIds.Contains(x.Id));
    private bool CanBulkRefresh => selectedIds.Count > 0 && selectedIds.All(id => accounts.FirstOrDefault(row => row.Id == id) is { } row && CanRefreshToken(row));
    private bool CanBulkOpenAISettings => selectedIds.Count > 0 && selectedIds.All(id => accounts.FirstOrDefault(row => row.Id == id) is { Platform: "openai" });
    private int VisibleColumnCount => 3 + ToggleableColumns.Count(x => IsColumnVisible(x.Key));
    private bool CanTestEditor => editingId is not null || form.Type == "apikey";
    private string EditorTestLabel => form.Type == "apikey" && (editingId is null || !string.IsNullOrWhiteSpace(form.ApiKey)) ? "读取平台模型" : "测试已保存连接";
    private string CopilotBillingPatCreationUrl
    {
        get
        {
            const string baseUrl = "https://github.com/settings/personal-access-tokens/new";
            var query = $"name={Uri.EscapeDataString("paragateway Billing")}"
                + $"&description={Uri.EscapeDataString("Read GitHub AI Credits usage")}"
                + "&expires_in=90&plan=read";
            var username = form.BillingUsername.Trim();
            if (username.Length > 0) query += $"&target_name={Uri.EscapeDataString(username)}";
            return $"{baseUrl}?{query}";
        }
    }
    private IEnumerable<GroupDto> AvailableEditorGroups
    {
        get
        {
            var mixedScheduling = IsEditorMixedSchedulingEnabled();
            return groups.Where(group => AccountGroupSelectionPolicy.IsSelectable(group, form.Platform, mixedScheduling));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var groupsTask = Api.GetGroupsAsync();
            var proxiesTask = Api.GetProxiesAsync();
            await Task.WhenAll(groupsTask, proxiesTask);
            groups = await groupsTask;
            proxies = await proxiesTask;
        }
        catch (ApiException)
        {
            groups = [];
            proxies = [];
        }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadPreferencesAsync();
        await LoadAsync(true);
        autoRefreshTask = AutoRefreshLoopAsync(disposeCancellation.Token);
        await InvokeAsync(StateHasChanged);
    }

    private AccountListQuery CurrentQuery(int? targetPage = null, int? targetPageSize = null) => new()
    {
        Page = targetPage ?? page, PageSize = targetPageSize ?? pageSize, Search = search, Platform = platformFilter,
        Type = typeFilter, Status = statusFilter, PrivacyMode = privacyFilter, Group = groupFilter,
        SortBy = sortBy, SortOrder = sortOrder, IncludeSchedulerScore = IsColumnVisible("score")
    };

    private async Task LoadAsync(bool silent = false)
    {
        if (busy && silent) return;
        if (!silent) loading = true;
        error = null;
        try
        {
            var result = await Api.GetAccountsPageAsync(CurrentQuery());
            accounts = result.Items; total = result.Total; totalPages = Math.Max(1, result.TotalPages); page = Math.Min(Math.Max(1, result.Page), totalPages);
            await Task.WhenAll(LoadTodayStatsAsync(), LoadUsageAsync());
        }
        catch (ApiException ex) { if (!silent) error = ex.Message; }
        finally { loading = false; autoRefreshCountdown = autoRefreshIntervalSeconds; }
    }

    private async Task LoadTodayStatsAsync()
    {
        todayStats.Clear();
        if ((!IsColumnVisible("today") && !IsColumnVisible("usage")) || accounts.Count == 0)
        {
            todayStatsLoading = false;
            return;
        }
        todayStatsLoading = true;
        try
        {
            var response = await Api.GetAccountTodayStatsBatchAsync(accounts.Select(x => x.Id));
            foreach (var pair in response.Stats) todayStats[pair.Key] = pair.Value;
        }
        catch (ApiException) { }
        finally { todayStatsLoading = false; }
    }

    private async Task LoadUsageAsync()
    {
        usageByAccountId.Clear();
        usageErrors.Clear();
        usageLoadingIds.Clear();
        if (!IsColumnVisible("usage") || accounts.Count == 0) return;

        var supportedIds = accounts.Where(SupportsUsageWindows).Select(account => account.Id).ToArray();
        if (supportedIds.Length == 0) return;
        foreach (var id in supportedIds) usageLoadingIds.Add(id);
        try
        {
            var response = await Api.GetAccountUsageBatchAsync(supportedIds);
            foreach (var pair in response.Usage) usageByAccountId[pair.Key] = pair.Value;
            foreach (var pair in response.Errors) usageErrors[pair.Key] = pair.Value;
        }
        catch (ApiException ex)
        {
            foreach (var id in supportedIds) usageErrors[id] = ex.Message;
        }
        finally
        {
            usageLoadingIds.Clear();
        }
    }

    private void HandleUsageChanged(string accountId, AccountUsageInfoDto usage)
    {
        usageByAccountId[accountId] = usage;
        usageErrors.Remove(accountId);
    }

    private static bool SupportsUsageWindows(AccountDto account) => account.Platform switch
    {
        "anthropic" => account.Type is "oauth" or "setup-token",
        "openai" => account.Type == "oauth" && !IsCopilot(account),
        "gemini" => true,
        "antigravity" or "grok" => account.Type == "oauth",
        _ => false
    };

