    private void OpenBulkOpenAISettings()
    {
        if (!CanBulkOpenAISettings) return;
        bulkOpenAIError = null;
        applyOpenAILongContext = false;
        openAILongContextEnabled = false;
        applyOpenAICapabilities = false;
        openAIChatCapability = true;
        openAIEmbeddingsCapability = true;
        applyOpenAIResponsesMode = false;
        openAIResponsesMode = "auto";
        bulkOpenAISettingsOpen = true;
    }

    private void CloseBulkOpenAISettings()
    {
        if (bulkOpenAISaving) return;
        bulkOpenAISettingsOpen = false;
        bulkOpenAIError = null;
    }

    private async Task SaveBulkOpenAISettingsAsync()
    {
        bulkOpenAIError = null;
        if (!applyOpenAILongContext && !applyOpenAICapabilities && !applyOpenAIResponsesMode)
        {
            bulkOpenAIError = "请至少选择一项需要修改的设置。";
            return;
        }
        if (applyOpenAICapabilities && !openAIChatCapability && !openAIEmbeddingsCapability)
        {
            bulkOpenAIError = "端点能力至少保留一项。";
            return;
        }

        var credentials = new Dictionary<string, object?>();
        var extra = new Dictionary<string, object?>();
        if (applyOpenAILongContext) extra["openai_long_context_billing_enabled"] = openAILongContextEnabled;
        if (applyOpenAICapabilities)
        {
            var capabilities = new List<string>();
            if (openAIChatCapability) capabilities.Add("chat_completions");
            if (openAIEmbeddingsCapability) capabilities.Add("embeddings");
            credentials["openai_capabilities"] = capabilities.Count == 2 ? null : capabilities;
            if (!openAIChatCapability) extra["openai_responses_mode"] = null;
        }
        if (applyOpenAIResponsesMode)
            extra["openai_responses_mode"] = openAIResponsesMode == "auto" ? null : openAIResponsesMode;

        var updates = new Dictionary<string, object?>();
        if (credentials.Count > 0) updates["credentials"] = credentials;
        if (extra.Count > 0) updates["extra"] = extra;

        bulkOpenAISaving = true;
        try
        {
            var result = await Api.BulkUpdateAccountsAsync(selectedIds, updates);
            var inherited = result.LongContextInheritedCount > 0
                ? $"；{result.LongContextInheritedCount} 个影子账号继承母账号设置"
                : string.Empty;
            Toasts.Success($"OpenAI 设置已更新：成功 {result.SuccessCount}，失败 {result.FailedCount}{inherited}");
            bulkOpenAISettingsOpen = false;
            await LoadAsync(true);
        }
        catch (ApiException ex) { bulkOpenAIError = ex.Message; }
        finally { bulkOpenAISaving = false; }
    }

    private async Task ExportAccountsAsync()
    {
        toolsMenuOpen = false; if (!await JS.InvokeAsync<bool>("confirm", "导出数据包含账号与代理敏感信息，请确认在安全环境中保存。")) return; exporting = true;
        try
        {
            await RunSensitiveAsync(async () =>
            {
                var data = await Api.GetAccountsDataAsync(selectedIds.Count == 0 ? null : selectedIds, includeProxiesOnExport, CurrentQuery());
                var json = JsonSerializer.Serialize(data, PrettyJson);
                await JS.InvokeVoidAsync("paraGateway.downloadBytes", Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json)), "application/json", $"paragateway-accounts-{DateTime.Now:yyyyMMdd-HHmmss}.json");

                Toasts.Success("数据导出成功");
            });
        }
        finally { exporting = false; }
    }
    private async Task ImportAccountsAsync(InputFileChangeEventArgs e)
    {
        toolsMenuOpen = false;
        try { await using var stream = e.File.OpenReadStream(5 * 1024 * 1024); using var document = await JsonDocument.ParseAsync(stream); await Api.ImportAccountsDataAsync(document.RootElement.Clone()); Toasts.Success("数据导入完成"); await LoadAsync(); }
        catch (Exception ex) when (ex is ApiException or JsonException or IOException) { error = ex.Message; }
    }
    private async Task RunSensitiveAsync(Func<Task> action)
    {
        try { await action(); }
        catch (ApiException ex) when (string.Equals(ex.Code, "STEP_UP_REQUIRED", StringComparison.OrdinalIgnoreCase))
        {
            var code = await JS.InvokeAsync<string?>("prompt", "请输入管理员 TOTP 验证码以继续敏感操作"); if (string.IsNullOrWhiteSpace(code)) return;
            try { await Api.VerifyTotpStepUpAsync(code); await action(); } catch (ApiException retry) { error = retry.Message; }
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    private void OpenCrsSync() { toolsMenuOpen = false; crsForm = new CrsSyncInput(); crsResultJson = null; crsPreviewReady = false; crsOpen = true; }
    private void CloseCrsSync() { crsOpen = false; crsResultJson = null; }
    private async Task PreviewCrsAsync() { crsBusy = true; try { var result = await Api.PreviewAccountsFromCrsAsync(crsForm); crsResultJson = JsonSerializer.Serialize(result, PrettyJson); crsPreviewReady = true; } catch (ApiException ex) { crsResultJson = JsonSerializer.Serialize(new { error = ex.Message }, PrettyJson); crsPreviewReady = false; } finally { crsBusy = false; } }
    private async Task SyncCrsAsync() { crsBusy = true; try { var result = await Api.SyncAccountsFromCrsAsync(crsForm); crsResultJson = JsonSerializer.Serialize(result, PrettyJson); Toasts.Success("CRS 同步完成"); await LoadAsync(); } catch (ApiException ex) { crsResultJson = JsonSerializer.Serialize(new { error = ex.Message }, PrettyJson); } finally { crsBusy = false; } }

    private static readonly HashSet<string> AllowedSortKeys = new(StringComparer.OrdinalIgnoreCase) { "id", "name", "status", "schedulable", "priority", "rate_multiplier", "upstream_billing_rate", "last_used_at", "created_at", "expires_at" };
    private static string PlatformLabel(string value) => value.ToLowerInvariant() switch { "anthropic" => "Anthropic", "openai" => "OpenAI", "gemini" => "Gemini", "antigravity" => "Antigravity", "grok" => "Grok", "kimi" => "Kimi", "zhipu" => "智谱 GLM", "deepseek" => "DeepSeek", _ => value };
    private static string AccountPlatformLabel(AccountDto row) => IsCopilot(row) ? "GitHub Copilot" : PlatformLabel(row.Platform);
    private static string OAuthProfile(AccountDto row) => ReadJsonString(row.Credentials, "oauth_profile") ?? ReadJsonString(row.Extra, "oauth_profile") ?? string.Empty;
    private static bool IsCopilot(AccountDto row) =>
        string.Equals(row.Platform, "copilot", StringComparison.OrdinalIgnoreCase)
        || string.Equals(OAuthProfile(row), "github_copilot", StringComparison.OrdinalIgnoreCase);
    private static string AccountTypeLabel(AccountDto row) => TypeLabel(row.Type);
    private static bool CanRefreshToken(AccountDto row) => row.ParentAccountId is null && row.Type is "oauth" or "setup-token";
    private static string DefaultApiBaseUrl(AccountInput input) => IsCNPlatform(input.Platform)
        ? DefaultCNBaseUrl(input.Platform, input.AccountMode, input.ApiProtocol)
        : input.Platform.ToLowerInvariant() switch
        {
            "anthropic" => "https://api.anthropic.com",
            "gemini" => "https://generativelanguage.googleapis.com",
            "antigravity" => "https://cloudcode-pa.googleapis.com",
            "grok" => "https://api.x.ai/v1",
            _ => "https://api.openai.com"
        };
    private static string ApiKeyPlaceholder(string platform) => platform.ToLowerInvariant() switch
    {
        "anthropic" => "sk-ant-...",
        "gemini" => "AIza...",
        "antigravity" => "sk-...",
        "grok" => "xai-...",
        "kimi" or "zhipu" or "deepseek" => "sk-...",
        _ => "sk-proj-..."
    };
    private static string AccountBaseUrl(AccountDto row)
    {
        var configured = ReadCredential(row, "base_url");
        if (!string.IsNullOrWhiteSpace(configured)) return configured;
        if (IsCopilot(row)) return "https://api.githubcopilot.com";
        return row.Platform.ToLowerInvariant() switch
        {
            "openai" when string.Equals(OAuthProfile(row), "codex_cli", StringComparison.OrdinalIgnoreCase) => "https://chatgpt.com",
            "openai" => "https://api.openai.com",
            "anthropic" => "https://api.anthropic.com",
            "gemini" => "https://generativelanguage.googleapis.com",
            "grok" => "https://api.x.ai",
            "kimi" => "https://api.moonshot.cn/v1",
            "zhipu" => "https://open.bigmodel.cn/api/paas/v4",
            "deepseek" => "https://api.deepseek.com",
            _ => "官方端点"
        };
    }
    private static string AuthenticationLabel(AccountDto row)
    {
        if (IsCopilot(row)) return "GitHub Copilot 凭据";
        var profile = OAuthProfile(row).ToLowerInvariant();
        if (profile == "codex_cli") return "Codex CLI OAuth";
        if (profile.Contains("claude", StringComparison.Ordinal)) return "Claude Code OAuth";
        return row.Type.ToLowerInvariant() switch
        {
            "oauth" => "官方 OAuth",
            "setup-token" => "Setup Token",
            "apikey" => "API Key",
            "upstream" => "旧版 Upstream",
            "bedrock" => "AWS 凭据",
            "service_account" => "Service Account",
            _ => TypeLabel(row.Type)
        };
    }
    private static bool CredentialConfigured(AccountDto row) => row.HasApiKey || row.CredentialsStatus?.Values.Any(value => value) == true;
    private static string TypeLabel(string value) => value.ToLowerInvariant() switch { "oauth" => "OAuth", "setup-token" => "Setup Token", "apikey" => "API Key", "upstream" => "旧版 Upstream", "bedrock" => "AWS Bedrock", "service_account" => "Service Account", _ => value };
    private static string StatusLabel(AccountDto row) => row.TempUnschedulableUntil > DateTimeOffset.UtcNow ? "临时不可调度" : row.Status.ToLowerInvariant() switch { "active" => "正常", "inactive" => "未启用", "error" => "错误", "rate_limited" => "速率限制", "temp_unschedulable" => "临时不可调度", "unschedulable" => "不可调度", _ => row.Status };
    private static string StatusClass(AccountDto row) => row.TempUnschedulableUntil > DateTimeOffset.UtcNow ? "warning" : row.Status.ToLowerInvariant() switch { "active" => "success", "error" => "danger", "rate_limited" or "temp_unschedulable" => "warning", _ => "neutral" };
    private static string StatusTitle(AccountDto row) => string.IsNullOrWhiteSpace(row.ErrorMessage) ? (string.IsNullOrWhiteSpace(row.TempUnschedulableReason) ? StatusLabel(row) : row.TempUnschedulableReason) : row.ErrorMessage;
    private static string AccountEmail(AccountDto row) { if (!string.IsNullOrWhiteSpace(row.ParentEmail)) return row.ParentEmail; return ReadJsonString(row.Credentials, "email") ?? ReadJsonString(row.Credentials, "user_email") ?? string.Empty; }
    private static string ReadCredential(AccountDto row, string key) => ReadJsonString(row.Credentials, key) ?? string.Empty;
    private static string ReadCopilotBillingUsername(AccountDto row)
    {
        var username = ReadCredential(row, "billing_username");
        return string.IsNullOrWhiteSpace(username) ? ReadCredential(row, "github_login") : username;
    }
    private static string ReadCredentialObjectString(AccountDto row, string objectKey, string key) =>
        row.Credentials is not null && row.Credentials.TryGetValue(objectKey, out var value)
        && value.ValueKind == JsonValueKind.Object && value.TryGetProperty(key, out var nested)
        && nested.ValueKind == JsonValueKind.String ? nested.GetString() ?? string.Empty : string.Empty;
    private static bool ReadExtraBool(AccountDto row, string key) => row.Extra is not null && row.Extra.TryGetValue(key, out var value) && value.ValueKind is JsonValueKind.True;
    private static double? ReadExtraNumber(AccountDto row, string key) =>
        row.Extra is not null && row.Extra.TryGetValue(key, out var value)
        && value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out var number) ? number : null;
    private const double DefaultCopilotBillingCreditLimit = 20_000;
    private static double CopilotBillingUsed(AccountDto row) => row.CopilotBillingUsage?.GrossQuantity ?? 0;
    private static double CopilotBillingLimit(AccountDto row)
    {
        var configured = ReadExtraNumber(row, "billing_credit_limit");
        return configured is > 0 ? configured.Value : DefaultCopilotBillingCreditLimit;
    }
    private static string FormatCopilotCredits(double value) =>
        value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    private static bool HasCredentialStatus(AccountDto row, params string[] keys) =>
        row.CredentialsStatus is not null
        && keys.Any(key => row.CredentialsStatus.TryGetValue(key, out var configured) && configured);
    private static string ReadExtraString(AccountDto row, string key) => ReadJsonString(row.Extra, key) ?? string.Empty;
    private static string? ReadJsonString(Dictionary<string, JsonElement>? source, string key) => source is not null && source.TryGetValue(key, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;
    private static bool IsCNPlatform(string value) => value is "kimi" or "zhipu" or "deepseek";
    private static string DefaultCNBaseUrl(string provider, string mode, string protocol)
    {
        if (protocol == "anthropic") return provider switch
        {
            "kimi" => mode == "coding" ? "https://api.kimi.com/coding" : "https://api.moonshot.cn/anthropic",
            "zhipu" => "https://open.bigmodel.cn/api/anthropic",
            "deepseek" => "https://api.deepseek.com/anthropic",
            _ => string.Empty
        };
        return provider switch
        {
            "kimi" => mode == "coding" ? "https://api.kimi.com/coding/v1" : "https://api.moonshot.cn/v1",
            "zhipu" => mode == "coding" ? "https://open.bigmodel.cn/api/coding/paas/v4" : "https://open.bigmodel.cn/api/paas/v4",
            "deepseek" => "https://api.deepseek.com",
            _ => string.Empty
        };
    }
    private static void EnsureAdaptiveBaseUrls(AccountInput input, string? previousMode = null, bool force = false)
    {
        var previousChat = previousMode is null ? string.Empty : DefaultCNBaseUrl(input.Platform, previousMode, "chat_completions");
        var previousAnthropic = previousMode is null ? string.Empty : DefaultCNBaseUrl(input.Platform, previousMode, "anthropic");
        var previousResponses = previousMode is null ? string.Empty : DefaultCNBaseUrl(input.Platform, previousMode, "responses");
        input.AdaptiveChatCompletionsBaseUrl = RebaseAdaptiveUrl(
            input.AdaptiveChatCompletionsBaseUrl, previousChat,
            DefaultCNBaseUrl(input.Platform, input.AccountMode, "chat_completions"), force);
        input.AdaptiveAnthropicBaseUrl = RebaseAdaptiveUrl(
            input.AdaptiveAnthropicBaseUrl, previousAnthropic,
            DefaultCNBaseUrl(input.Platform, input.AccountMode, "anthropic"), force);
        input.AdaptiveResponsesBaseUrl = input.Platform == "deepseek"
            ? RebaseAdaptiveUrl(input.AdaptiveResponsesBaseUrl, previousResponses,
                DefaultCNBaseUrl(input.Platform, input.AccountMode, "responses"), force)
            : string.Empty;
        input.BaseUrl = input.AdaptiveChatCompletionsBaseUrl;
    }

    private static string RebaseAdaptiveUrl(string current, string previousDefault, string nextDefault, bool force)
    {
        if (force || string.IsNullOrWhiteSpace(current)
            || (!string.IsNullOrWhiteSpace(previousDefault)
                && string.Equals(current.Trim(), previousDefault, StringComparison.OrdinalIgnoreCase)))
        {
            return nextDefault;
        }
        return current.Trim();
    }
    private static bool HasQuota(AccountDto row) => row.QuotaLimit is > 0 || row.QuotaDailyLimit is > 0 || row.QuotaWeeklyLimit is > 0;
    private static MarkupString UsageWindow(string label, double? used, double? limit) { if (limit is not > 0) return new MarkupString(string.Empty); var percent = Math.Clamp((used ?? 0) / limit.Value * 100, 0, 100); return new MarkupString($"<span><small>{label}</small><b>{used.GetValueOrDefault():0.##}/{limit.Value:0.##}</b><i><em style='width:{percent:0.#}%'></em></i></span>"); }
    private static string SchedulerScore(AccountDto row) { var score = row.SchedulerScores.FirstOrDefault() ?? row.SchedulerScore; if (score is null) return "-"; return score.StickyScoreInfinity ? $"{score.BaseScore:0.######} / +∞" : $"{score.BaseScore:0.######} / {score.StickyScore:0.######}"; }
    private static string UpstreamRate(AccountDto row) { if (row.Extra is null || !row.Extra.TryGetValue("upstream_billing_rate", out var value) || value.ValueKind != JsonValueKind.Number || !value.TryGetDouble(out var number)) return "-"; return $"{number:0.###}x"; }
    private static string RelativeTime(DateTimeOffset? value) { if (!value.HasValue) return "-"; var span = DateTimeOffset.UtcNow - value.Value; if (span.TotalMinutes < 1) return "刚刚"; if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} 分钟前"; if (span.TotalDays < 1) return $"{(int)span.TotalHours} 小时前"; return span.TotalDays < 30 ? $"{(int)span.TotalDays} 天前" : value.Value.ToLocalTime().ToString("yyyy-MM-dd"); }
    private static string FormatDate(DateTimeOffset value) => value == default ? "-" : value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    private static DateTimeOffset FromUnix(long value) => value > 10_000_000_000 ? DateTimeOffset.FromUnixTimeMilliseconds(value) : DateTimeOffset.FromUnixTimeSeconds(value);
    private static string FormatExpiry(long? value) => value.HasValue ? FromUnix(value.Value).ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "永不过期";
    private static bool IsExpired(long? value) => value.HasValue && FromUnix(value.Value) <= DateTimeOffset.UtcNow;

    public async ValueTask DisposeAsync()
    {
        searchCancellation?.Cancel(); searchCancellation?.Dispose(); disposeCancellation.Cancel();
        if (autoRefreshTask is not null) { try { await autoRefreshTask; } catch (OperationCanceledException) { } }
        disposeCancellation.Dispose();
    }

