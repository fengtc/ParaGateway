    private static bool IsAuthenticationTypeSupported(string platform, string type) => type switch
    {
        "apikey" or "oauth" => true,
        "setup-token" or "bedrock" => platform == "anthropic",
        "service_account" => platform is "anthropic" or "gemini",
        "upstream" => true,
        _ => false
    };
