    private async Task ValidateEditorCopilotBillingPatAsync()
    {
        if (string.IsNullOrWhiteSpace(form.BillingUsername) || string.IsNullOrWhiteSpace(form.BillingPat)) return;
        copilotBillingValidating = true;
        ResetEditorCopilotBillingValidation();
        copilotBillingValidationProxyId = form.ProxyId;
        try
        {
            var result = await Api.ValidateCopilotBillingPatAsync(new CopilotBillingPatValidationRequest
            {
                Username = form.BillingUsername.Trim(),
                BillingPat = form.BillingPat.Trim(),
                ProxyId = form.ProxyId
            });
            copilotBillingValidationOk = result.Valid;
            copilotBillingValidationMessage = result.Valid
                ? $"验证通过：本月 {result.GrossQuantity:0.##} AI Credits，标准金额 $" + result.GrossAmount.ToString("0.##")
                : "验证失败，PAT 无法读取账单或已过期。";
        }
        catch (ApiException ex)
        {
            copilotBillingValidationOk = false;
            copilotBillingValidationMessage = ex.Message;
        }
        finally { copilotBillingValidating = false; }
    }

