                    <div class="form-field full"><label for="account-credentials-json">Vertex Service Account JSON</label><InputTextArea id="account-credentials-json" @bind-Value="form.CredentialsJson" rows="7" /><ValidationMessage For="() => form.CredentialsJson" /></div>
                }
                else
                {
                    <div class="form-field full"><label for="account-credentials-json">凭据 JSON</label><InputTextArea id="account-credentials-json" @bind-Value="form.CredentialsJson" rows="7" /><ValidationMessage For="() => form.CredentialsJson" /></div>
                }
                @if (AccountModelRestrictions.ShouldShow(form.Platform, form.Type))
                {
                    <div class="form-field full model-restriction-field">
