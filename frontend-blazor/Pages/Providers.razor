                            <input id="account-copilot-billing-pat" type="password" value="@form.BillingPat" @oninput="SetEditorCopilotBillingPat" autocomplete="new-password" placeholder="github_pat_..." data-1p-ignore data-lpignore="true" data-bwignore="true" />
                            <button type="button" class="button secondary" disabled="@(copilotBillingValidating || string.IsNullOrWhiteSpace(form.BillingUsername) || string.IsNullOrWhiteSpace(form.BillingPat))" @onclick="ValidateEditorCopilotBillingPatAsync">@(copilotBillingValidating ? "验证中…" : "验证")</button>
