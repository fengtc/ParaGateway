    private async Task SetAutoRefreshIntervalAsync(int seconds) { autoRefreshIntervalSeconds = seconds; autoRefreshCountdown = seconds; await SaveAutoRefreshAsync(); }
    private async Task AutoRefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                if (!autoRefreshEnabled) continue;
                autoRefreshCountdown--;
                if (autoRefreshCountdown <= 0) await InvokeAsync(() => LoadAsync(true)); else await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadPreferencesAsync()
    {
        try
        {
            var savedColumns = await JS.InvokeAsync<string?>("localStorage.getItem", HiddenColumnsKey);
            if (!string.IsNullOrWhiteSpace(savedColumns)) { hiddenColumns.Clear(); foreach (var key in JsonSerializer.Deserialize<List<string>>(savedColumns) ?? []) hiddenColumns.Add(key); }
            var savedRefresh = await JS.InvokeAsync<string?>("localStorage.getItem", AutoRefreshKey);
            if (!string.IsNullOrWhiteSpace(savedRefresh)) { var state = JsonSerializer.Deserialize<AutoRefreshPreference>(savedRefresh); if (state is not null) { autoRefreshEnabled = state.Enabled; if (AutoRefreshIntervals.Contains(state.IntervalSeconds)) autoRefreshIntervalSeconds = state.IntervalSeconds; autoRefreshCountdown = autoRefreshIntervalSeconds; } }
            var savedSort = await JS.InvokeAsync<string?>("localStorage.getItem", SortKey);
            if (!string.IsNullOrWhiteSpace(savedSort)) { var state = JsonSerializer.Deserialize<AccountSortPreference>(savedSort); if (state is not null && AllowedSortKeys.Contains(state.Key)) { sortBy = state.Key; sortOrder = state.Order == "desc" ? "desc" : "asc"; } }
            var savedPageSize = await JS.InvokeAsync<string?>("localStorage.getItem", PageSizeKey); if (int.TryParse(savedPageSize, out var size) && size is 10 or 20 or 50 or 100) pageSize = size;
        }
        catch (Exception ex) when (ex is JSException or JsonException) { }
    }
    private async Task SaveAutoRefreshAsync() { try { await JS.InvokeVoidAsync("localStorage.setItem", AutoRefreshKey, JsonSerializer.Serialize(new AutoRefreshPreference { Enabled = autoRefreshEnabled, IntervalSeconds = autoRefreshIntervalSeconds })); } catch (JSException) { } }
    private async Task SaveSortAsync() { try { await JS.InvokeVoidAsync("localStorage.setItem", SortKey, JsonSerializer.Serialize(new AccountSortPreference { Key = sortBy, Order = sortOrder })); } catch (JSException) { } }
    private async Task ToggleColumnAsync(string key) { if (!hiddenColumns.Add(key)) hiddenColumns.Remove(key); try { await JS.InvokeVoidAsync("localStorage.setItem", HiddenColumnsKey, JsonSerializer.Serialize(hiddenColumns)); } catch (JSException) { } if (key is "today" or "score" or "usage") await LoadAsync(); }
    private bool IsColumnVisible(string key) => !hiddenColumns.Contains(key);

