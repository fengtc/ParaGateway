    private async Task ToggleSchedulingAsync(AccountDto row)
    {
        if (busy) return;

        var previous = row.Schedulable;
        var requested = !previous;
        row.Schedulable = requested;
        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            var saved = await Api.SetAccountSchedulableAsync(row.Id, requested);
            row.Schedulable = saved.Schedulable;
            Toasts.Success(saved.Schedulable ? "调度已开启" : "调度已关闭");
        }
        catch (ApiException ex)
        {
            row.Schedulable = previous;
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
