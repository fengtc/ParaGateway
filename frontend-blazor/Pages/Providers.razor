        }

        toolsMenuOpen = false;
        autoRefreshMenuOpen = false;
        var itemCount = CanRefreshToken(row) ? 7 : 6;
        var menuHeight = (itemCount * 32) + 12;

        try
        {
            rowMenuPosition = await JS.InvokeAsync<FloatingMenuPosition>(
                "paraGateway.positionFloatingMenu", e.ClientX, e.ClientY, 190, menuHeight, 8);
        }
        catch (JSException)
        {
            rowMenuPosition = new(
                Math.Max(8, (int)Math.Round(e.ClientY) - menuHeight - 6),
                Math.Max(8, (int)Math.Round(e.ClientX) - 190));
        }

        rowMenuId = row.Id;
    }

