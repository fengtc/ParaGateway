                    {
                        <div class="form-field"><label for="account-cn-mode">账号模式</label><select id="account-cn-mode" value="@form.AccountMode" @onchange="CNAccountModeEditorChanged"><option value="payg">按量付费（PAYG）</option>@if (form.Platform != "deepseek") { <option value="coding">Coding Plan</option> }</select></div>
                        <div class="form-field"><label for="account-cn-protocol">API 协议</label><select id="account-cn-protocol" value="@form.ApiProtocol" @onchange="CNApiProtocolEditorChanged"><option value="adaptive">自适应（按入站协议）</option><option value="chat_completions">Chat Completions</option><option value="anthropic">Anthropic Messages</option>@if (form.Platform == "deepseek") { <option value="responses">Responses</option> }</select></div>
                        @if (form.ApiProtocol == "adaptive")
                        {
                            <div class="form-field"><label for="account-cn-chat-base-url">Chat Completions Base URL</label><InputText id="account-cn-chat-base-url" @bind-Value="form.AdaptiveChatCompletionsBaseUrl" type="url" /><ValidationMessage For="() => form.AdaptiveChatCompletionsBaseUrl" /></div>
                            <div class="form-field"><label for="account-cn-anthropic-base-url">Anthropic Base URL</label><InputText id="account-cn-anthropic-base-url" @bind-Value="form.AdaptiveAnthropicBaseUrl" type="url" /><ValidationMessage For="() => form.AdaptiveAnthropicBaseUrl" /></div>
                            @if (form.Platform == "deepseek")
                            {
                                <div class="form-field full"><label for="account-cn-responses-base-url">Responses Base URL</label><InputText id="account-cn-responses-base-url" @bind-Value="form.AdaptiveResponsesBaseUrl" type="url" /><ValidationMessage For="() => form.AdaptiveResponsesBaseUrl" /></div>
                            }
                        }
                    }
                }
                else if (form.Type == "bedrock")
                {
                    <div class="form-field full"><label for="account-credentials-json">AWS Bedrock 凭据 JSON</label><InputTextArea id="account-credentials-json" @bind-Value="form.CredentialsJson" rows="7" /><ValidationMessage For="() => form.CredentialsJson" /></div>
                }
                else if (form.Type == "service_account")
