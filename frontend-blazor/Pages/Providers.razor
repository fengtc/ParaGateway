@page "/providers"
@page "/admin/accounts"
@implements IAsyncDisposable
@inject ApiClient Api
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>账号管理 · ParaGateway</PageTitle>

<div class="accounts-page">
    <section class="accounts-toolbar" aria-label="账号筛选与操作">
        <div class="account-filter-row">
            <div class="search-box account-search">
                <Icon Name="search" Size="17" />
                <input value="@search" @oninput="SearchChanged" placeholder="搜索账号名称..." aria-label="搜索账号" />
            </div>
            <select value="@platformFilter" @onchange="PlatformChangedAsync" aria-label="平台筛选">
                <option value="">全部平台</option>
                <option value="anthropic">Anthropic</option>
                <option value="openai">OpenAI</option>
                <option value="gemini">Gemini</option>
                <option value="antigravity">Antigravity</option>
                <option value="grok">Grok</option>
                <option value="kimi">Kimi</option>
                <option value="zhipu">智谱 GLM</option>
                <option value="deepseek">DeepSeek</option>
            </select>
            <select value="@typeFilter" @onchange="TypeChangedAsync" aria-label="认证类型筛选">
                <option value="">全部类型</option>
                <option value="oauth">OAuth</option>
                <option value="setup-token">Setup Token</option>
                <option value="apikey">API Key / 自定义上游</option>
                <option value="upstream">旧版 Upstream（兼容）</option>
                <option value="bedrock">AWS Bedrock</option>
                <option value="service_account">Service Account</option>
            </select>
            <select value="@statusFilter" @onchange="StatusChangedAsync" aria-label="账号状态筛选">
                <option value="">全部状态</option>
                <option value="active">正常</option>
                <option value="inactive">未启用</option>
                <option value="error">错误</option>
                <option value="rate_limited">速率限制</option>
                <option value="temp_unschedulable">临时不可调度</option>
                <option value="unschedulable">不可调度</option>
            </select>
            <select value="@privacyFilter" @onchange="PrivacyChangedAsync" aria-label="Privacy 状态筛选">
                <option value="">全部Privacy状态</option>
                <option value="__unset__">未设置</option>
                <option value="training_off">Privacy</option>
                <option value="training_set_cf_blocked">CF</option>
                <option value="training_set_failed">Fail</option>
            </select>
            <select value="@groupFilter" @onchange="GroupChangedAsync" aria-label="账号分组筛选">
                <option value="">全部分组</option>
                <option value="ungrouped">未分配分组</option>
                @foreach (var group in groups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
            <span class="account-result-count">@(loading ? "正在加载…" : $"{total} 个账号")</span>
        </div>
        <div class="account-toolbar-actions">
            <button type="button" class="icon-button" title="刷新" aria-label="刷新" disabled="@loading" @onclick="ManualRefreshAsync"><Icon Name="refresh" Size="17" /></button>
            <div class="toolbar-popover-wrap">
                <button type="button" class="button secondary compact" aria-expanded="@autoRefreshMenuOpen" @onclick="ToggleAutoRefreshMenu">
                    <Icon Name="refresh" Size="16" /> @(autoRefreshEnabled ? $"自动刷新：{autoRefreshCountdown}s" : "自动刷新")
                </button>
                @if (autoRefreshMenuOpen)
                {
                    <div class="toolbar-popover auto-refresh-menu">
                        <button type="button" class="menu-check-row" @onclick="ToggleAutoRefreshAsync"><span>启用自动刷新</span>@if (autoRefreshEnabled) { <Icon Name="check" Size="15" /> }</button>
                        <div class="menu-divider"></div>
                        @foreach (var seconds in AutoRefreshIntervals)
                        {
                            <button type="button" class="menu-check-row" @onclick="() => SetAutoRefreshIntervalAsync(seconds)"><span>@seconds 秒</span>@if (autoRefreshIntervalSeconds == seconds) { <Icon Name="check" Size="15" /> }</button>
                        }
                    </div>
                }
            </div>
            <div class="toolbar-popover-wrap">
                <button type="button" class="button secondary compact" aria-expanded="@toolsMenuOpen" @onclick="ToggleToolsMenu"><Icon Name="more" Size="16" /> 更多操作 <Icon Name="chevron-down" Size="14" /></button>
                @if (toolsMenuOpen)
                {
                    <div class="toolbar-popover account-tools-menu">
                        <p class="menu-section-title">数据操作</p>
                        <button type="button" class="tool-menu-row" @onclick="OpenCrsSync"><Icon Name="refresh" Size="16" /><span>从 CRS 同步</span></button>
                        <label class="tool-menu-row file-menu-row" for="account-data-import"><Icon Name="arrow-right" Size="16" /><span>导入</span><InputFile id="account-data-import" class="visually-hidden" accept=".json,application/json" OnChange="ImportAccountsAsync" /></label>
                        <button type="button" class="tool-menu-row" disabled="@exporting" @onclick="ExportAccountsAsync"><Icon Name="download" Size="16" /><span>@(selectedIds.Count > 0 ? "导出选中" : "导出")</span>@if (selectedIds.Count > 0) { <small>@selectedIds.Count</small> }</button>
                        <label class="menu-toggle-row"><input type="checkbox" @bind="includeProxiesOnExport" /><span>导出关联代理</span></label>
                        <div class="menu-divider"></div>
                        <p class="menu-section-title">工具</p>
                        <a class="tool-menu-row" href="/admin/error-passthrough"><Icon Name="alert" Size="16" /><span>错误透传规则</span></a>
                        <a class="tool-menu-row" href="/admin/tls-fingerprints"><Icon Name="key" Size="16" /><span>TLS 指纹模板</span></a>
                        <div class="menu-divider"></div>
                        <p class="menu-section-title">列显示</p>
                        @foreach (var column in ToggleableColumns)
                        {
                            <button type="button" class="menu-check-row" @onclick="() => ToggleColumnAsync(column.Key)"><span>@column.Label</span>@if (IsColumnVisible(column.Key)) { <Icon Name="check" Size="15" /> }</button>
                        }
                    </div>
                }
            </div>
            <button type="button" class="button primary" @onclick="OpenCreate"><Icon Name="plus" Size="16" /> 新建账号</button>
        </div>
    </section>

    @if (selectedIds.Count > 0)
    {
        <section class="account-bulk-bar" aria-label="账号批量操作">
            <strong>已选 @selectedIds.Count 个</strong>
            <button type="button" class="text-button" @onclick="SelectCurrentPage">选择当前页</button>
            @if (total > accounts.Count)
            {
                <button type="button" class="text-button" disabled="@selectingAll" @onclick="SelectAllFilteredAsync">@(selectingAll ? "选择中…" : $"选择全部 {total} 个结果")</button>
            }
            <span class="bulk-spacer"></span>
            <button type="button" class="button secondary small" disabled="@busy" @onclick="() => BulkSchedulableAsync(true)">开启调度</button>
            <button type="button" class="button secondary small" disabled="@busy" @onclick="() => BulkSchedulableAsync(false)">暂停调度</button>
            <button type="button" class="button secondary small" disabled="@busy" @onclick="BulkClearErrorsAsync">重置状态</button>
            <button type="button" class="button secondary small" disabled="@(busy || !CanBulkRefresh)" title="仅当当前页所选账号全部为 OAuth/Setup Token 主账号时可用" @onclick="BulkRefreshAsync">刷新 OAuth 令牌</button>
            <button type="button" class="button secondary small" disabled="@(busy || !CanBulkOpenAISettings)" title="仅支持所选 OpenAI 账号" @onclick="OpenBulkOpenAISettings"><Icon Name="settings" Size="15" /> OpenAI 设置</button>
            <button type="button" class="button danger small" disabled="@busy" @onclick="BulkDeleteAsync">删除</button>
            <button type="button" class="icon-button" title="清除选择" aria-label="清除选择" @onclick="ClearSelection"><Icon Name="x" Size="16" /></button>
        </section>
    }

    @if (error is not null)
    {
        <ErrorState Message="@error" OnRetry="ManualRefreshAsync" />
    }
    else if (loading && accounts.Count == 0)
    {
        <LoadingState Text="正在载入账号" />
    }
    else
    {
        <section class="accounts-table-shell" aria-busy="@loading">
            <div class="accounts-table-scroll">
                <table class="accounts-data-table">
                    <thead>
                        <tr>
                            <th class="select-column"><input type="checkbox" aria-label="选择当前页账号" checked="@AllCurrentPageSelected" @onchange="ToggleCurrentPage" /></th>
                            <th><button type="button" class="table-sort" @onclick='() => SortAsync("name")'>名称 @SortGlyph("name")</button></th>
                            @if (IsColumnVisible("id")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("id")'>账号ID @SortGlyph("id")</button></th> }
                            @if (IsColumnVisible("platform")) { <th>平台/类型</th> }
                            @if (IsColumnVisible("endpoint")) { <th>API 地址</th> }
                            @if (IsColumnVisible("auth")) { <th>认证</th> }
                            @if (IsColumnVisible("capacity")) { <th>容量</th> }
                            @if (IsColumnVisible("status")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("status")'>状态 @SortGlyph("status")</button></th> }
                            @if (IsColumnVisible("schedulable")) { <th class="schedule-column"><button type="button" class="table-sort" @onclick='() => SortAsync("schedulable")'>调度 @SortGlyph("schedulable")</button></th> }
                            @if (IsColumnVisible("today")) { <th>今日统计</th> }
                            @if (IsColumnVisible("groups")) { <th>分组</th> }
                            @if (IsColumnVisible("usage")) { <th title="显示后端返回的日、周和总配额用量；具体窗口由上游账号决定。">用量窗口</th> }
                            @if (IsColumnVisible("proxy")) { <th>代理</th> }
                            @if (IsColumnVisible("priority")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("priority")'>优先级 @SortGlyph("priority")</button></th> }
                            @if (IsColumnVisible("score")) { <th title="由后端根据优先级、粘性和实时负载计算，并非固定概率权重。">实时调度评分</th> }
                            @if (IsColumnVisible("rate")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("rate_multiplier")'>计费倍率 @SortGlyph("rate_multiplier")</button></th> }
                            @if (IsColumnVisible("upstream-rate")) { <th title="该值由上游站点自行声明，请结合实际账单核验。">上游声明倍率</th> }
                            @if (IsColumnVisible("last")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("last_used_at")'>最近使用 @SortGlyph("last_used_at")</button></th> }
                            @if (IsColumnVisible("created")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("created_at")'>创建时间 @SortGlyph("created_at")</button></th> }
                            @if (IsColumnVisible("expires")) { <th><button type="button" class="table-sort" @onclick='() => SortAsync("expires_at")'>过期时间 @SortGlyph("expires_at")</button></th> }
                            @if (IsColumnVisible("notes")) { <th>备注</th> }
                            <th class="actions-column">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (accounts.Count == 0)
                        {
                            <tr><td colspan="@VisibleColumnCount">
                                <div class="account-empty-state"><Icon Name="server" Size="30" /><strong>暂无账号</strong><span>新建 API Key 账号，或通过官方 OAuth 接入平台账号。</span><button type="button" class="button primary small" @onclick="OpenCreate">新建账号</button></div>
                            </td></tr>
                        }
                        else
                        {
                            @foreach (var row in accounts)
                            {
                                <tr class="@(selectedIds.Contains(row.Id) ? "selected" : null)">
                                    <td class="select-column"><input type="checkbox" aria-label="选择账号 @row.Name" checked="@selectedIds.Contains(row.Id)" @onchange="e => ToggleRow(row.Id, e.Value is true)" /></td>
                                    <td><div class="account-name-cell"><strong>@row.Name</strong>@if (!string.IsNullOrWhiteSpace(AccountEmail(row))) { <small title="@AccountEmail(row)">@AccountEmail(row)</small> }</div></td>
                                    @if (IsColumnVisible("id")) { <td><code>#@row.Id</code></td> }
                                    @if (IsColumnVisible("platform"))
                                    {
                                        var subscription = OAuthSubscriptionDisplay.From(row);
                                        <td>
                                            <div class="platform-stack">
                                                <div class="platform-meta-row">
                                                    <span class="platform-badge @(IsCopilot(row) ? "platform-copilot" : $"platform-{row.Platform}")">@AccountPlatformLabel(row)</span>
                                                    <small class="account-type-label">@AccountTypeLabel(row)</small>
                                                </div>
                                                @if (subscription is not null || row.ParentAccountId.HasValue)
                                                {
                                                    <div class="subscription-meta-row">
                                                        @if (subscription is not null)
                                                        {
                                                            <span class="subscription-plan subscription-plan-@subscription.PlanTone" title="@subscription.PlanLabel">@subscription.PlanLabel</span>
                                                        }
                                                        @if (row.ParentAccountId.HasValue) { <span class="shadow-badge">@row.QuotaDimension 影子</span> }
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(subscription?.ExpiryLabel))
                                                {
                                                    <small class="subscription-expiry" title="@subscription.ExpiryTitle">@subscription.ExpiryLabel</small>
                                                }
                                            </div>
                                        </td>
                                    }
                                    @if (IsColumnVisible("endpoint")) { <td><div class="endpoint-cell"><code title="@AccountBaseUrl(row)">@AccountBaseUrl(row)</code></div></td> }
                                    @if (IsColumnVisible("auth")) { <td><div class="auth-cell"><strong>@AuthenticationLabel(row)</strong><small class="@(CredentialConfigured(row) ? "configured" : "missing")">@(CredentialConfigured(row) ? "凭据已配置" : "凭据待补充")</small></div></td> }
                                    @if (IsColumnVisible("capacity"))
                                    {
                                        <td>
                                            <div class="capacity-cell" title="@(IsCopilot(row) ? "GitHub Copilot 本月 AI Credits 用量与并发容量。" : "并发上限与负载因子由原账号调度器使用；实时评分由后端动态计算。")">
                                                <strong>@row.CurrentConcurrency / @row.Concurrency</strong>
                                                <small>当前 / 并发上限</small>
                                                @if (IsCopilot(row) && row.CopilotBillingUsage is not null)
                                                {
                                                    <strong class="copilot-billing-capacity">@FormatCopilotCredits(CopilotBillingUsed(row)) / @FormatCopilotCredits(CopilotBillingLimit(row)) AI</strong>
                                                    <small>本月已用 / AI 总量</small>
                                                }
                                                else
                                                {
                                                    @if (row.LoadFactor.HasValue) { <small>负载因子 @row.LoadFactor</small> }
                                                    @if (row.ActiveSessions.HasValue) { <small>会话 @row.ActiveSessions</small> }
                                                    @if (row.CurrentRpm.HasValue) { <small>当前 RPM @row.CurrentRpm</small> }
                                                }
                                            </div>
                                        </td>
                                    }
                                    @if (IsColumnVisible("status")) { <td><span class="status-badge @StatusClass(row)" title="@StatusTitle(row)">@StatusLabel(row)</span></td> }
                                    @if (IsColumnVisible("schedulable")) { <td class="schedule-column"><button type="button" class="schedule-switch @(row.Schedulable ? "on" : null)" role="switch" aria-checked="@row.Schedulable.ToString().ToLowerInvariant()" aria-label="切换 @row.Name 调度" title="@(row.Schedulable ? "暂停调度" : "恢复调度")" disabled="@busy" @onclick="() => ToggleSchedulingAsync(row)"></button></td> }
                                    @if (IsColumnVisible("today")) { <td>@if (todayStats.TryGetValue(row.Id, out var stats)) { <div class="today-stats"><strong>@UiFormat.Usd(stats.StandardCost)</strong><small>@stats.Requests 次 · @stats.Tokens token</small></div> } else { <div class="today-stats"><strong>@UiFormat.Usd(0)</strong><small>0 次 · 0 token</small></div> }</td> }
                                    @if (IsColumnVisible("groups")) { <td><div class="group-badges">@if (row.Groups.Count == 0) { <span class="muted-cell">未分组</span> } else { @foreach (var group in row.Groups.Take(4)) { <span>@group.Name</span> } @if (row.Groups.Count > 4) { <small>+@(row.Groups.Count - 4)</small> } }</div></td> }
                                    @if (IsColumnVisible("usage"))
                                    {
                                        <td>
                                            <AccountQuotaUsageCell Account="row"
                                                                   TodayStats="@(todayStats.TryGetValue(row.Id, out var usageTodayStats) ? usageTodayStats : null)"
                                                                   TodayStatsLoading="@todayStatsLoading"
                                                                   Usage="@(usageByAccountId.TryGetValue(row.Id, out var accountUsage) ? accountUsage : null)"
                                                                   UsageLoading="@usageLoadingIds.Contains(row.Id)"
                                                                   UsageError="@(usageErrors.TryGetValue(row.Id, out var usageError) ? usageError : null)"
                                                                   OnUsageChanged="usage => HandleUsageChanged(row.Id, usage)"
                                                                   OnAccountChanged="() => LoadAsync(true)" />
                                        </td>
                                    }
                                    @if (IsColumnVisible("proxy")) { <td>@if (row.Proxy is null) { <span class="muted-cell">-</span> } else { <div class="proxy-cell"><strong>@row.Proxy.Name</strong><small>@row.Proxy.Protocol://@row.Proxy.Host:@row.Proxy.Port</small></div> }</td> }
                                    @if (IsColumnVisible("priority")) { <td>@row.Priority</td> }
                                    @if (IsColumnVisible("score")) { <td><code>@SchedulerScore(row)</code></td> }
                                    @if (IsColumnVisible("rate")) { <td><code>@row.RateMultiplier.ToString("0.###")x</code></td> }
                                    @if (IsColumnVisible("upstream-rate")) { <td><span class="muted-cell">@UpstreamRate(row)</span></td> }
                                    @if (IsColumnVisible("last")) { <td>@RelativeTime(row.LastUsedAt)</td> }
                                    @if (IsColumnVisible("created")) { <td>@FormatDate(row.CreatedAt)</td> }
                                    @if (IsColumnVisible("expires")) { <td><div class="expiry-cell"><span>@FormatExpiry(row.ExpiresAt)</span>@if (IsExpired(row.ExpiresAt)) { <small class="danger-text">已过期</small> } else if (row.AutoPauseOnExpired && row.ExpiresAt.HasValue) { <small>到期自动暂停</small> }</div></td> }
                                    @if (IsColumnVisible("notes")) { <td><span class="notes-cell" title="@row.Notes">@(string.IsNullOrWhiteSpace(row.Notes) ? "-" : row.Notes)</span></td> }
                                    <td class="actions-column">
                                        <div class="row-actions">
                                            <button type="button" class="row-action" title="测试连接" aria-label="测试 @row.Name" disabled="@busy" @onclick="() => TestAsync(row)"><Icon Name="pulse" Size="15" /><span>测试</span></button>
                                            <button type="button" class="row-action" title="编辑" aria-label="编辑 @row.Name" @onclick="() => OpenEdit(row)"><Icon Name="pencil" Size="15" /><span>编辑</span></button>
                                            <button type="button" class="row-action danger" title="删除" aria-label="删除 @row.Name" @onclick="() => OpenDelete(row)"><Icon Name="trash" Size="15" /><span>删除</span></button>
                                            <div class="row-more-wrap">
                                                <button type="button"
                                                        class="row-action"
                                                        title="更多"
                                                        aria-label="更多 @row.Name"
                                                        aria-haspopup="menu"
                                                        aria-expanded="@(rowMenuId == row.Id)"
                                                        @onclick="(MouseEventArgs e) => ToggleRowMenuAsync(row, e)">
                                                    <Icon Name="more" Size="15" /><span>更多</span>
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (total > 0)
        {
            <footer class="accounts-pagination">
                <span>第 @StartRow-@EndRow 条，共 @total 条</span>
                <div class="pagination-controls">
                    <label>每页 <select value="@pageSize" @onchange="PageSizeChangedAsync" aria-label="每页账号数"><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option></select></label>
                    <button type="button" class="icon-button" aria-label="上一页" disabled="@(page <= 1 || loading)" @onclick="PreviousPageAsync"><Icon Name="chevron-left" Size="16" /></button>
                    <span>@(page) / @Math.Max(1, totalPages)</span>
                    <button type="button" class="icon-button" aria-label="下一页" disabled="@(page >= totalPages || loading)" @onclick="NextPageAsync"><Icon Name="chevron-right" Size="16" /></button>
                </div>
            </footer>
        }
    }
</div>

@if (rowMenuId is not null && rowMenuPosition is not null && accounts.FirstOrDefault(row => row.Id == rowMenuId) is { } menuRow)
{
    <button type="button" class="row-action-menu-backdrop" tabindex="-1" aria-label="关闭 @menuRow.Name 的更多操作" @onclick="CloseRowMenu"></button>
    <div class="row-action-menu" style="@RowMenuStyle" role="menu" aria-label="@menuRow.Name 的更多操作">
        <button type="button" role="menuitem" @onclick="() => OpenStats(menuRow)">查看统计</button>
        <button type="button" role="menuitem" @onclick="() => DuplicateAsync(menuRow)">复制账号</button>
        @if (CanRefreshToken(menuRow))
        {
            <button type="button" role="menuitem" @onclick="() => RefreshTokenAsync(menuRow)">刷新 OAuth 令牌</button>
        }
        <button type="button" role="menuitem" @onclick="() => RecoverStateAsync(menuRow)">恢复状态</button>
        <button type="button" role="menuitem" @onclick="() => ClearRateLimitAsync(menuRow)">清除速率限制</button>
        <button type="button" role="menuitem" @onclick="() => ResetQuotaAsync(menuRow)">重置配额</button>
        <a href="/admin/models?account=@menuRow.Id" role="menuitem" @onclick="CloseRowMenu">查看模型</a>
    </div>
}

<NativeAccountCreateModal Open="@createOpen" Groups="@groups" Proxies="@proxies" OnClose="CloseCreate" OnCreated="HandleCreatedAsync" />

<AppModal Open="editorOpen" Title="编辑账号" MaxWidth="820px" OnClose="CloseEditor">
    <ChildContent>
        <EditForm id="account-editor" EditContext="editorContext" OnValidSubmit="SaveAsync" FormName="account-editor">
            <DataAnnotationsValidator />
            @if (modalError is not null) { <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@modalError</span></div> }
            @if (editorTestMessage is not null && editorTestFingerprint == EditorConnectionFingerprint()) { <div class="inline-alert success" role="status"><Icon Name="check" Size="18" /><span>@editorTestMessage</span></div> }
            <div class="form-grid account-editor-grid">
                <div class="form-field full"><label for="account-name">账号名称</label><InputText id="account-name" @bind-Value="form.Name" /><ValidationMessage For="() => form.Name" /></div>
                @if (editingIsCopilot)
                {
                    <div class="form-field"><label for="account-platform">平台</label><input id="account-platform" value="GitHub Copilot（OpenAI 兼容存储）" disabled /></div>
                }
                else
                {
                    <div class="form-field"><label for="account-platform">平台</label><select id="account-platform" value="@form.Platform" @onchange="PlatformEditorChanged" disabled="@(editingId is not null)"><option value="openai">OpenAI</option><option value="anthropic">Anthropic</option><option value="gemini">Gemini</option><option value="antigravity">Antigravity</option><option value="grok">Grok</option><option value="kimi">Kimi</option><option value="zhipu">智谱 GLM</option><option value="deepseek">DeepSeek</option></select></div>
                }
                <div class="form-field"><label for="account-type">认证类型</label><select id="account-type" value="@form.Type" @onchange="AuthenticationTypeEditorChanged" disabled="@(editingId is not null)"><option value="apikey">API Key / 自定义 Base URL</option><option value="oauth">OAuth</option>@if (form.Platform == "anthropic") { <option value="setup-token">Setup Token</option><option value="bedrock">AWS Bedrock</option> }@if (form.Platform is "anthropic" or "gemini") { <option value="service_account">Vertex Service Account</option> }@if (editingId is not null && form.Type == "upstream") { <option value="upstream">旧版 Upstream（仅兼容）</option> }</select><small class="form-hint">编辑已有账号时不可更改平台或认证类型；如需迁移，请新建账号。</small></div>
                @if (editingIsCopilot)
                {
