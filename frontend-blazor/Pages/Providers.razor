    {
        form.Platform, form.Type, form.ApiKey,
        form.AccessToken, form.RefreshToken, form.CredentialsJson, form.BaseUrl,
        form.AdaptiveChatCompletionsBaseUrl, form.AdaptiveAnthropicBaseUrl, form.AdaptiveResponsesBaseUrl, form.ProxyId, form.ExtraJson
        , form.BillingUsername, form.BillingCreditLimit, form.BillingSafetyMargin, form.BillingAutoPauseDisabled
    });
