    private void OpenEdit(AccountDto account)
    {
        editingId = account.Id;
        editingIsCopilot = IsCopilot(account);
        var accountMode = ReadCredential(account, "account_mode");
        var apiProtocol = ReadCredential(account, "api_protocol");
        form = new AccountInput
        {
            IsEditing = true, Name = account.Name, Notes = account.Notes ?? string.Empty,
            Platform = account.Platform, Type = account.Type,
            BaseUrl = ReadCredential(account, "base_url"), Concurrency = account.Concurrency,
            AccountMode = string.IsNullOrWhiteSpace(accountMode) ? "payg" : accountMode,
            ApiProtocol = string.IsNullOrWhiteSpace(apiProtocol) ? "chat_completions" : apiProtocol,
            AdaptiveChatCompletionsBaseUrl = ReadCredentialObjectString(account, "api_base_urls", "chat_completions"),
            AdaptiveAnthropicBaseUrl = ReadCredentialObjectString(account, "api_base_urls", "anthropic"),
            AdaptiveResponsesBaseUrl = ReadCredentialObjectString(account, "api_base_urls", "responses"),
            LoadFactor = account.LoadFactor, Priority = account.Priority,
            RateMultiplier = account.RateMultiplier, ProxyId = account.ProxyId, ExpiresAt = account.ExpiresAt,
            AutoPauseOnExpired = account.AutoPauseOnExpired, Schedulable = account.Schedulable,
            IsCopilotProfile = editingIsCopilot,
            BillingUsername = editingIsCopilot ? ReadCopilotBillingUsername(account) : string.Empty,
            HasBillingPat = editingIsCopilot && HasCredentialStatus(account, "has_billing_pat", "billing_pat"),
            BillingCreditLimit = editingIsCopilot ? ReadExtraNumber(account, "billing_credit_limit") ?? 20_000 : 20_000,
            BillingSafetyMargin = editingIsCopilot ? ReadExtraNumber(account, "billing_safety_margin") ?? 200 : 200,
            BillingAutoPauseDisabled = editingIsCopilot && ReadExtraBool(account, "billing_auto_pause_disabled"),
            ProbeEnabled = ReadExtraBool(account, "upstream_billing_probe_enabled"),
            RateSyncEnabled = ReadExtraBool(account, "upstream_billing_rate_sync_enabled"),
            ExtraJson = account.Extra is null ? "{}" : JsonSerializer.Serialize(account.Extra, PrettyJson),
            GroupIds = [.. account.GroupIds]
        };
        if (form.ApiProtocol == "adaptive") EnsureAdaptiveBaseUrls(form);
        AccountModelRestrictions.Load(form, account.Credentials);
        formExpiryLocal = account.ExpiresAt.HasValue ? FromUnix(account.ExpiresAt.Value).ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : string.Empty;
        editorContext = new EditContext(form);
        modalError = null; editorTestMessage = null; editorTestFingerprint = null; ResetEditorCopilotBillingValidation(); editorOpen = true; CloseRowMenu();
    }
