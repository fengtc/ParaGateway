                <div class="form-field"><label for="account-priority">优先级</label><InputNumber id="account-priority" @bind-Value="form.Priority" /><small class="form-hint">数值越小越优先。</small><ValidationMessage For="() => form.Priority" /></div>
                <div class="form-field"><label for="account-rate">计费倍率</label><InputNumber id="account-rate" @bind-Value="form.RateMultiplier" step="0.001" /><ValidationMessage For="() => form.RateMultiplier" /></div>
                <div class="form-field"><label for="account-expiry">过期时间（可选）</label><input id="account-expiry" type="datetime-local" value="@formExpiryLocal" @onchange="ExpiryChanged" /></div>
                <div class="form-field full">
                    <label>所属分组</label>
                    <div class="editor-group-picker">
                        @if (!AvailableEditorGroups.Any())
                        {
                            <span class="muted-text">当前平台暂无可用分组</span>
                        }
                        else
                        {
                            @foreach (var group in AvailableEditorGroups)
                            {
                                var groupId = long.Parse(group.Id);
                                <label><input type="checkbox" checked="@form.GroupIds.Contains(groupId)" @onchange="e => ToggleEditorGroup(groupId, e.Value is true)" /><span>@group.Name</span><small>@group.Platform</small></label>
                            }
                        }
                    </div>
                    <small class="form-hint">仅显示与账号平台兼容的分组；复合分组可接收任意平台账号。</small>
                </div>
                <label class="toggle-row"><InputCheckbox @bind-Value="form.Schedulable" /><span><strong>启用账号调度</strong><small>关闭后不会把新请求调度到此账号。</small></span></label>
                <label class="toggle-row"><InputCheckbox @bind-Value="form.AutoPauseOnExpired" /><span><strong>到期自动暂停</strong><small>超过过期时间后不再参与调度。</small></span></label>
                @if (ApiClient.IsUpstreamBillingProbeAccount(form.Platform, form.Type))
                {
                    <label class="toggle-row"><InputCheckbox @bind-Value="form.ProbeEnabled" /><span><strong>启用上游计费探测</strong><small>自动探测上游公开的计费倍率。</small></span></label>
                    <label class="toggle-row"><InputCheckbox @bind-Value="form.RateSyncEnabled" disabled="@(!form.ProbeEnabled)" /><span><strong>同步上游声明倍率</strong><small>探测成功后更新账号倍率。</small></span></label>
                }
                <div class="form-field full"><label for="account-extra-json">扩展配置 JSON</label><InputTextArea id="account-extra-json" @bind-Value="form.ExtraJson" rows="5" placeholder="{}" /></div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseEditor">取消</button>@if (CanTestEditor) { <button type="button" class="button secondary" disabled="@(saving || editorTesting)" @onclick="TestEditorAsync">@(editorTesting ? "测试中…" : EditorTestLabel)</button> }<button type="button" class="button primary" disabled="@(saving || editorTesting)" @onclick="SubmitEditorAsync">@(saving ? "保存中…" : "保存账号")</button></Footer>
</AppModal>

<AppModal Open="bulkOpenAISettingsOpen" Title="OpenAI 批量设置" MaxWidth="640px" OnClose="CloseBulkOpenAISettings">
    <ChildContent>
        <div class="bulk-openai-settings">
            @if (bulkOpenAIError is not null) { <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@bulkOpenAIError</span></div> }
            <p class="muted-text">将设置应用到选中的 @selectedIds.Count 个 OpenAI 账号；未勾选的项目保持原值。</p>
            <label class="toggle-row"><InputCheckbox @bind-Value="applyOpenAILongContext" /><span><strong>修改长上下文计费</strong><small>启用后按官方长上下文价格规则计费。</small></span></label>
            @if (applyOpenAILongContext)
            {
                <label class="toggle-row nested-setting"><InputCheckbox @bind-Value="openAILongContextEnabled" /><span><strong>启用长上下文计费</strong></span></label>
            }
            <label class="toggle-row"><InputCheckbox @bind-Value="applyOpenAICapabilities" /><span><strong>修改端点能力</strong><small>限制账号可接收的 OpenAI 接口类型。</small></span></label>
