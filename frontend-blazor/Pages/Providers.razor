    private void ToggleEditorGroup(long id, bool selected) { if (selected && !form.GroupIds.Contains(id)) form.GroupIds.Add(id); else if (!selected) form.GroupIds.Remove(id); }
    private bool IsEditorMixedSchedulingEnabled()
    {
        if (!form.Platform.Equals("antigravity", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(form.ExtraJson)) return false;
        try
        {
            using var document = JsonDocument.Parse(form.ExtraJson);
            return document.RootElement.TryGetProperty("mixed_scheduling", out var value)
                && value.ValueKind == JsonValueKind.True;
        }
        catch (JsonException)
        {
            return false;
        }
    }
    private async Task SubmitEditorAsync()
    {
        modalError = null;
        if (editorContext is null)
        {
            modalError = "账号编辑器尚未初始化，请关闭后重新打开。";
            return;
        }
        if (!editorContext.Validate())
        {
            var validationMessages = editorContext.GetValidationMessages()
                .Where(message => !string.IsNullOrWhiteSpace(message))
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            modalError = validationMessages.Length > 0
                ? $"无法保存：{string.Join("；", validationMessages)}"
                : "请检查账号名称、地址和数值字段后再保存。";
            return;
        }
        await SaveAsync();
    }
    private async Task SaveAsync()
    {
        saving = true; modalError = null;
        try
        {
            var saved = editingId is null ? await Api.CreateAccountAsync(form) : await Api.UpdateAccountAsync(editingId, form);
            if (saved.Schedulable != form.Schedulable) saved = await Api.SetAccountSchedulableAsync(saved.Id, form.Schedulable);
            CloseEditor(); Toasts.Success(editingId is null ? "账号已创建" : "账号已更新"); await LoadAsync(); selectedIds.Add(saved.Id);
        }
        catch (ApiException ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

    private async Task TestEditorAsync()
    {
        editorTesting = true; modalError = null; editorTestMessage = null; editorTestFingerprint = null;
        try
        {
            if (form.Type == "apikey" && (editingId is null || !string.IsNullOrWhiteSpace(form.ApiKey)))
            {
                var models = await Api.PreviewAccountModelsAsync(form);
                editorTestMessage = $"模型目录读取成功，共 {models.Count} 个模型；未验证代理、扩展配置或推理接口。";
                editorTestFingerprint = EditorConnectionFingerprint();
            }
            else if (editingId is not null)
            {
                var result = await Api.TestAccountAsync(editingId);
                if (!result.Success) throw new ApiException(string.IsNullOrWhiteSpace(result.Message) ? "连接测试失败" : result.Message);
                editorTestMessage = $"已保存配置连接成功{(result.LatencyMs.HasValue ? $"（{result.LatencyMs} ms）" : string.Empty)}；当前尚未保存的字段未参与本次测试。";
                editorTestFingerprint = EditorConnectionFingerprint();
            }
        }
        catch (ApiException ex) { modalError = ex.Message; }
        finally { editorTesting = false; }
    }

