@page "/admin/upstream-accounts"
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>上游账号 · ParaGateway</PageTitle>

<div class="page-header">
    <div>
        <h1>上游账号</h1>
        <p>独立管理 OpenAI 与 Claude 兼容连接；此处数据不属于“账号管理”。</p>
    </div>
    <div class="page-header-actions">
        <a class="button secondary" href="/admin/accounts"><Icon Name="users" Size="17" /> 账号管理</a>
        <button type="button" class="button primary" @onclick="OpenCreate"><Icon Name="plus" Size="17" /> 新建上游账号</button>
    </div>
</div>

<div class="inline-alert info upstream-domain-note" role="note">
    <Icon Name="info" Size="18" />
    <span>独立边界：本页使用 <code>upstream_accounts</code> 与 <code>/api/v1/admin/upstream-accounts</code>；官方 OAuth、分组绑定和原 Go 平台账号仍在“账号管理”。</span>
</div>

<div class="toolbar">
    <div class="search-box">
        <Icon Name="search" Size="17" />
        <input value="@search" @oninput="SearchChanged" placeholder="搜索名称或 API 地址" aria-label="搜索上游账号" />
    </div>
    <select value="@providerFilter" @onchange="ProviderFilterChanged" aria-label="上游类型筛选">
        <option value="">全部类型</option>
        <option value="openai">OpenAI</option>
        <option value="claude">Claude</option>
    </select>
    <select value="@statusFilter" @onchange="StatusFilterChanged" aria-label="调度状态筛选">
        <option value="">全部状态</option>
        <option value="active">参与调度</option>
        <option value="inactive">已暂停</option>
    </select>
    <span class="result-count">@FilteredAccounts.Count 个账号</span>
    <button type="button" class="icon-button" title="刷新账号" aria-label="刷新账号" disabled="@loading" @onclick="LoadAsync"><Icon Name="refresh" Size="17" /></button>
</div>

@if (loading)
{
    <LoadingState Text="正在载入上游账号" />
}
else if (error is not null)
{
    <ErrorState Message="@error" OnRetry="LoadAsync" />
}
else if (FilteredAccounts.Count == 0)
{
    <EmptyState Title="@(string.IsNullOrWhiteSpace(search) ? "还没有上游账号" : "没有匹配的账号")"
                Description="@(string.IsNullOrWhiteSpace(search) ? "添加独立的 OpenAI 或 Claude 连接以建立上游池。" : "请调整关键词或筛选条件。")">
        <Action>
            @if (string.IsNullOrWhiteSpace(search))
            {
                <button type="button" class="button primary small" @onclick="OpenCreate"><Icon Name="plus" Size="16" /> 新建上游账号</button>
            }
        </Action>
    </EmptyState>
}
else
{
    <div class="data-table-wrap providers-table-wrap">
        <table class="data-table providers-table">
            <thead>
                <tr>
                    <th>账号</th>
                    <th>类型</th>
                    <th>API 地址</th>
                    <th>认证</th>
                    <th>调度策略</th>
                    <th>访问限制</th>
                    <th>健康状态</th>
                    <th>调度</th>
                    <th>用量窗口</th>
                    <th class="actions-column">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in FilteredAccounts)
                {
                    <tr @key="account.Id">
                        <td data-label="账号"><span class="primary-cell">@account.Name</span><small>ID @ShortId(account.Id)</small></td>
                        <td data-label="类型"><span class="provider-badge @account.ProviderType">@ProviderLabel(account.ProviderType)</span></td>
                        <td data-label="API 地址"><span class="truncate-cell" title="@account.BaseUrl">@account.BaseUrl</span></td>
                        <td data-label="认证"><span class="primary-cell">@AuthLabel(account.AuthType)</span><small><code class="key-prefix">@account.MaskedCredential</code></small></td>
                        <td data-label="调度策略"><span class="primary-cell">优先级 @account.Priority</span><small>权重 @account.Weight</small></td>
                        <td data-label="访问限制"><span class="primary-cell">@account.MaxConcurrency 并发</span><small>@account.RpmLimit RPM · 熔断 @account.CircuitBreakerThreshold/@account.CircuitBreakerCooldownSeconds 秒</small></td>
                        <td data-label="健康状态"><span class="status-badge @StatusClass(account)">@StatusLabel(account)</span>@if (!string.IsNullOrWhiteSpace(StatusDetail(account))) { <small>@StatusDetail(account)</small> }</td>
                        <td data-label="调度">
                            <label class="schedule-switch" title="@(account.IsActive ? "暂停调度" : "恢复调度")">
                                <input type="checkbox" role="switch" checked="@account.IsActive" disabled="@schedulingIds.Contains(account.Id)" @onchange="args => SetSchedulingAsync(account, args)" />
                                <span aria-hidden="true"></span>
                            </label>
                            <small>@(account.IsActive ? "参与账号池" : "已停止")</small>
                        </td>
                        <td data-label="用量窗口" class="usage-window-cell">
                            @if (UsageWindowRows(account).Count == 0)
                            {
                                <span class="usage-window-empty">暂无用量数据</span>
                            }
                            else
                            {
                                <div class="usage-windows" title="@UsageCheckedTitle(account)">
                                    @foreach (var window in UsageWindowRows(account))
                                    {
                                        <div class="usage-window-row" @key="window.Label">
                                            <span class="usage-window-label @window.Kind">@window.Label</span>
                                            <div class="usage-window-meter">
                                                <span class="usage-window-track"><span style="width: @ProgressWidth(window.Utilization)"></span></span>
                                                <small>@UsageWindowSummary(window)</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td data-label="操作" class="actions-cell">
                            <button type="button" class="icon-button" title="测试连接" aria-label="测试 @account.Name" disabled="@testingIds.Contains(account.Id)" @onclick="() => TestSavedAsync(account)"><Icon Name="activity" Size="16" /></button>
                            <button type="button" class="icon-button" title="编辑" aria-label="编辑 @account.Name" @onclick="() => OpenEdit(account)"><Icon Name="pencil" Size="16" /></button>
                            <button type="button" class="icon-button danger" title="删除" aria-label="删除 @account.Name" @onclick="() => ConfirmDelete(account)"><Icon Name="trash" Size="16" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<AppModal Open="editorOpen" Title="@(editingId is null ? "新建上游账号" : "编辑上游账号")" MaxWidth="760px" OnClose="CloseEditor">
    <ChildContent>
        <EditForm id="upstream-account-editor" Model="form" OnValidSubmit="SaveAsync" FormName="upstream-account-editor">
            <DataAnnotationsValidator />
            @if (modalError is not null)
            {
                <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@modalError</span></div>
            }
            @if (connectionMessage is not null)
            {
                <div class="inline-alert @(connectionSucceeded ? "success" : "danger")" role="@(connectionSucceeded ? "status" : "alert")">
                    <Icon Name="@(connectionSucceeded ? "circle-check" : "alert")" Size="18" /><span>@connectionMessage</span>
                </div>
            }
            <div class="form-grid">
                <div class="form-field full"><label for="upstream-name">账号名称</label><InputText id="upstream-name" @bind-Value="form.Name" placeholder="例如：OpenAI 主连接" /><ValidationMessage For="() => form.Name" /></div>
                <div class="form-field">
                    <label for="upstream-type">类型</label>
                    <select id="upstream-type" value="@form.ProviderType" @onchange="ProviderTypeChanged"><option value="openai">OpenAI</option><option value="claude">Claude</option></select>
                </div>
                <div class="form-field">
                    <label for="upstream-auth">认证方式</label>
                    <select id="upstream-auth" value="@form.AuthType" @onchange="AuthTypeChanged"><option value="api_key">API Key</option><option value="wif">身份联合 WIF</option></select>
                </div>
                <div class="form-field full"><label for="upstream-url">API 地址</label><InputText id="upstream-url" @bind-Value="form.BaseUrl" type="url" readonly="@IsWif" /><ValidationMessage For="() => form.BaseUrl" /></div>
                @if (!IsWif)
                {
                    <div class="form-field full"><label for="upstream-key">API Key @CredentialHint</label><InputText id="upstream-key" @bind-Value="form.ApiKey" type="password" autocomplete="new-password" /></div>
                }
                else
                {
                    <div class="inline-alert info full"><Icon Name="shield" Size="18" /><span>WIF Client Secret 仅作为一次性输入，经服务端 AES-256-GCM 加密后保存。</span></div>
                    <div class="form-field full"><label for="upstream-wif-url">外部 IdP Token URL</label><InputText id="upstream-wif-url" @bind-Value="form.WifSubjectTokenUrl" type="url" autocomplete="off" /><ValidationMessage For="() => form.WifSubjectTokenUrl" /></div>
                    <div class="form-field"><label for="upstream-wif-client-id">外部 IdP Client ID</label><InputText id="upstream-wif-client-id" @bind-Value="form.WifClientId" autocomplete="off" /><ValidationMessage For="() => form.WifClientId" /></div>
                    <div class="form-field"><label for="upstream-wif-secret">外部 IdP Client Secret @CredentialHint</label><InputText id="upstream-wif-secret" @bind-Value="form.WifClientSecret" type="password" autocomplete="new-password" /><ValidationMessage For="() => form.WifClientSecret" /></div>
                    <div class="form-field"><label for="upstream-wif-auth-method">客户端认证方式</label><select id="upstream-wif-auth-method" @bind="form.WifClientAuthMethod"><option value="client_secret_basic">client_secret_basic</option><option value="client_secret_post">client_secret_post</option></select></div>
                    <div class="form-field"><label for="upstream-wif-service">Service Account ID</label><InputText id="upstream-wif-service" @bind-Value="form.WifServiceAccountId" autocomplete="off" /><ValidationMessage For="() => form.WifServiceAccountId" /></div>
                    <div class="form-field"><label for="upstream-wif-audience">Audience（可选）</label><InputText id="upstream-wif-audience" @bind-Value="form.WifAudience" /></div>
                    <div class="form-field"><label for="upstream-wif-scope">Scope（可选）</label><InputText id="upstream-wif-scope" @bind-Value="form.WifScope" /></div>
                    @if (form.ProviderType == "openai")
                    {
                        <div class="form-field full"><label for="upstream-wif-idp">Identity Provider ID</label><InputText id="upstream-wif-idp" @bind-Value="form.WifIdentityProviderId" /><ValidationMessage For="() => form.WifIdentityProviderId" /></div>
                    }
                    else
                    {
                        <div class="form-field"><label for="upstream-wif-rule">Federation Rule ID</label><InputText id="upstream-wif-rule" @bind-Value="form.WifFederationRuleId" /><ValidationMessage For="() => form.WifFederationRuleId" /></div>
                        <div class="form-field"><label for="upstream-wif-org">Organization ID</label><InputText id="upstream-wif-org" @bind-Value="form.WifOrganizationId" /><ValidationMessage For="() => form.WifOrganizationId" /></div>
                        <div class="form-field full"><label for="upstream-wif-workspace">Workspace ID（可选）</label><InputText id="upstream-wif-workspace" @bind-Value="form.WifWorkspaceId" /></div>
                    }
                }
                <div class="form-field"><label for="upstream-priority">优先级</label><InputNumber id="upstream-priority" @bind-Value="form.Priority" /><small class="field-hint">数值越小越优先。</small><ValidationMessage For="() => form.Priority" /></div>
                <div class="form-field"><label for="upstream-weight">调度权重</label><InputNumber id="upstream-weight" @bind-Value="form.Weight" /><ValidationMessage For="() => form.Weight" /></div>
                <div class="form-field"><label for="upstream-concurrency">最大并发</label><InputNumber id="upstream-concurrency" @bind-Value="form.MaxConcurrency" /><ValidationMessage For="() => form.MaxConcurrency" /></div>
                <div class="form-field"><label for="upstream-rpm">每分钟请求上限</label><InputNumber id="upstream-rpm" @bind-Value="form.RpmLimit" /><ValidationMessage For="() => form.RpmLimit" /></div>
                <div class="form-field"><label for="upstream-breaker">连续失败熔断阈值</label><InputNumber id="upstream-breaker" @bind-Value="form.CircuitBreakerThreshold" /><ValidationMessage For="() => form.CircuitBreakerThreshold" /></div>
                <div class="form-field"><label for="upstream-cooldown">熔断冷却时间（秒）</label><InputNumber id="upstream-cooldown" @bind-Value="form.CircuitBreakerCooldownSeconds" /><ValidationMessage For="() => form.CircuitBreakerCooldownSeconds" /></div>
                <label class="toggle-row full"><InputCheckbox @bind-Value="form.IsActive" /><span><strong>参与调度</strong><small>关闭后保留配置，但不进入独立上游池。</small></span></label>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="button secondary" disabled="@(saving || testingConnection)" @onclick="CloseEditor">取消</button>
        <button type="button" class="button secondary" disabled="@(saving || testingConnection)" @onclick="TestEditorAsync">@(testingConnection ? "测试中…" : "测试连接")</button>
        <button type="submit" form="upstream-account-editor" class="button primary" disabled="@(saving || testingConnection)">@(saving ? "保存中…" : "保存账号")</button>
    </Footer>
</AppModal>

<AppModal Open="deleteOpen" Title="删除上游账号" MaxWidth="480px" OnClose="CloseDelete">
    <ChildContent>
        <p>确定删除“<strong>@deleting?.Name</strong>”吗？账号将从独立上游池移除，原“账号管理”数据不受影响。</p>
        @if (modalError is not null) { <div class="inline-alert danger"><Icon Name="alert" Size="18" /><span>@modalError</span></div> }
    </ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseDelete">取消</button><button type="button" class="button danger" disabled="@saving" @onclick="DeleteAsync">@(saving ? "删除中…" : "删除")</button></Footer>
</AppModal>

@code {
    private List<UpstreamAccountDto> accounts = [];
    private readonly HashSet<string> schedulingIds = [];
    private readonly HashSet<string> testingIds = [];
    private UpstreamAccountInput form = NewForm();
    private UpstreamAccountDto? deleting;
    private string search = string.Empty;
    private string providerFilter = string.Empty;
    private string statusFilter = string.Empty;
    private string? editingId;
    private string? error;
    private string? modalError;
    private string? connectionMessage;
    private bool connectionSucceeded;
    private bool loading = true;
    private bool saving;
    private bool testingConnection;
    private bool editorOpen;
    private bool deleteOpen;

    private bool IsWif => form.AuthType == "wif";
    private string CredentialHint => RequiresNewCredential() ? "（必填）" : "（留空则保持不变）";
    private List<UpstreamAccountDto> FilteredAccounts => accounts.Where(account =>
        (string.IsNullOrWhiteSpace(search) || account.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || account.BaseUrl.Contains(search, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(providerFilter) || account.ProviderType == providerFilter)
        && (string.IsNullOrWhiteSpace(statusFilter) || (statusFilter == "active" ? account.IsActive : !account.IsActive))).ToList();

    private sealed record UsageWindowView(string Label, string Kind, double Utilization, DateTimeOffset? ResetsAt);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; error = null;
        try { accounts = await Api.GetUpstreamAccountsAsync(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void SearchChanged(ChangeEventArgs args) => search = args.Value?.ToString() ?? string.Empty;
    private void ProviderFilterChanged(ChangeEventArgs args) => providerFilter = args.Value?.ToString() ?? string.Empty;
    private void StatusFilterChanged(ChangeEventArgs args) => statusFilter = args.Value?.ToString() ?? string.Empty;

    private void OpenCreate()
    {
        editingId = null; form = NewForm(); modalError = null; ResetConnection(); editorOpen = true;
    }

    private void OpenEdit(UpstreamAccountDto account)
    {
        editingId = account.Id;
        form = new UpstreamAccountInput
        {
            Name = account.Name, ProviderType = account.ProviderType, BaseUrl = account.BaseUrl, AuthType = account.AuthType,
            WifSubjectTokenUrl = account.WifSubjectTokenUrl, WifClientId = account.WifClientId,
            WifClientAuthMethod = account.WifClientAuthMethod ?? "client_secret_basic", WifAudience = account.WifAudience,
            WifScope = account.WifScope, WifIdentityProviderId = account.WifIdentityProviderId,
            WifServiceAccountId = account.WifServiceAccountId, WifFederationRuleId = account.WifFederationRuleId,
            WifOrganizationId = account.WifOrganizationId, WifWorkspaceId = account.WifWorkspaceId,
            IsActive = account.IsActive, Priority = account.Priority, Weight = account.Weight,
            MaxConcurrency = account.MaxConcurrency, RpmLimit = account.RpmLimit,
            CircuitBreakerThreshold = account.CircuitBreakerThreshold,
            CircuitBreakerCooldownSeconds = account.CircuitBreakerCooldownSeconds,
            IsEditing = true, OriginalProviderType = account.ProviderType, OriginalBaseUrl = account.BaseUrl,
            OriginalAuthType = account.AuthType, OriginalWifSubjectTokenUrl = account.WifSubjectTokenUrl ?? string.Empty,
            OriginalWifClientId = account.WifClientId ?? string.Empty,
            OriginalWifClientAuthMethod = account.WifClientAuthMethod ?? "client_secret_basic"
        };
        modalError = null; ResetConnection(); editorOpen = true;
    }

    private void CloseEditor() { if (!saving && !testingConnection) editorOpen = false; }

    private void ProviderTypeChanged(ChangeEventArgs args)
    {
        var previousDefault = OfficialBaseUrl(form.ProviderType);
        form.ProviderType = args.Value?.ToString() == "claude" ? "claude" : "openai";
        if (IsWif || string.IsNullOrWhiteSpace(form.BaseUrl) || form.BaseUrl.TrimEnd('/') == previousDefault) form.BaseUrl = OfficialBaseUrl(form.ProviderType);
        ResetConnection();
    }

    private void AuthTypeChanged(ChangeEventArgs args)
    {
        form.AuthType = args.Value?.ToString() == "wif" ? "wif" : "api_key";
        form.ApiKey = null; form.WifClientSecret = null;
        if (IsWif) form.BaseUrl = OfficialBaseUrl(form.ProviderType);
        ResetConnection();
    }

    private async Task SaveAsync()
    {
        saving = true; modalError = null; NormalizeForm();
        try
        {
            if (editingId is null) await Api.CreateUpstreamAccountAsync(form);
            else await Api.UpdateUpstreamAccountAsync(editingId, form);
            editorOpen = false; Toasts.Success(editingId is null ? "上游账号已创建" : "上游账号已更新"); await LoadAsync();
        }
        catch (ApiException ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

    private async Task TestEditorAsync()
    {
        testingConnection = true; modalError = null; ResetConnection(); NormalizeForm();
        try
        {
            UpstreamConnectionTestResultDto result;
            if (editingId is not null && !RequiresNewCredential() && string.IsNullOrWhiteSpace(IsWif ? form.WifClientSecret : form.ApiKey))
                result = await Api.TestUpstreamAccountSavedAsync(editingId);
            else
                result = await Api.TestUpstreamAccountDraftAsync(form);
            connectionSucceeded = result.Success;
            connectionMessage = string.IsNullOrWhiteSpace(result.Message) ? (result.Success ? "连接成功" : "连接测试失败") : result.Message;
        }
        catch (ApiException ex) { connectionSucceeded = false; connectionMessage = ex.Message; }
        finally { testingConnection = false; }
    }

    private async Task TestSavedAsync(UpstreamAccountDto account)
    {
        if (!testingIds.Add(account.Id)) return;
        try
        {
            var result = await Api.TestUpstreamAccountSavedAsync(account.Id);
            if (result.Success) Toasts.Success($"{account.Name}：{result.Message}"); else Toasts.Error($"{account.Name}：{result.Message}");
        }
        catch (ApiException ex) { Toasts.Error($"{account.Name}：{ex.Message}"); }
        finally { testingIds.Remove(account.Id); }
    }

    private async Task SetSchedulingAsync(UpstreamAccountDto account, ChangeEventArgs args)
    {
        var next = args.Value is bool enabled ? enabled : !account.IsActive;
        if (!schedulingIds.Add(account.Id)) return;
        try
        {
            var updated = await Api.SetUpstreamAccountSchedulingAsync(account.Id, next);
            var index = accounts.FindIndex(item => item.Id == account.Id); if (index >= 0) accounts[index] = updated;
            Toasts.Success(next ? $"已恢复 {account.Name} 的调度" : $"已暂停 {account.Name} 的调度");
        }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
        finally { schedulingIds.Remove(account.Id); }
    }

    private void ConfirmDelete(UpstreamAccountDto account) { deleting = account; modalError = null; deleteOpen = true; }
    private void CloseDelete() { if (!saving) { deleteOpen = false; deleting = null; } }
    private async Task DeleteAsync()
    {
        if (deleting is null) return;
        saving = true; modalError = null;
        try { await Api.DeleteUpstreamAccountAsync(deleting.Id); deleteOpen = false; Toasts.Success("上游账号已删除"); deleting = null; await LoadAsync(); }
        catch (ApiException ex) { modalError = ex.Message; }
        finally { saving = false; }
    }

    private bool RequiresNewCredential()
    {
        if (!form.IsEditing) return true;
        if (form.OriginalProviderType != form.ProviderType || form.OriginalAuthType != form.AuthType || !SameOrigin(form.OriginalBaseUrl, form.BaseUrl)) return true;
        return IsWif && (!Equivalent(form.OriginalWifSubjectTokenUrl, form.WifSubjectTokenUrl, true)
            || !Equivalent(form.OriginalWifClientId, form.WifClientId, false)
            || form.OriginalWifClientAuthMethod != form.WifClientAuthMethod);
    }

    private void NormalizeForm()
    {
        form.Name = form.Name.Trim(); form.BaseUrl = form.BaseUrl.Trim().TrimEnd('/');
        form.ApiKey = TrimOrNull(form.ApiKey); form.WifClientSecret = TrimOrNull(form.WifClientSecret);
        form.WifSubjectTokenUrl = TrimOrNull(form.WifSubjectTokenUrl); form.WifClientId = TrimOrNull(form.WifClientId);
        form.WifAudience = TrimOrNull(form.WifAudience); form.WifScope = TrimOrNull(form.WifScope);
        form.WifIdentityProviderId = TrimOrNull(form.WifIdentityProviderId); form.WifServiceAccountId = TrimOrNull(form.WifServiceAccountId);
        form.WifFederationRuleId = TrimOrNull(form.WifFederationRuleId); form.WifOrganizationId = TrimOrNull(form.WifOrganizationId);
        form.WifWorkspaceId = TrimOrNull(form.WifWorkspaceId);
        if (!IsWif)
        {
            form.WifClientSecret = form.WifSubjectTokenUrl = form.WifClientId = form.WifAudience = form.WifScope = null;
            form.WifIdentityProviderId = form.WifServiceAccountId = form.WifFederationRuleId = form.WifOrganizationId = form.WifWorkspaceId = null;
        }
        else
        {
            form.ApiKey = null; form.BaseUrl = OfficialBaseUrl(form.ProviderType);
            if (form.ProviderType == "openai") form.WifFederationRuleId = form.WifOrganizationId = form.WifWorkspaceId = null;
            else form.WifIdentityProviderId = null;
        }
    }

    private void ResetConnection() { connectionSucceeded = false; connectionMessage = null; }
    private static UpstreamAccountInput NewForm() => new();
    private static string ProviderLabel(string type) => type == "claude" ? "Claude" : "OpenAI";
    private static string AuthLabel(string type) => type == "wif" ? "外部 IdP 身份联合" : "API Key";
    private static string OfficialBaseUrl(string type) => type == "claude" ? "https://api.anthropic.com" : "https://api.openai.com";
    private static string ShortId(string id) => id[..Math.Min(8, id.Length)];
    private static string StatusClass(UpstreamAccountDto account) => !account.IsActive ? "neutral" : account.CooldownUntil > DateTimeOffset.UtcNow || account.QuotaStatus == "error" ? "warning" : account.QuotaStatus == "exhausted" ? "danger" : "success";
    private static string StatusLabel(UpstreamAccountDto account) => !account.IsActive ? "已暂停" : account.CooldownUntil > DateTimeOffset.UtcNow ? "冷却中" : account.QuotaStatus switch { "available" => "健康", "exhausted" => "额度耗尽", "error" => "探测异常", _ => "待探测" };
    private static string StatusDetail(UpstreamAccountDto account) => account.QuotaUtilization.HasValue ? $"用量 {account.QuotaUtilization:0.#}%" : account.LastUpstreamStatus.HasValue ? $"最近 HTTP {account.LastUpstreamStatus}" : string.Empty;
    private static List<UsageWindowView> UsageWindowRows(UpstreamAccountDto account)
    {
        var windows = account.UsageWindows ?? new UpstreamUsageWindowsDto();
        var rows = new List<UsageWindowView>(3);
        if (windows.FiveHour is not null) rows.Add(new("5h", "short", windows.FiveHour.Utilization, windows.FiveHour.ResetsAt));
        if (windows.SevenDay is not null) rows.Add(new("7d", "long", windows.SevenDay.Utilization, windows.SevenDay.ResetsAt));
        if (windows.SevenDaySonnet is not null) rows.Add(new("S7d", "sonnet", windows.SevenDaySonnet.Utilization, windows.SevenDaySonnet.ResetsAt));
        if (rows.Count == 0 && account.QuotaUtilization is not null)
            rows.Add(new(account.OAuthProfile == "github_copilot" ? "月度" : "额度", "long", account.QuotaUtilization.Value, account.QuotaResetsAt));
        return rows;
    }
    private static string ProgressWidth(double utilization) => $"{Math.Clamp(utilization, 0, 100):0.##}%";
    private static string UsageWindowSummary(UsageWindowView window) => $"{window.Utilization:0.#}%{(window.ResetsAt is null ? string.Empty : $" · {RelativeReset(window.ResetsAt.Value)}")}";
    private static string RelativeReset(DateTimeOffset resetsAt)
    {
        var remaining = resetsAt - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero) return "等待重置";
        if (remaining.TotalDays >= 1) return $"{(int)remaining.TotalDays}天{remaining.Hours}小时后";
        if (remaining.TotalHours >= 1) return $"{(int)remaining.TotalHours}小时{remaining.Minutes}分后";
        return $"{Math.Max(1, remaining.Minutes)}分钟后";
    }
    private static string UsageCheckedTitle(UpstreamAccountDto account) => account.QuotaCheckedAt is null
        ? "尚未探测用量"
        : $"最近探测：{account.QuotaCheckedAt.Value.ToLocalTime():yyyy-MM-dd HH:mm:ss}";
    private static string? TrimOrNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static bool Equivalent(string? left, string? right, bool url)
    {
        var normalizedLeft = TrimOrNull(left);
        var normalizedRight = TrimOrNull(right);
        if (url)
        {
            normalizedLeft = normalizedLeft?.TrimEnd('/');
            normalizedRight = normalizedRight?.TrimEnd('/');
        }
        return string.Equals(normalizedLeft, normalizedRight,
            url ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);
    }
    private static bool SameOrigin(string? left, string? right) => Uri.TryCreate(left, UriKind.Absolute, out var a) && Uri.TryCreate(right, UriKind.Absolute, out var b) && a.Scheme.Equals(b.Scheme, StringComparison.OrdinalIgnoreCase) && a.Host.Equals(b.Host, StringComparison.OrdinalIgnoreCase) && a.Port == b.Port;
}
