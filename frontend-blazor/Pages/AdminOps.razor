    private static readonly HashSet<string> GroupAlertMetricTypes = new(["group_available_accounts", "group_available_ratio", "group_rate_limit_ratio"], StringComparer.OrdinalIgnoreCase);
    private static readonly HashSet<string> AllowedTimeRanges = new(["5m", "30m", "1h", "6h", "24h", "custom"], StringComparer.OrdinalIgnoreCase);
    private static readonly HashSet<string> AllowedQueryModes = new(["auto", "raw", "preagg"], StringComparer.OrdinalIgnoreCase);
    private static readonly string[] DashboardQueryKeys = ["tr", "platform", "group_id", "model", "account_id", "mode", "fullscreen", "open_error_details", "error_type", "alert_rule_id", "open_alert_rules"];
    private IReadOnlyList<OpsTrendRow> ThroughputRows => snapshot.ThroughputTrend.Points.Select(x => new OpsTrendRow(FormatBucket(x.BucketStart), x.Qps, x.Tps / 1000d)).ToList();
    private IReadOnlyList<OpsTrendRow> SwitchTrendRows => switchTrend.Points.Select(x => new OpsTrendRow(FormatBucket(x.BucketStart), x.RequestCount <= 0 ? 0 : x.SwitchCount * 100d / x.RequestCount, x.SwitchCount)).ToList();
    private IReadOnlyList<OpsTrendRow> ErrorTrendRows => snapshot.ErrorTrend.Points.Select(x => new OpsTrendRow(FormatBucket(x.BucketStart), x.ErrorCountSla, x.UpstreamErrorCountExcl429529)).ToList();
    private IReadOnlyList<ErrorDistributionRow> ErrorDistributionRows => BuildErrorDistributionRows(errorDistribution.Items);
    private IReadOnlyList<ConcurrencyRow> ConcurrencyRows => BuildConcurrencyRows();
    private IReadOnlyList<OpsLatencyBucketDto> DurationBuckets => latency.EffectiveDurationBuckets;
    private IReadOnlyList<OpsLatencyBucketDto> TtftBuckets => latency.EffectiveTtftBuckets;
    private long DurationBucketMax => MaxBucketCount(DurationBuckets);
    private long TtftBucketMax => MaxBucketCount(TtftBuckets);
    private string ConcurrencyDimensionLabel => showUserConcurrency ? "按用户" : accountId.HasValue ? "指定账号" : groupId.HasValue ? "按账号" : string.IsNullOrWhiteSpace(platform) ? "按平台" : "按分组";
    private string HealthScoreLabel => overview.RequestCountTotal == 0 ? "空闲" : overview.HealthScore.ToString();
    private string HealthStatus => overview.RequestCountTotal == 0 ? "空闲" : overview.HealthScore >= 90 ? "健康" : overview.HealthScore >= 60 ? "需关注" : "高风险";
    private string HealthTone => overview.RequestCountTotal == 0 ? "muted" : overview.HealthScore >= 90 ? "success" : overview.HealthScore >= 60 ? "warning" : "danger";
    private bool HasSlaSample => overview.RequestCountSla > 0;
    private string SlaValueLabel => HasSlaSample ? Percent(overview.Sla, 3) : "-";
    private string SlaTone => HasSlaSample ? ThresholdTone(overview.Sla * 100, thresholds.SlaPercentMin, lowerIsBad: true) : "muted";
    private string TtftTone => ThresholdTone(overview.Ttft.P99Ms, thresholds.TtftP99MsMax, false);
    private string RequestErrorTone => ThresholdTone(overview.ErrorRate * 100, thresholds.RequestErrorRatePercentMax, false);
    private string UpstreamErrorTone => ThresholdTone(overview.UpstreamErrorRate * 100, thresholds.UpstreamErrorRatePercentMax, false);
    private double SlaProgress => HasSlaSample ? Math.Clamp((overview.Sla * 100 - 90) * 10, 0, 100) : 0;
    private string GoroutineTone => (system?.GoroutineCount ?? 0) >= 8000 ? "danger" : (system?.GoroutineCount ?? 0) >= 2000 ? "warning" : "success";
    private int JobWarningCount => overview.JobHeartbeats.Count(x => !string.IsNullOrWhiteSpace(x.LastError));
    private string MemorySummary => system?.MemoryUsedMb is null || system.MemoryTotalMb is null ? "-" : $"{FormatMemory(system.MemoryUsedMb.Value)} / {FormatMemory(system.MemoryTotalMb.Value)}";
