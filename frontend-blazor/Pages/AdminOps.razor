    private (DateTimeOffset? Start, DateTimeOffset? End) ParseLogCustomBounds()
    {
        var start = DateTimeOffset.TryParse(logStartInput, out var parsedStart) ? parsedStart : (DateTimeOffset?)null;
        var end = DateTimeOffset.TryParse(logEndInput, out var parsedEnd) ? parsedEnd : (DateTimeOffset?)null;
        return (start, end);
    }

    private bool ValidateLogCustomBounds()
    {
        var hasStart = !string.IsNullOrWhiteSpace(logStartInput);
        var hasEnd = !string.IsNullOrWhiteSpace(logEndInput);
        if (hasStart != hasEnd)
        {
            Toasts.Error("开始时间和结束时间必须同时填写。");
            return false;
        }

        var bounds = ParseLogCustomBounds();
        if (hasStart && (!bounds.Start.HasValue || !bounds.End.HasValue || bounds.End <= bounds.Start))
        {
            Toasts.Error("日志结束时间必须晚于开始时间。");
            return false;
        }

        return true;
    }

    private (DateTimeOffset Start, DateTimeOffset End) EffectiveLogCleanupBounds()
    {
        var custom = ParseLogCustomBounds();
        if (custom.Start.HasValue && custom.End.HasValue) return (custom.Start.Value, custom.End.Value);

        var end = DateTimeOffset.Now;
        var duration = logTimeRange switch
        {
            "5m" => TimeSpan.FromMinutes(5),
            "30m" => TimeSpan.FromMinutes(30),
            "6h" => TimeSpan.FromHours(6),
            "24h" => TimeSpan.FromHours(24),
            "7d" => TimeSpan.FromDays(7),
            "30d" => TimeSpan.FromDays(30),
            _ => TimeSpan.FromHours(1)
        };
        return (end - duration, end);
    }

    private static long? ParsePositiveLong(string value) =>
        long.TryParse(value.Trim(), out var id) && id > 0 ? id : null;

    private static string? NullIfEmpty(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatSystemLogDetail(OpsSystemLogDto row)
    {
        var sections = new List<string>();
        if (!string.IsNullOrWhiteSpace(row.Message)) sections.Add(row.Message.Trim());

        var request = new List<string>();
        AddLogDetail(request, "status", ExtraText(row, "status_code"));
        AddLogDetail(request, "latency", ExtraText(row, "latency_ms"), "ms");
        AddLogDetail(request, "method", ExtraText(row, "method"));
        AddLogDetail(request, "path", ExtraText(row, "path"));
        AddLogDetail(request, "ip", ExtraText(row, "client_ip"));
        AddLogDetail(request, "protocol", ExtraText(row, "protocol"));
        if (request.Count > 0) sections.Add(string.Join(" · ", request));

        var correlation = new List<string>();
        AddLogDetail(correlation, "request_id", row.RequestId);
        AddLogDetail(correlation, "client_request_id", row.ClientRequestId);
        if (row.UserId.HasValue) correlation.Add($"user_id={row.UserId.Value}");
        if (row.ApiKeyId.HasValue) correlation.Add($"api_key_id={row.ApiKeyId.Value}");
        if (row.AccountId.HasValue) correlation.Add($"account_id={row.AccountId.Value}");
        AddLogDetail(correlation, "platform", row.Platform);
        AddLogDetail(correlation, "model", row.Model);
        if (correlation.Count > 0) sections.Add(string.Join(" · ", correlation));

        var errors = ExtraText(row, "errors");
        if (!string.IsNullOrWhiteSpace(errors)) sections.Add($"errors={errors}");
        var exception = ExtraText(row, "err");
        if (string.IsNullOrWhiteSpace(exception)) exception = ExtraText(row, "error");
        if (!string.IsNullOrWhiteSpace(exception)) sections.Add($"error={exception}");
        return sections.Count == 0 ? "-" : string.Join("  ", sections);
    }

    private static void AddLogDetail(List<string> target, string label, string? value, string suffix = "")
    {
        if (!string.IsNullOrWhiteSpace(value)) target.Add($"{label}={value.Trim()}{suffix}");
    }

    private static string ExtraText(OpsSystemLogDto row, string key)
    {
        if (row.Extra is null || !row.Extra.TryGetValue(key, out var value)) return string.Empty;
        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString()?.Trim() ?? string.Empty,
            JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False => value.ToString(),
            _ => string.Empty
        };
    }

