    private static IReadOnlyList<ErrorDistributionRow> BuildErrorDistributionRows(IEnumerable<OpsErrorDistributionItemDto> items)
    {
        long upstream = 0, client = 0, system = 0, other = 0;
        foreach (var item in items)
        {
            if (item.Sla <= 0) continue;
            if (item.StatusCode is 502 or 503 or 504) upstream += item.Sla;
            else if (item.StatusCode is >= 400 and < 500) client += item.Sla;
            else if (item.StatusCode == 500) system += item.Sla;
            else other += item.Sla;
        }

        return new[]
        {
            new ErrorDistributionRow("上游", upstream, "upstream"),
            new ErrorDistributionRow("客户端", client, "client"),
            new ErrorDistributionRow("系统", system, "system"),
            new ErrorDistributionRow("其他", other, "other")
        }.Where(row => row.Count > 0).ToList();
    }

