            }
            else if (settingsTab == "alerts")
            {
                <div class="settings-section"><h3>告警评估器</h3><div class="form-grid two"><label><span>评估间隔（秒）</span><input type="number" min="1" max="86400" @bind="runtimeAlert.EvaluationIntervalSeconds" /></label><label class="check-field"><input type="checkbox" @bind="emailConfig.Alert.Enabled" /><span>启用告警邮件</span></label><label class="span-two"><span>告警收件人（逗号分隔）</span><input value="@AlertRecipientsText" @onchange="SetAlertRecipients" placeholder="admin@example.com" /></label><label><span>最低级别</span><select @bind="emailConfig.Alert.MinSeverity"><option value="">全部级别</option><option value="critical">严重</option><option value="warning">警告</option><option value="info">信息</option></select></label><label><span>每小时限额</span><input type="number" min="0" @bind="emailConfig.Alert.RateLimitPerHour" /></label><label><span>批处理窗口（秒）</span><input type="number" min="0" @bind="emailConfig.Alert.BatchingWindowSeconds" /></label><label class="check-field"><input type="checkbox" @bind="emailConfig.Alert.IncludeResolvedAlerts" /><span>包含恢复通知</span></label></div></div>
