    private IReadOnlyList<DiagnosisRow> DiagnosisItems => BuildDiagnosis();
    private string CurrentRangeLabel => timeRange == "custom" && customStart.HasValue && customEnd.HasValue
        ? $"{customStart.Value.ToLocalTime():yyyy-MM-dd HH:mm} 至 {customEnd.Value.ToLocalTime():yyyy-MM-dd HH:mm}"
        : timeRange;
    private string SelectedErrorPayload => selectedErrorDetail is null ? string.Empty : ErrorPayload(selectedErrorDetail, errorDetailKind);
    private int TokenTotalPages => Math.Max(1, (int)Math.Ceiling(openAiStats.Total / (double)Math.Max(1, tokenPageSize)));
    private double? QuotaAutoPause5HPercent
    {
        get => advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold5H > 0 ? Math.Round(advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold5H * 1000) / 10 : null;
        set => advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold5H = value is > 0 ? value.Value / 100 : 0;
    }
    private double? QuotaAutoPause7DPercent
    {
        get => advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold7D > 0 ? Math.Round(advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold7D * 1000) / 10 : null;
        set => advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold7D = value is > 0 ? value.Value / 100 : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        try
        {
            var adminSettings = await Api.GetAdminSettingsTypedAsync();
            if (!adminSettings.OpsMonitoringEnabled)
            {
                Navigation.NavigateTo("/admin/settings", replace: true);
                return;
            }

            defaultQueryMode = AllowedQueryModes.Contains(adminSettings.OpsQueryModeDefault)
                ? adminSettings.OpsQueryModeDefault.ToLowerInvariant()
                : "auto";
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }

        ApplyLocationState();
        logPlatform = platform;
        await LoadInitialSettingsAsync();
        var groupsTask = SafeAsync(() => Api.GetAllAdminGroupsAsync(true), new List<GoGroup>());
        var accountsTask = SafeAsync(() => Api.GetAccountsAsync(), new List<AccountDto>());
        await Task.WhenAll(groupsTask, accountsTask);
        groups = await groupsTask;
        accounts = await accountsTask;
        if (accountId.HasValue && !accounts.Any(x => string.Equals(x.Id, accountId.Value.ToString(), StringComparison.Ordinal) && AccountMatchesCurrentFilters(x)))
        {
            accountId = null;
            SyncLocation();
        }
        await RefreshAllAsync();
        await ApplyDeepLinksAsync();
        StartAutoRefresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfReference = DotNetObjectReference.Create(this);
        try
        {
            escapeHandlerId = await JS.InvokeAsync<int>("paraGateway.registerEscapeHandler", selfReference);
        }
        catch (JSException)
        {
            selfReference.Dispose();
            selfReference = null;
        }
    }

    private async Task LoadInitialSettingsAsync()
    {
        try
        {
            var advancedTask = Api.GetAdminOpsAdvancedSettingsAsync();
            var thresholdsTask = Api.GetAdminOpsMetricThresholdsAsync();
            await Task.WhenAll(advancedTask, thresholdsTask);
            advanced = await advancedTask;
            advanced.OpenAiAccountQuotaAutoPause ??= new();
            thresholds = await thresholdsTask;
        }
        catch { advanced = new(); thresholds = new(); }
    }

    private async Task RefreshAllAsync()
    {
        var generation = ++loadGeneration;
        loading = true; error = null;
        try
        {
            snapshot = await Api.GetAdminOpsSnapshotAsync(timeRange, platform, groupId, queryMode, customStart, customEnd, model, accountId);
            if (generation != loadGeneration) return;
            var latencyTask = SafeAsync(() => Api.GetAdminOpsLatencyHistogramAsync(timeRange, platform, groupId, queryMode, customStart, customEnd, model, accountId), new OpsLatencyHistogramDto());
            var distributionTask = SafeAsync(() => Api.GetAdminOpsErrorDistributionAsync(timeRange, platform, groupId, queryMode, customStart, customEnd, model, accountId), new OpsErrorDistributionDto());
            var concurrencyTask = SafeAsync(() => Api.GetAdminOpsConcurrencyAsync(platform, groupId), new OpsConcurrencyStatsDto());
            var availabilityTask = SafeAsync(() => Api.GetAdminOpsAccountAvailabilityAsync(platform, groupId), new OpsAccountAvailabilityStatsDto());
            var realtimeTask = SafeAsync(() => Api.GetAdminOpsRealtimeTrafficAsync(realtimeWindow, platform, groupId, model, accountId), new OpsRealtimeTrafficResponseDto());
            var switchTrendEnd = DateTimeOffset.UtcNow;
            var switchTrendTask = SafeAsync(() => Api.GetAdminOpsThroughputTrendAsync("custom", platform, groupId, queryMode, switchTrendEnd.AddHours(-5), switchTrendEnd, model, accountId), new OpsThroughputTrendDto());
            var alertsTask = SafeAsync(() => Api.GetAdminOpsAlertEventsAsync(BuildAlertEventsQuery()), new List<OpsAlertEventDto>());
            var logHealthTask = SafeAsync(Api.GetAdminOpsSystemLogHealthAsync, new OpsSystemLogSinkHealthDto());
            var logsTask = SafeAsync(() => Api.GetAdminOpsSystemLogsAsync(BuildSystemLogQuery()), new PagedEnvelope<OpsSystemLogDto>());
            var tokenTask = advanced.DisplayOpenAiTokenStats ? SafeAsync(() => Api.GetAdminOpsOpenAiTokenStatsAsync(tokenTimeRange, platform, groupId, tokenPage, tokenPageSize, tokenViewMode == "topn" ? tokenTopN : null, model, accountId), new OpsOpenAiTokenStatsDto()) : Task.FromResult(new OpsOpenAiTokenStatsDto());
            await Task.WhenAll(latencyTask, distributionTask, concurrencyTask, availabilityTask, realtimeTask, switchTrendTask, alertsTask, logHealthTask, logsTask, tokenTask);
            if (generation != loadGeneration) return;
            latency = await latencyTask; errorDistribution = await distributionTask; concurrency = await concurrencyTask; availability = await availabilityTask;
            realtime = await realtimeTask; switchTrend = await switchTrendTask; alertEvents = await alertsTask; alertHasMore = alertEvents.Count == AlertEventPageSize; logHealth = await logHealthTask; logs = await logsTask; openAiStats = await tokenTask;
            lastUpdated = DateTimeOffset.Now; loadedOnce = true;
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { if (generation == loadGeneration) loading = false; }
    }

