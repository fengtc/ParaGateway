    private IEnumerable<AccountDto> FilteredAccounts => accounts.Where(AccountMatchesCurrentFilters)
        .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase);
    private static readonly string[] RealtimeWindows = ["1min", "5min", "30min", "1h"];
