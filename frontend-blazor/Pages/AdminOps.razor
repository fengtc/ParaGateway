    private bool customRangeOpen, jobsOpen, requestsOpen, errorsOpen, errorDetailOpen, errorDetailLoading, alertDetailOpen, alertDetailLoading, alertHistoryLoading, alertActionLoading, alertEventsLoading, alertLoadingMore, alertHasMore, alertRulesOpen, ruleEditorOpen, settingsOpen, logSettingsOpen;
    private bool syncingLocation, applyingLocation, disposed;
