    private void ApplyLocationState()
    {
        var values = ParseQueryValues(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        var requestedRange = values.GetValueOrDefault("tr");
        timeRange = !string.IsNullOrWhiteSpace(requestedRange) && AllowedTimeRanges.Contains(requestedRange)
            ? requestedRange.ToLowerInvariant()
            : "1h";
        platform = values.GetValueOrDefault("platform")?.Trim().ToLowerInvariant() ?? string.Empty;
        model = values.GetValueOrDefault("model")?.Trim() ?? string.Empty;
        groupId = long.TryParse(values.GetValueOrDefault("group_id"), out var parsedGroupId) && parsedGroupId > 0
            ? parsedGroupId
            : null;
        accountId = long.TryParse(values.GetValueOrDefault("account_id"), out var parsedAccountId) && parsedAccountId > 0
            ? parsedAccountId
            : null;

        var requestedMode = values.GetValueOrDefault("mode");
        queryMode = !string.IsNullOrWhiteSpace(requestedMode) && AllowedQueryModes.Contains(requestedMode)
            ? requestedMode.ToLowerInvariant()
            : defaultQueryMode;
        fullscreen = IsTrue(values.GetValueOrDefault("fullscreen"));

        if (timeRange == "custom")
        {
            if (!customStart.HasValue || !customEnd.HasValue || customEnd <= customStart)
            {
                customEnd = DateTimeOffset.Now;
                customStart = customEnd.Value.AddHours(-1);
                customStartInput = customStart.Value.ToString("yyyy-MM-ddTHH:mm");
                customEndInput = customEnd.Value.ToString("yyyy-MM-ddTHH:mm");
            }
        }
        else
        {
            customStart = customEnd = null;
        }

        if (fullscreen) CloseTransientPanels();
    }

    private async Task ApplyDeepLinksAsync()
    {
        if (fullscreen) return;
        var values = ParseQueryValues(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (IsTrue(values.GetValueOrDefault("open_error_details")))
        {
            await OpenErrorsAsync(string.Equals(values.GetValueOrDefault("error_type"), "upstream", StringComparison.OrdinalIgnoreCase)
                ? "upstream"
                : "request");
        }

        var openRules = IsTrue(values.GetValueOrDefault("open_alert_rules"));
        var hasRuleId = long.TryParse(values.GetValueOrDefault("alert_rule_id"), out var ruleId) && ruleId > 0;
        if (openRules || hasRuleId)
        {
            await OpenAlertRulesAsync();
            if (hasRuleId)
            {
                var rule = alertRules.FirstOrDefault(item => item.Id == ruleId);
                if (rule is not null) EditRule(rule);
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (disposed || syncingLocation || !IsOpsLocation(args.Location)) return;
        _ = InvokeAsync(HandleLocationChangedAsync);
    }

    private async Task HandleLocationChangedAsync()
    {
        if (disposed || applyingLocation) return;
        applyingLocation = true;
        try
        {
            var previous = (timeRange, platform, groupId, model, accountId, queryMode, fullscreen, customStart, customEnd);
            ApplyLocationState();
            var filtersChanged = previous.timeRange != timeRange || previous.platform != platform || previous.groupId != groupId ||
                                 previous.model != model || previous.accountId != accountId || previous.queryMode != queryMode || previous.customStart != customStart || previous.customEnd != customEnd;
            if (filtersChanged) await RefreshAllAsync();
            await ApplyDeepLinksAsync();
            StateHasChanged();
        }
        finally
        {
            applyingLocation = false;
        }
    }

    private void SyncLocation()
    {
        if (disposed || applyingLocation) return;
        var builder = new UriBuilder(Navigation.Uri);
        var values = ParseQueryValues(builder.Query);
        foreach (var key in DashboardQueryKeys) values.Remove(key);

        if (!string.Equals(timeRange, "1h", StringComparison.OrdinalIgnoreCase)) values["tr"] = timeRange;
        if (!string.IsNullOrWhiteSpace(platform)) values["platform"] = platform;
        if (groupId.HasValue && groupId.Value > 0) values["group_id"] = groupId.Value.ToString();
        if (!string.IsNullOrWhiteSpace(model)) values["model"] = model.Trim();
        if (accountId.HasValue && accountId.Value > 0) values["account_id"] = accountId.Value.ToString();
        if (!string.Equals(queryMode, "auto", StringComparison.OrdinalIgnoreCase)) values["mode"] = queryMode;
        if (fullscreen) values["fullscreen"] = "1";

        builder.Query = string.Join("&", values.Select(pair => $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(pair.Value)}"));
        var target = builder.Uri.ToString();
        if (string.Equals(target, Navigation.Uri, StringComparison.Ordinal)) return;

        syncingLocation = true;
        try { Navigation.NavigateTo(target, replace: true); }
        finally { syncingLocation = false; }
    }

    private bool IsOpsLocation(string location)
    {
        var relative = Navigation.ToBaseRelativePath(location);
        var separator = relative.IndexOfAny(['?', '#']);
        if (separator >= 0) relative = relative[..separator];
        return string.Equals(relative.Trim('/'), "admin/ops", StringComparison.OrdinalIgnoreCase);
    }

    private static Dictionary<string, string> ParseQueryValues(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(parts[0].Replace('+', ' '));
            if (string.IsNullOrWhiteSpace(key)) continue;
            values[key] = parts.Length == 1 ? string.Empty : Uri.UnescapeDataString(parts[1].Replace('+', ' '));
        }
        return values;
    }

