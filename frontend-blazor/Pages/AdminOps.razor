                <div class="settings-section"><h3>错误过滤</h3><div class="form-grid two"><label class="check-field"><input type="checkbox" @bind="advanced.IgnoreCountTokensErrors" /><span>忽略 count_tokens 错误</span></label><label class="check-field"><input type="checkbox" @bind="advanced.IgnoreContextCanceled" /><span>忽略客户端断连错误</span></label><label class="check-field"><input type="checkbox" @bind="advanced.IgnoreNoAvailableAccounts" /><span>忽略无可用账号错误</span></label><label class="check-field"><input type="checkbox" @bind="advanced.IgnoreInvalidApiKeyErrors" /><span>忽略无效 API Key 错误</span></label><label class="check-field"><input type="checkbox" @bind="advanced.IgnoreInsufficientBalanceErrors" /><span>忽略余额不足错误</span></label></div></div>
            }
            @if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger">@modalError</div> }
        }
    </ChildContent>
    <Footer><button type="button" class="secondary-button" @onclick="CloseSettings">取消</button><button type="button" class="primary-button" disabled="@(settingsLoading || saving)" @onclick="SaveSettingsAsync">保存设置</button></Footer>
</AppModal>

