    private static string Percent(double value, int decimals) => $"{(value <= 1 ? value * 100 : value).ToString($"F{decimals}")}%";
    private static string PercentValue(double? value) => value.HasValue ? $"{value.Value:0.0}%" : "-";
    private static string MsValue(int? value) => value.HasValue ? $"{value.Value} ms" : "-";
    private static string DurationValue(int? value) => value.HasValue ? $"{value.Value} ms" : "-";
    private static string FormatRate(double? value) => value?.ToString("0.0") ?? "0.0";
    private static string FormatNumber(long value) => value.ToString("N0");
    private static string FormatBucket(DateTimeOffset? value) => value?.ToLocalTime().ToString("HH:mm") ?? "-";
    private static string FormatDateTime(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
    private static string FormatMemory(double mb) => mb >= 1024 ? $"{mb / 1024:0.0} GB" : $"{mb:0} MB";
    private static string BoolLabel(bool? value) => value switch { true => "正常", false => "异常", _ => "未知" };
    private static long MaxBucketCount(IEnumerable<OpsLatencyBucketDto>? buckets) => buckets?.Select(x => Math.Max(0, x?.Count ?? 0)).DefaultIfEmpty(0).Max() ?? 0;
    private static double BarWidth(long value, long max) => value <= 0 || max <= 0 ? 0 : Math.Clamp(value * 100d / max, 2, 100);
    private static string BucketPercent(long value, long total) => total <= 0 ? "0.0%" : $"{value * 100d / total:0.0}%";
    private static string ResourceTone(double? value, double warning, double danger) => value >= danger ? "danger" : value >= warning ? "warning" : "success";
    private static string LoadTone(double value) => value >= 90 ? "danger" : value >= 70 ? "warning" : "success";
    private static string ThresholdTone(double? value, double? threshold, bool lowerIsBad) { if (!value.HasValue || !threshold.HasValue) return "success"; var critical = lowerIsBad ? value.Value < threshold.Value : value.Value >= threshold.Value; if (critical) return "danger"; var warning = lowerIsBad ? value.Value < threshold.Value + .1 : value.Value >= threshold.Value * .8; return warning ? "warning" : "success"; }
    private static string SeverityTone(string value) => value.ToUpperInvariant() switch { "P0" or "CRITICAL" => "danger", "P1" or "WARNING" => "warning", _ => "info" };
    private static string LogLevelTone(string value) => value.ToLowerInvariant() switch { "error" or "fatal" => "danger", "warn" or "warning" => "warning", "debug" => "muted", _ => "info" };
    private static string AlertStatus(string value) => value switch { "firing" => "告警中", "resolved" => "已恢复", "manual_resolved" => "手动解决", _ => value };
    private static string AlertStatusTone(string value) => value switch { "firing" => "danger", "resolved" => "success", "manual_resolved" => "muted", _ => "info" };

    private static string AlertDimensionText(OpsAlertEventDto? item, string key)
    {
        if (item?.Dimensions is null || !item.Dimensions.TryGetValue(key, out var value)) return string.Empty;
        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString()?.Trim() ?? string.Empty,
            JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False => value.ToString(),
            _ => string.Empty
        };
    }

    private static long? AlertDimensionLong(OpsAlertEventDto? item, string key)
    {
        if (item?.Dimensions is null || !item.Dimensions.TryGetValue(key, out var value)) return null;
        if (value.ValueKind == JsonValueKind.Number && value.TryGetInt64(out var numeric)) return numeric;
        return value.ValueKind == JsonValueKind.String && long.TryParse(value.GetString(), out numeric) ? numeric : null;
    }

    private static string AlertDimensionsSummary(OpsAlertEventDto item)
    {
        var parts = new List<string>();
        var itemPlatform = AlertDimensionText(item, "platform");
        var itemRegion = AlertDimensionText(item, "region");
        var itemGroupId = AlertDimensionLong(item, "group_id");
        if (!string.IsNullOrWhiteSpace(itemPlatform)) parts.Add($"platform={itemPlatform}");
        if (itemGroupId.HasValue) parts.Add($"group_id={itemGroupId.Value}");
        if (!string.IsNullOrWhiteSpace(itemRegion)) parts.Add($"region={itemRegion}");
        return parts.Count == 0 ? "-" : string.Join(" · ", parts);
    }

    private static string AlertDurationLabel(OpsAlertEventDto item)
    {
        var firedAt = item.FiredAt ?? item.CreatedAt;
        if (!firedAt.HasValue) return "-";
        var end = item.ResolvedAt ?? DateTimeOffset.Now;
        var prefix = item.ResolvedAt.HasValue ? AlertStatus(item.Status) : "告警中";
        return $"{prefix} {FormatAlertDuration(end - firedAt.Value)}";
    }

    private static string FormatAlertDuration(TimeSpan value)
    {
        if (value < TimeSpan.Zero) value = TimeSpan.Zero;
        if (value.TotalMinutes < 1) return $"{(int)value.TotalSeconds}s";
        if (value.TotalHours < 1) return $"{(int)value.TotalMinutes}m";
        if (value.TotalDays < 1) return $"{(int)value.TotalHours}h";
        return $"{(int)value.TotalDays}d";
    }
    private static string Correlation(OpsSystemLogDto row) { var parts = new List<string>(); if (!string.IsNullOrWhiteSpace(row.RequestId)) parts.Add($"req={row.RequestId}"); if (row.UserId.HasValue) parts.Add($"user={row.UserId}"); if (row.AccountId.HasValue) parts.Add($"acc={row.AccountId}"); if (!string.IsNullOrWhiteSpace(row.Platform)) parts.Add(row.Platform); if (!string.IsNullOrWhiteSpace(row.Model)) parts.Add(row.Model); return parts.Count == 0 ? "-" : string.Join(" · ", parts); }
    private static string ErrorPayload(OpsErrorDetailDto detail, string kind)
    {
        var values = string.Equals(kind, "upstream", StringComparison.OrdinalIgnoreCase)
            ? new[] { detail.UpstreamErrorDetail, detail.UpstreamErrorMessage, detail.UpstreamErrors, detail.ErrorBody, detail.Message }
            : new[] { detail.ErrorBody, detail.Message, detail.UpstreamErrorDetail, detail.UpstreamErrorMessage };
        return values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;
    }

