            @if (settingsTab == "general")
            {
                <div class="settings-section"><h3>数据采集</h3><div class="form-grid two"><label><span>评估间隔（秒）</span><input type="number" min="1" max="86400" @bind="runtimeAlert.EvaluationIntervalSeconds" /></label><label><span>自动刷新间隔</span><select @bind="advanced.AutoRefreshIntervalSeconds"><option value="15">15 秒</option><option value="30">30 秒</option><option value="60">60 秒</option></select></label><label class="check-field"><input type="checkbox" @bind="advanced.AutoRefreshEnabled" /><span>启用自动刷新</span></label><label class="check-field"><input type="checkbox" @bind="advanced.DisplayAlertEvents" /><span>展示告警事件</span></label><label class="check-field"><input type="checkbox" @bind="advanced.DisplayOpenAiTokenStats" /><span>展示 OpenAI Token 请求统计</span></label></div></div>
