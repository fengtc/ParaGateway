    private IReadOnlyList<DiagnosisRow> BuildDiagnosis()
    {
        var result = new List<DiagnosisRow>();
        if (overview.RequestCountTotal == 0) result.Add(new("info", "系统处于空闲状态", "当前时间窗口没有请求，健康评分不参与风险判断。"));
        if (system?.DbOk == false) result.Add(new("danger", "数据库连接异常", "请求与调度可能受到影响，请检查数据库连接。"));
        if (system?.RedisOk == false) result.Add(new("warning", "Redis 连接异常", "缓存和实时并发信息可能不完整。"));
        if ((system?.CpuUsagePercent ?? 0) >= 80) result.Add(new((system?.CpuUsagePercent ?? 0) >= 95 ? "danger" : "warning", "CPU 使用率偏高", $"当前 CPU 使用率 {system?.CpuUsagePercent:0.0}%。"));
        if ((system?.MemoryUsagePercent ?? 0) >= 85) result.Add(new((system?.MemoryUsagePercent ?? 0) >= 95 ? "danger" : "warning", "内存使用率偏高", $"当前内存使用率 {system?.MemoryUsagePercent:0.0}%。"));
        if (overview.UpstreamErrorRate * 100 >= 2) result.Add(new(overview.UpstreamErrorRate * 100 >= 5 ? "danger" : "warning", "上游错误率升高", $"当前上游错误率 {overview.UpstreamErrorRate * 100:0.00}%。"));
        if (result.Count == 0) result.Add(new("success", "未发现明显异常", "核心指标均处于正常范围。"));
        return result;
    }

