    private async Task LoadMoreAlertsAsync()
    {
        if (!alertHasMore || alertLoadingMore || alertEvents.Count == 0) return;
        var last = alertEvents[^1];
        var before = last.FiredAt ?? last.CreatedAt;
        if (!before.HasValue) { alertHasMore = false; return; }
        alertLoadingMore = true;
        try
        {
            var more = await Api.GetAdminOpsAlertEventsAsync(BuildAlertEventsQuery(before, last.Id));
            alertEvents.AddRange(more.Where(item => alertEvents.All(existing => existing.Id != item.Id)));
            alertHasMore = more.Count == AlertEventPageSize;
        }
        catch (ApiException ex) { error = ex.Message; alertHasMore = false; }
        finally { alertLoadingMore = false; }
    }

