    private string? ValidateSettings()
    {
        if (runtimeAlert.EvaluationIntervalSeconds is < 1 or > 86400) return "评估间隔必须在 1 到 86400 秒之间。";
        if ((thresholds.SlaPercentMin ?? 0) is < 0 or > 100) return "SLA 最低百分比必须在 0 到 100 之间。";
        if ((thresholds.TtftP99MsMax ?? 0) < 0) return "TTFT P99 最大值不能小于 0。";
        if ((thresholds.RequestErrorRatePercentMax ?? 0) is < 0 or > 100 || (thresholds.UpstreamErrorRatePercentMax ?? 0) is < 0 or > 100) return "错误率阈值必须在 0 到 100 之间。";
        if (advanced.DataRetention.ErrorLogRetentionDays is < 0 or > 365 || advanced.DataRetention.MinuteMetricsRetentionDays is < 0 or > 365 || advanced.DataRetention.HourlyMetricsRetentionDays is < 0 or > 365) return "数据保留天数必须在 0 到 365 之间。";
        if (advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold5H is < 0 or > 1 || advanced.OpenAiAccountQuotaAutoPause.DefaultThreshold7D is < 0 or > 1) return "OpenAI 配额自动暂停阈值必须在 0 到 100% 之间。";
        if (emailConfig.Report.DailySummaryEnabled && string.IsNullOrWhiteSpace(emailConfig.Report.DailySummarySchedule)) return "启用每日汇总时必须填写 Cron 计划。";
        if (emailConfig.Report.WeeklySummaryEnabled && string.IsNullOrWhiteSpace(emailConfig.Report.WeeklySummarySchedule)) return "启用每周汇总时必须填写 Cron 计划。";
        return null;
    }
