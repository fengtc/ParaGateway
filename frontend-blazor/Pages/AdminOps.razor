@page "/admin/ops"
@implements IAsyncDisposable
@using ParaGateway.Frontend.Models
@inject ApiClient Api
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>运维监控 · ParaGateway</PageTitle>

<div class="ops-dashboard @(fullscreen ? "ops-fullscreen" : null)">
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="inline-alert danger ops-alert" role="alert"><Icon Name="alert" Size="17" /><span>@error</span></div>
    }

    @if (loading && !loadedOnce)
    {
        <LoadingState Text="正在载入运维监控数据" />
    }
    else
    {
        <section class="ops-hero-card">
            <div class="ops-toolbar">
                <div class="ops-title-block">
                    <h2><Icon Name="activity" Size="22" />运维监控</h2>
                    <div class="ops-ready-line">
                        <span class="status-dot @(loading ? "loading" : "ready")"></span>
                        <span>@(loading ? "加载中..." : "就绪")</span>
                        <span>·</span>
                        <span>刷新：@(lastUpdated?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "未知")</span>
                        @if (advanced.AutoRefreshEnabled)
                        {
                            <span>·</span><span>自动刷新：@autoRefreshCountdown 秒</span>
                        }
                    </div>
                </div>
                <div class="ops-toolbar-actions">
                    @if (!fullscreen)
                    {
                        <select value="@platform" @onchange="PlatformChangedAsync" aria-label="平台">
                            <option value="">全部平台</option><option value="openai">OpenAI</option><option value="anthropic">Anthropic</option><option value="gemini">Gemini</option><option value="antigravity">Antigravity</option><option value="grok">Grok</option>
                        </select>
                        <select value="@GroupFilterValue" @onchange="GroupChangedAsync" aria-label="分组">
                            <option value="">全部分组</option>
                            @foreach (var group in FilteredGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                        <input class="ops-model-filter" value="@model" @onchange="ModelChangedAsync" placeholder="模型（精确匹配）" aria-label="模型" />
                        <select value="@AccountFilterValue" @onchange="AccountChangedAsync" aria-label="账号">
                            <option value="">全部账号</option>
                            @foreach (var account in FilteredAccounts)
                            {
                                <option value="@account.Id">@account.Name</option>
                            }
                        </select>
                        <select value="@timeRange" @onchange="TimeRangeChangedAsync" aria-label="时间范围">
                            <option value="5m">5 分钟</option><option value="30m">30 分钟</option><option value="1h">1 小时</option><option value="6h">6 小时</option><option value="24h">24 小时</option><option value="custom">自定义</option>
                        </select>
                    }
                    <button type="button" class="icon-button" title="刷新" aria-label="刷新" disabled="@loading" @onclick="RefreshAllAsync"><Icon Name="refresh" Size="16" /></button>
                    @if (!fullscreen)
                    {
                        <button type="button" class="ops-action blue" @onclick="OpenAlertRulesAsync"><Icon Name="bell" Size="15" />预警规则</button>
                        <button type="button" class="ops-action" @onclick="OpenSettingsAsync"><Icon Name="settings" Size="15" />设置</button>
                        <button type="button" class="icon-button" title="全屏" aria-label="全屏" @onclick="ToggleFullscreen"><Icon Name="grid" Size="16" /></button>
                    }
                    else
                    {
                        <button type="button" class="ops-action" @onclick="ToggleFullscreen">退出全屏</button>
                    }
                </div>
            </div>

            <div class="ops-overview-grid">
                <div class="health-realtime-panel">
                    <button type="button" class="health-score" title="系统健康评分综合考虑 SLA、错误率与资源使用情况" @onclick="ToggleDiagnosis">
                        <span class="health-ring" style="--health-score:@Math.Clamp(overview.HealthScore, 0, 100)"><strong>@HealthScoreLabel</strong><small>健康评分</small></span>
                        <span class="health-caption">健康状况</span>
                        <b class="@HealthTone">@HealthStatus</b>
                    </button>
                    <div class="realtime-panel">
                        <div class="realtime-heading"><span><i></i>实时信息</span><div class="window-tabs">@foreach (var option in RealtimeWindows) { <button type="button" class="@(realtimeWindow == option ? "active" : null)" @onclick="() => ChangeRealtimeWindowAsync(option)">@option</button> }</div></div>
                        <span class="metric-kicker">当前</span>
                        <div class="realtime-values"><strong>@FormatRate(realtime.Summary?.Qps.Current) <small>QPS</small></strong><strong>@FormatRate(realtime.Summary?.Tps.Current) <small>TPS</small></strong></div>
                        <div class="realtime-secondary"><span><small>峰值</small><b>@FormatRate(realtime.Summary?.Qps.Peak) QPS</b><b>@FormatRate(realtime.Summary?.Tps.Peak) TPS</b></span><span><small>平均</small><b>@FormatRate(realtime.Summary?.Qps.Avg) QPS</b><b>@FormatRate(realtime.Summary?.Tps.Avg) TPS</b></span></div>
                        <div class="heartbeat-line"><span></span></div>
                    </div>
                </div>

                <div class="ops-metric-grid">
                    <article class="ops-metric-card"><header><span>请求</span><button type="button" @onclick='() => OpenRequestsAsync("all")'>详情</button></header><dl><div><dt>请求数</dt><dd>@FormatNumber(overview.RequestCountTotal)</dd></div><div><dt>Tokens</dt><dd>@FormatNumber(overview.TokenConsumed)</dd></div><div><dt>平均 QPS</dt><dd>@overview.Qps.Avg.ToString("0.0")</dd></div><div><dt>平均 TPS</dt><dd>@overview.Tps.Avg.ToString("0.0")</dd></div></dl></article>
                    <article class="ops-metric-card"><header><span>SLA</span><button type="button" @onclick='() => OpenRequestsAsync("error")'>详情</button></header><strong class="metric-main @SlaTone">@SlaValueLabel</strong><div class="meter"><i class="@SlaTone" style="width:@SlaProgress%"></i></div><p>异常 <b>@FormatNumber(Math.Max(0, overview.RequestCountSla - overview.SuccessCount))</b></p></article>
                    <article class="ops-metric-card"><header><span>请求错误</span><button type="button" @onclick='() => OpenErrorsAsync("request")'>详情</button></header><strong class="metric-main @RequestErrorTone">@Percent(overview.ErrorRate, 2)</strong><p>错误数 <b>@FormatNumber(overview.ErrorCountSla)</b></p><p>业务限制 <b>@FormatNumber(overview.BusinessLimitedCount)</b></p></article>
                    <article class="ops-metric-card"><header><span>请求时长</span><button type="button" @onclick='() => OpenRequestsAsync("all", "duration_desc")'>详情</button></header><strong class="metric-main">@(overview.Duration.P99Ms?.ToString() ?? "-") <small>ms (P99)</small></strong><div class="percentile-grid"><span>P95 <b>@MsValue(overview.Duration.P95Ms)</b></span><span>P90 <b>@MsValue(overview.Duration.P90Ms)</b></span><span>P50 <b>@MsValue(overview.Duration.P50Ms)</b></span><span>Avg <b>@MsValue(overview.Duration.AvgMs)</b></span></div></article>
                    <article class="ops-metric-card"><header><span>TTFT</span><button type="button" @onclick='() => OpenRequestsAsync("all", "first_token_desc")'>详情</button></header><strong class="metric-main @TtftTone">@(overview.Ttft.P99Ms?.ToString() ?? "-") <small>ms (P99)</small></strong><div class="percentile-grid"><span>P95 <b>@MsValue(overview.Ttft.P95Ms)</b></span><span>P90 <b>@MsValue(overview.Ttft.P90Ms)</b></span><span>P50 <b>@MsValue(overview.Ttft.P50Ms)</b></span><span>Avg <b>@MsValue(overview.Ttft.AvgMs)</b></span></div></article>
                    <article class="ops-metric-card"><header><span>上游错误</span><button type="button" @onclick='() => OpenErrorsAsync("upstream")'>详情</button></header><strong class="metric-main @UpstreamErrorTone">@Percent(overview.UpstreamErrorRate, 2)</strong><p>错误数（排除 429/529） <b>@FormatNumber(overview.UpstreamErrorCountExcl429529)</b></p><p>429 / 529 <b>@FormatNumber(overview.Upstream429Count + overview.Upstream529Count)</b></p></article>
                </div>
            </div>

            @if (diagnosisOpen)
            {
                <div class="diagnosis-panel"><h3><Icon Name="pulse" Size="17" />智能诊断</h3>@foreach (var item in DiagnosisItems) { <div class="diagnosis-item @item.Tone"><Icon Name="@(item.Tone == "danger" ? "alert" : "info")" Size="15" /><span><b>@item.Title</b><small>@item.Description</small></span></div> }</div>
            }

            <div class="resource-grid">
                <article><span>CPU</span><strong class="@ResourceTone(system?.CpuUsagePercent, 80, 95)">@PercentValue(system?.CpuUsagePercent)</strong><small>警告 80% · 严重 95%</small></article>
                <article><span>内存</span><strong class="@ResourceTone(system?.MemoryUsagePercent, 85, 95)">@PercentValue(system?.MemoryUsagePercent)</strong><small>@MemorySummary</small></article>
                <article><span>数据库</span><strong class="@(system?.DbOk == false ? "danger" : "success")">@BoolLabel(system?.DbOk)</strong><small>连接 @(system?.DbConnActive ?? 0) 活跃 · @(system?.DbConnIdle ?? 0) 空闲</small></article>
                <article><span>Redis</span><strong class="@(system?.RedisOk == false ? "danger" : "success")">@BoolLabel(system?.RedisOk)</strong><small>连接 @(system?.RedisConnTotal?.ToString() ?? "-") / @(system?.RedisPoolSize?.ToString() ?? "-")</small></article>
                <article><span>Goroutines</span><strong class="@GoroutineTone">@(system?.GoroutineCount?.ToString() ?? "-")</strong><small>队列 @(system?.ConcurrencyQueueDepth?.ToString() ?? "-")</small></article>
                <article><header><span>后台任务</span><button type="button" @onclick="() => jobsOpen = true">详情</button></header><strong class="@(JobWarningCount > 0 ? "warning" : "success")">@(JobWarningCount > 0 ? "需关注" : "正常")</strong><small>共 @overview.JobHeartbeats.Count · 警告 @JobWarningCount</small></article>
            </div>
        </section>

        <div class="ops-analysis-row">
            <section class="ops-card concurrency-card">
                <header class="card-header"><div><h3>并发 / 排队</h3><p>@ConcurrencyDimensionLabel · 共 @ConcurrencyRows.Count 项</p></div><button type="button" class="text-button" @onclick="ToggleConcurrencyModeAsync">@(showUserConcurrency ? "切换回平台视图" : "切换到用户视图")</button></header>
                @if (!concurrency.Enabled && !showUserConcurrency) { <EmptyState Title="实时监控已关闭" Description="请在系统设置中启用实时运维监控。" /> }
                else if (ConcurrencyRows.Count == 0) { <EmptyState Title="暂无数据" Description="当前筛选条件下没有并发记录。" /> }
                else { <div class="compact-list">@foreach (var row in ConcurrencyRows.Take(8)) { <div class="concurrency-row"><span><b>@row.Name</b><small>@row.Subtitle</small></span><div><span>@row.Used / @row.Capacity</span><i><em class="@LoadTone(row.Load)" style="width:@Math.Clamp(row.Load, 0, 100)%"></em></i></div><small>排队 @row.Queued</small></div> }</div> }
            </section>
            <section class="ops-card switch-card">
                <header class="card-header"><div><h3>账号切换率趋势</h3><p>近 5 小时账号切换次数 / 请求总数</p></div></header>
                @if (SwitchTrendRows.Count == 0) { <EmptyState Title="暂无切换数据" Description="当前时间窗口内没有账号切换记录。" /> }
                else
                {
                    <DxChart Data="@SwitchTrendRows" Width="100%" Height="255px">
                        <DxChartLineSeries T="OpsTrendRow" TArgument="string" TValue="double"
                                           Name="切换率 (%)" Color="@(System.Drawing.Color.FromArgb(11, 118, 206))"
                                           ArgumentField="p => p.Time" ValueField="p => p.Primary" />
                        <DxChartLegend Visible="false" />
                        <DxChartTooltip Enabled="true" />
                    </DxChart>
                }
            </section>
            <section class="ops-card throughput-card">
                <header class="card-header"><div><h3>吞吐趋势</h3><p>QPS 与 TPS/1K 趋势</p></div><button type="button" class="text-button" @onclick='() => OpenRequestsAsync("all")'>查看明细</button></header>
                @if (snapshot.ThroughputTrend.TopGroups.Count > 0)
                {
                    <div class="ops-breakdown-chips">
                        @foreach (var item in snapshot.ThroughputTrend.TopGroups)
                        {
                            <button type="button" @onclick="() => SelectBreakdownGroupAsync(item.GroupId)"><span>@(string.IsNullOrWhiteSpace(item.GroupName) ? $"#{item.GroupId}" : item.GroupName)</span><b>@FormatNumber(item.RequestCount)</b></button>
                        }
                    </div>
                }
                else if (snapshot.ThroughputTrend.ByPlatform.Count > 0)
                {
                    <div class="ops-breakdown-chips">
                        @foreach (var item in snapshot.ThroughputTrend.ByPlatform)
                        {
                            <button type="button" @onclick="() => SelectBreakdownPlatformAsync(item.Platform)"><span>@item.Platform.ToUpperInvariant()</span><b>@FormatNumber(item.RequestCount)</b></button>
                        }
                    </div>
                }
                @if (ThroughputRows.Count == 0) { <EmptyState Title="该时间窗口内暂无请求" Description="暂无可展示的吞吐数据。" /> }
                else
                {
                    <div class="ops-chart-layout">
                        <div class="ops-chart-legend" aria-label="吞吐趋势图例">
                            <span><i class="qps"></i>QPS</span>
                            <span><i class="tps"></i>TPS/1K</span>
                        </div>
                        <DxChart Data="@ThroughputRows" Width="100%" Height="255px">
                            <DxChartLineSeries T="OpsTrendRow" TArgument="string" TValue="double"
                                               Name="QPS" Color="@(System.Drawing.Color.FromArgb(11, 118, 206))"
                                               ArgumentField="p => p.Time" ValueField="p => p.Primary" />
                            <DxChartLineSeries T="OpsTrendRow" TArgument="string" TValue="double"
                                               Name="TPS/1K" Color="@(System.Drawing.Color.FromArgb(22, 136, 61))"
                                               ArgumentField="p => p.Time" ValueField="p => p.Secondary" />
                            <DxChartLegend Visible="false" />
                            <DxChartTooltip Enabled="true" />
                        </DxChart>
                    </div>
                }
            </section>
        </div>

        <div class="ops-chart-grid">
            <section class="ops-card latency-card">
                <header class="card-header"><div><h3>请求时长分布</h3><p>完整响应耗时与首 Token 延迟分别统计（成功请求）</p></div></header>
                <div class="latency-distributions">
                    <section class="latency-distribution">
                        <div class="latency-distribution-heading"><h4>完整响应耗时（E2E）</h4><span>@FormatNumber(latency.EffectiveDurationTotalRequests) 个样本</span></div>
                        @if (latency.EffectiveDurationTotalRequests <= 0 || DurationBucketMax <= 0)
                        {
                            <EmptyState Title="暂无 E2E 数据" Description="当前时间窗口内没有完整响应耗时记录。" />
                        }
                        else
                        {
                            <div class="bar-list latency-bars">@foreach (var bucket in DurationBuckets) { <div><span>@bucket.Range</span><i><em style="width:@BarWidth(bucket.Count, DurationBucketMax)%"></em></i><b>@bucket.Count</b><small>@BucketPercent(bucket.Count, latency.EffectiveDurationTotalRequests)</small></div> }</div>
                        }
                    </section>
                    <section class="latency-distribution">
                        <div class="latency-distribution-heading"><h4>首 Token 延迟（TTFT）</h4><span>@FormatNumber(latency.TtftTotalRequests) 个样本</span></div>
                        @if (latency.TtftTotalRequests <= 0 || TtftBucketMax <= 0)
                        {
                            <EmptyState Title="暂无 TTFT 数据" Description="当前时间窗口内没有首 Token 延迟记录。" />
                        }
                        else
                        {
                            <div class="bar-list latency-bars">@foreach (var bucket in TtftBuckets) { <div><span>@bucket.Range</span><i><em class="ttft-bar" style="width:@BarWidth(bucket.Count, TtftBucketMax)%"></em></i><b>@bucket.Count</b><small>@BucketPercent(bucket.Count, latency.TtftTotalRequests)</small></div> }</div>
                        }
                    </section>
                </div>
            </section>
            <section class="ops-card"><header class="card-header"><div><h3>错误分布</h3><p>按错误来源归类，排除业务限制</p></div><button type="button" class="text-button" @onclick='() => OpenErrorsAsync("request")'>查看明细</button></header>@if (ErrorDistributionRows.Count == 0) { <EmptyState Title="该时间窗口内暂无错误" Description="暂无错误分类分布。" /> } else { <div class="bar-list error-bars">@foreach (var item in ErrorDistributionRows) { <div><span>@item.Label</span><i><em class="@item.Tone" style="width:@BarWidth(item.Count, ErrorDistributionRows.Max(x => x.Count))%"></em></i><b>@item.Count</b></div> }</div> }</section>
            <section class="ops-card">
                <header class="card-header"><div><h3>错误趋势</h3><p>请求错误与上游错误趋势</p></div><button type="button" class="text-button" @onclick='() => OpenErrorsAsync("upstream")'>查看明细</button></header>
                @if (ErrorTrendRows.Count == 0)
                {
                    <EmptyState Title="该时间窗口内暂无错误" Description="暂无错误趋势。" />
                }
                else
                {
                    <div class="ops-chart-layout">
                        <div class="ops-chart-legend" aria-label="错误趋势图例">
                            <span><i class="request-error"></i>请求错误</span>
                            <span><i class="upstream-error"></i>上游错误</span>
                        </div>
                        <DxChart Data="@ErrorTrendRows" Width="100%" Height="250px">
                            <DxChartLineSeries T="OpsTrendRow" TArgument="string" TValue="double"
                                               Name="请求错误" Color="@(System.Drawing.Color.FromArgb(228, 17, 47))"
                                               ArgumentField="p => p.Time" ValueField="p => p.Primary" />
                            <DxChartLineSeries T="OpsTrendRow" TArgument="string" TValue="double"
                                               Name="上游错误" Color="@(System.Drawing.Color.FromArgb(255, 152, 0))"
                                               ArgumentField="p => p.Time" ValueField="p => p.Secondary" />
                            <DxChartLegend Visible="false" />
                            <DxChartTooltip Enabled="true" />
                        </DxChart>
                    </div>
                }
            </section>
        </div>

        @if (advanced.DisplayOpenAiTokenStats)
        {
            <section class="ops-card ops-table-card token-stats-card">
                <header class="card-header">
                    <div><h3>OpenAI Token 请求统计</h3><p>按模型统计输出速度、首 Token 延迟与请求耗时</p></div>
                    <div class="card-controls">
                        <select value="@tokenTimeRange" @onchange="TokenTimeRangeChangedAsync" aria-label="Token 统计时间范围"><option value="30m">30m</option><option value="1h">1h</option><option value="1d">1d</option><option value="15d">15d</option><option value="30d">30d</option></select>
                        <select value="@tokenViewMode" @onchange="TokenViewModeChangedAsync" aria-label="Token 统计视图"><option value="topn">Top N</option><option value="pagination">分页</option></select>
                        @if (tokenViewMode == "topn")
                        {
                            <select value="@tokenTopN" @onchange="TokenTopNChangedAsync" aria-label="Token 统计 Top N"><option value="10">Top 10</option><option value="20">Top 20</option><option value="50">Top 50</option><option value="100">Top 100</option></select>
                        }
                        else
                        {
                            <select value="@tokenPageSize" @onchange="TokenPageSizeChangedAsync" aria-label="Token 统计每页条数"><option value="10">10 / 页</option><option value="20">20 / 页</option><option value="50">50 / 页</option><option value="100">100 / 页</option></select>
                        }
                        <button type="button" class="secondary-button" @onclick="LoadTokenStatsAsync">刷新</button>
                    </div>
                </header>
                <div class="table-scroll"><table class="ops-table"><thead><tr><th>模型</th><th>请求数</th><th>含首 Token 请求</th><th>平均 Tokens/s</th><th>平均首 Token</th><th>输出 Tokens</th><th>平均耗时</th></tr></thead><tbody>@if (openAiStats.Items.Count == 0) { <tr><td colspan="7" class="empty-cell">暂无数据</td></tr> } else { @foreach (var row in openAiStats.Items) { <tr><td><b>@row.Model</b></td><td>@row.RequestCount</td><td>@row.RequestsWithFirstToken</td><td>@(row.AverageTokensPerSecond?.ToString("0.##") ?? "-")</td><td>@(row.AverageFirstTokenMs?.ToString("0") ?? "-") ms</td><td>@FormatNumber(row.TotalOutputTokens)</td><td>@row.AverageDurationMs.ToString("0") ms</td></tr> } }</tbody></table></div>
                @if (tokenViewMode == "pagination")
                {
                    <div class="ops-pagination"><span>共 @openAiStats.Total 个模型</span><div><button type="button" disabled="@(tokenPage <= 1)" @onclick="() => ChangeTokenPageAsync(tokenPage - 1)">上一页</button><span>@tokenPage / @TokenTotalPages</span><button type="button" disabled="@(tokenPage >= TokenTotalPages)" @onclick="() => ChangeTokenPageAsync(tokenPage + 1)">下一页</button></div></div>
                }
            </section>
        }

        @if (advanced.DisplayAlertEvents)
        {
            <section class="ops-card ops-table-card alert-events-card">
                <header class="card-header"><div><h3>告警事件</h3><p>最近触发的系统告警</p></div><button type="button" class="text-button" @onclick="OpenAlertRulesAsync">管理规则</button></header>
                <div class="alert-event-filters">
                    <select value="@alertTimeRange" @onchange="AlertTimeRangeChangedAsync" aria-label="告警时间范围"><option value="5m">5m</option><option value="30m">30m</option><option value="1h">1h</option><option value="6h">6h</option><option value="24h">24h</option><option value="7d">7d</option><option value="30d">30d</option></select>
                    <select value="@alertSeverity" @onchange="AlertSeverityChangedAsync" aria-label="告警级别"><option value="">全部级别</option><option value="P0">P0</option><option value="P1">P1</option><option value="P2">P2</option><option value="P3">P3</option></select>
                    <select value="@alertStatusFilter" @onchange="AlertStatusChangedAsync" aria-label="告警状态"><option value="">全部状态</option><option value="firing">告警中</option><option value="resolved">已恢复</option><option value="manual_resolved">手动解决</option></select>
                    <select value="@alertEmailSent" @onchange="AlertEmailChangedAsync" aria-label="告警邮件状态"><option value="">全部邮件状态</option><option value="true">已发送邮件</option><option value="false">未发送邮件</option></select>
                    <button type="button" class="secondary-button" disabled="@alertEventsLoading" @onclick="LoadAlertEventsAsync">刷新</button>
                </div>
                <div class="table-scroll"><table class="ops-table"><thead><tr><th>时间</th><th>级别 / 状态</th><th>平台</th><th>规则</th><th>告警</th><th>持续时间</th><th>维度</th><th>邮件</th></tr></thead><tbody>@if (alertEvents.Count == 0) { <tr><td colspan="8" class="empty-cell">暂无告警事件</td></tr> } else { @foreach (var item in alertEvents) { <tr class="clickable-row" @onclick="() => OpenAlertEventDetailAsync(item)"><td>@FormatDateTime(item.FiredAt ?? item.CreatedAt)</td><td><span class="level-badge @SeverityTone(item.Severity)">@item.Severity</span><small>@AlertStatus(item.Status)</small></td><td>@(string.IsNullOrWhiteSpace(AlertDimensionText(item, "platform")) ? "-" : AlertDimensionText(item, "platform"))</td><td><code>#@item.RuleId</code></td><td><b>@(string.IsNullOrWhiteSpace(item.Title) ? "-" : item.Title)</b><small>@item.Description</small></td><td>@AlertDurationLabel(item)</td><td><small>@AlertDimensionsSummary(item)</small></td><td>@(item.EmailSent ? "已发送" : "未发送")</td></tr> } }</tbody></table></div>
                @if (alertEvents.Count > 0)
                {
                    <div class="load-more-row"><button type="button" class="secondary-button" disabled="@(!alertHasMore || alertLoadingMore)" @onclick="LoadMoreAlertsAsync">@(alertLoadingMore ? "加载中..." : alertHasMore ? "加载更多" : "没有更多")</button></div>
                }
            </section>
        }

        <section class="ops-card ops-table-card system-log-card">
            <header class="card-header"><div><h3>系统日志</h3><p>索引化运行日志与写入队列状态</p></div><div class="log-health-badges"><span>队列 @logHealth.QueueDepth / @logHealth.QueueCapacity</span><span>已写入 @logHealth.WrittenCount</span><span class="warning">丢弃 @logHealth.DroppedCount</span><span class="danger">失败 @logHealth.WriteFailedCount</span></div></header>
            <div class="system-log-tools"><button type="button" class="secondary-button" @onclick="OpenLogSettingsAsync">运行日志设置</button><button type="button" class="secondary-button" @onclick="LoadLogHealthAsync">刷新健康状态</button>@if (!string.IsNullOrWhiteSpace(logHealth.LastError)) { <span class="danger">最近写入错误：@logHealth.LastError</span> }</div>
            <div class="system-log-filters full">
                <label><span>时间范围</span><select @bind="logTimeRange"><option value="5m">5m</option><option value="30m">30m</option><option value="1h">1h</option><option value="6h">6h</option><option value="24h">24h</option><option value="7d">7d</option><option value="30d">30d</option></select></label>
                <label><span>开始时间</span><input type="datetime-local" value="@logStartInput" @onchange="e => logStartInput = e.Value?.ToString() ?? string.Empty" /></label>
                <label><span>结束时间</span><input type="datetime-local" value="@logEndInput" @onchange="e => logEndInput = e.Value?.ToString() ?? string.Empty" /></label>
                <label><span>级别</span><select @bind="logLevel"><option value="">全部级别</option><option value="debug">debug</option><option value="info">info</option><option value="warn">warn</option><option value="error">error</option></select></label>
                <label><span>组件</span><input @bind="logComponent" placeholder="gateway" /></label>
                <label><span>主机</span><input @bind="logHost" /></label>
                <label><span>request_id</span><input @bind="logRequestId" /></label>
                <label><span>client_request_id</span><input @bind="logClientRequestId" /></label>
                <label><span>user_id</span><input @bind="logUserId" inputmode="numeric" /></label>
                <label><span>api_key_id</span><input @bind="logApiKeyId" inputmode="numeric" /></label>
                <label><span>account_id</span><input @bind="logAccountId" inputmode="numeric" /></label>
                <label><span>平台</span><input @bind="logPlatform" /></label>
                <label><span>模型</span><input @bind="logModel" /></label>
                <label><span>关键词</span><input @bind="logSearch" placeholder="消息、错误、访问字段..." /></label>
            </div>
            <div class="system-log-actions"><button type="button" class="primary-button" @onclick="ApplyLogFiltersAsync">查询</button><button type="button" class="secondary-button" @onclick="ResetLogFiltersAsync">重置</button><button type="button" class="danger-link" @onclick="CleanupLogsAsync">清理当前筛选</button></div>
            <div class="table-scroll"><table class="ops-table log-table"><thead><tr><th>时间</th><th>主机</th><th>级别</th><th>日志详情</th></tr></thead><tbody>@if (logs.Items.Count == 0) { <tr><td colspan="4" class="empty-cell">暂无系统日志</td></tr> } else { @foreach (var row in logs.Items) { <tr><td>@row.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</td><td><b>@(string.IsNullOrWhiteSpace(row.Host) ? "-" : row.Host)</b><small>@row.Component</small></td><td><span class="level-badge @LogLevelTone(row.Level)">@row.Level</span></td><td class="log-message">@FormatSystemLogDetail(row)</td></tr> } }</tbody></table></div>
            <div class="ops-pagination"><span>共 @logs.Total 条</span><div><select value="@logPageSize" @onchange="LogPageSizeChangedAsync" aria-label="每页日志数"><option value="10">10 / 页</option><option value="20">20 / 页</option><option value="50">50 / 页</option><option value="100">100 / 页</option></select><button type="button" disabled="@(logPage <= 1)" @onclick="() => ChangeLogPageAsync(logPage - 1)">上一页</button><span>@logPage / @Math.Max(1, logs.Pages)</span><button type="button" disabled="@(logPage >= Math.Max(1, logs.Pages))" @onclick="() => ChangeLogPageAsync(logPage + 1)">下一页</button></div></div>
        </section>
    }
</div>

<AppModal Open="@customRangeOpen" Title="自定义时间范围" MaxWidth="520px" OnClose="CloseCustomRange">
    <ChildContent><div class="form-grid two"><label><span>开始时间</span><input type="datetime-local" value="@customStartInput" @onchange="e => customStartInput = e.Value?.ToString() ?? string.Empty" /></label><label><span>结束时间</span><input type="datetime-local" value="@customEndInput" @onchange="e => customEndInput = e.Value?.ToString() ?? string.Empty" /></label></div>@if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger">@modalError</div> }</ChildContent>
    <Footer><button type="button" class="secondary-button" @onclick="CloseCustomRange">取消</button><button type="button" class="primary-button" @onclick="ApplyCustomRangeAsync">确定</button></Footer>
</AppModal>

<AppModal Open="@jobsOpen" Title="后台任务" MaxWidth="760px" OnClose="() => jobsOpen = false">
    <ChildContent>@if (overview.JobHeartbeats.Count == 0) { <EmptyState Title="暂无任务心跳" Description="服务尚未上报后台任务状态。" /> } else { <div class="job-list">@foreach (var job in overview.JobHeartbeats) { <article><header><b>@job.JobName</b><span>@(job.LastDurationMs?.ToString() ?? "-") ms</span></header><p>最近成功：@FormatDateTime(job.LastSuccessAt)</p><p>最近运行：@FormatDateTime(job.LastRunAt)</p><p>结果：@(job.LastResult ?? "-")</p>@if (!string.IsNullOrWhiteSpace(job.LastError)) { <div class="job-error">@job.LastError</div> }</article> }</div> }</ChildContent>
</AppModal>

<AppModal Open="@requestsOpen" Title="请求明细" MaxWidth="1120px" OnClose="CloseRequests">
    <ChildContent>
        <div class="modal-toolbar ops-modal-heading"><span>时间范围：@CurrentRangeLabel</span><button type="button" class="secondary-button" @onclick="LoadRequestsAsync">刷新</button></div>
        <div class="modal-filter-row">
            <select @bind="requestKind"><option value="all">全部请求</option><option value="success">成功</option><option value="error">错误</option></select>
            <select @bind="requestSort"><option value="created_at_desc">时间从新到旧</option><option value="created_at_asc">时间从旧到新</option><option value="duration_desc">耗时从高到低</option><option value="duration_asc">耗时从低到高</option><option value="first_token_desc">首 Token 从慢到快</option><option value="first_token_asc">首 Token 从快到慢</option></select>
            <input @bind="requestSearch" placeholder="请求 ID、模型、用户..." />
            <button type="button" class="secondary-button" @onclick="LoadRequestsAsync">查询</button>
        </div>
        <div class="table-scroll"><table class="ops-table"><thead><tr><th>时间</th><th>类型</th><th>请求 ID</th><th>平台 / 模型</th><th>状态</th><th>耗时 / 首 Token</th><th>关联</th><th>操作</th></tr></thead><tbody>
            @if (requests.Items.Count == 0) { <tr><td colspan="8" class="empty-cell">暂无请求记录</td></tr> }
            else { @foreach (var row in requests.Items) { <tr><td>@row.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</td><td><span class="level-badge @(row.Kind == "error" ? "danger" : "success")">@(row.Kind == "error" ? "错误" : "成功")</span></td><td><code title="@row.RequestId">@row.RequestId</code></td><td><b>@row.Platform</b><small>@row.Model</small></td><td>@(row.StatusCode?.ToString() ?? "-")</td><td><b>@DurationValue(row.DurationMs)</b><small>首 Token @DurationValue(row.FirstTokenMs)</small></td><td><small>用户 @row.UserId · 账号 @row.AccountId</small></td><td><div class="row-actions"><button type="button" @onclick="() => CopyRequestIdAsync(row.RequestId)">复制 ID</button>@if (row.Kind == "error" && row.ErrorId.HasValue) { <button type="button" class="danger-link" @onclick='() => OpenErrorDetailAsync("request", row.ErrorId.Value)'>查看错误</button> }</div></td></tr> } }
        </tbody></table></div>
        <div class="ops-pagination"><span>共 @requests.Total 条</span><div><button disabled="@(requestPage <= 1)" @onclick="() => ChangeRequestPageAsync(requestPage - 1)">上一页</button><span>@requestPage / @Math.Max(1, requests.Pages)</span><button disabled="@(requestPage >= Math.Max(1, requests.Pages))" @onclick="() => ChangeRequestPageAsync(requestPage + 1)">下一页</button></div></div>
    </ChildContent>
</AppModal>

<AppModal Open="@errorsOpen" Title="@(errorKind == "upstream" ? "上游错误明细" : "请求错误明细")" MaxWidth="1180px" OnClose="CloseErrors">
    <ChildContent>
        <div class="modal-filter-row ops-error-filters">
            <input @bind="errorSearch" placeholder="消息、请求 ID、模型..." />
            <select @bind="errorStatusCode">
                <option value="">全部状态码</option>
                @foreach (var statusCode in ErrorStatusCodes)
                {
                    <option value="@statusCode">@statusCode</option>
                }
                <option value="other">其它状态码</option>
            </select>
            <select @bind="errorPhase"><option value="">全部阶段</option><option value="request">request</option><option value="auth">auth</option><option value="account_auth">account_auth</option><option value="routing">routing</option><option value="upstream">upstream</option><option value="network">network</option><option value="internal">internal</option></select>
            <select @bind="errorOwner"><option value="">全部归属</option><option value="provider">provider</option><option value="client">client</option><option value="platform">platform</option></select>
            <select @bind="errorView"><option value="errors">计入统计</option><option value="excluded">已排除</option><option value="all">全部错误</option></select>
            <select @bind="errorSortBy"><option value="created_at">按时间</option><option value="model">按模型</option><option value="status_code">按状态码</option></select>
            <select @bind="errorSortOrder"><option value="desc">降序</option><option value="asc">升序</option></select>
            <button type="button" class="secondary-button" @onclick="ResetErrorFiltersAsync">重置</button>
            <button type="button" class="primary-button" @onclick="LoadErrorsAsync">查询</button>
        </div>
        <div class="table-scroll"><table class="ops-table"><thead><tr><th>时间</th><th>状态</th><th>平台 / 模型</th><th>阶段 / 来源</th><th>消息</th><th>账号 / 用户</th><th>处理</th></tr></thead><tbody>
            @if (errors.Items.Count == 0) { <tr><td colspan="7" class="empty-cell">暂无错误记录</td></tr> }
            else { @foreach (var row in errors.Items) { <tr><td>@row.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</td><td><span class="level-badge danger">@row.StatusCode</span></td><td><b>@row.Platform</b><small>@(string.IsNullOrWhiteSpace(row.RequestedModel) ? row.Model : row.RequestedModel)</small></td><td><b>@row.Phase</b><small>@(string.IsNullOrWhiteSpace(row.ErrorOwner) ? row.ErrorSource : $"{row.ErrorOwner} / {row.ErrorSource}")</small></td><td class="log-message"><button type="button" class="error-message-button" @onclick="() => OpenErrorDetailAsync(errorKind, row.Id)">@row.Message</button></td><td><small>@row.AccountName<br />@row.UserEmail</small></td><td><div class="row-actions"><button type="button" @onclick="() => OpenErrorDetailAsync(errorKind, row.Id)">查看</button><button type="button" @onclick="() => ToggleErrorResolvedAsync(row)">@(row.Resolved ? "重新打开" : "标记解决")</button></div></td></tr> } }
        </tbody></table></div>
        <div class="ops-pagination"><span>共 @errors.Total 条</span><div><button disabled="@(errorPage <= 1)" @onclick="() => ChangeErrorPageAsync(errorPage - 1)">上一页</button><span>@errorPage / @Math.Max(1, errors.Pages)</span><button disabled="@(errorPage >= Math.Max(1, errors.Pages))" @onclick="() => ChangeErrorPageAsync(errorPage + 1)">下一页</button></div></div>
    </ChildContent>
</AppModal>

<AppModal Open="@errorDetailOpen" Title="@(errorDetailKind == "upstream" ? "上游错误详情" : "请求错误详情")" MaxWidth="980px" OnClose="CloseErrorDetail">
    <ChildContent>
        @if (errorDetailLoading) { <LoadingState Text="正在加载错误详情" /> }
        else if (selectedErrorDetail is null)
        {
            @if (!string.IsNullOrWhiteSpace(modalError))
            {
                <div class="inline-alert danger" role="alert">@modalError</div>
            }
            <EmptyState Title="错误详情不可用" Description="记录可能已被清理，请刷新后重试。" />
        }
        else
        {
            <div class="error-detail-grid">
                <article><span>时间</span><b>@FormatDateTime(selectedErrorDetail.CreatedAt)</b></article>
                <article><span>状态码</span><b class="danger">@selectedErrorDetail.StatusCode</b></article>
                <article><span>阶段 / 归属</span><b>@selectedErrorDetail.Phase · @selectedErrorDetail.ErrorOwner</b></article>
                <article><span>平台</span><b>@selectedErrorDetail.Platform</b></article>
                <article class="span-two"><span>请求 ID</span><div><code>@(string.IsNullOrWhiteSpace(selectedErrorDetail.RequestId) ? selectedErrorDetail.ClientRequestId : selectedErrorDetail.RequestId)</code><button type="button" class="text-button" @onclick="() => CopyRequestIdAsync(string.IsNullOrWhiteSpace(selectedErrorDetail.RequestId) ? selectedErrorDetail.ClientRequestId : selectedErrorDetail.RequestId)">复制</button></div></article>
                <article><span>请求模型</span><b>@(string.IsNullOrWhiteSpace(selectedErrorDetail.RequestedModel) ? selectedErrorDetail.Model : selectedErrorDetail.RequestedModel)</b></article>
                <article><span>上游模型</span><b>@(string.IsNullOrWhiteSpace(selectedErrorDetail.UpstreamModel) ? "-" : selectedErrorDetail.UpstreamModel)</b></article>
                <article class="span-two"><span>入口 / 上游端点</span><b>@(string.IsNullOrWhiteSpace(selectedErrorDetail.InboundEndpoint) ? selectedErrorDetail.RequestPath : selectedErrorDetail.InboundEndpoint) → @(string.IsNullOrWhiteSpace(selectedErrorDetail.UpstreamEndpoint) ? "-" : selectedErrorDetail.UpstreamEndpoint)</b></article>
                <article><span>账号 / 分组</span><b>@selectedErrorDetail.AccountName · @selectedErrorDetail.GroupName</b></article>
                <article><span>用户 / API Key</span><b>@selectedErrorDetail.UserEmail · @selectedErrorDetail.ApiKeyName</b></article>
                <article class="span-two"><span>错误消息</span><b>@selectedErrorDetail.Message</b></article>
            </div>
            <div class="latency-summary"><span>鉴权 <b>@DurationValue(selectedErrorDetail.AuthLatencyMs)</b></span><span>路由 <b>@DurationValue(selectedErrorDetail.RoutingLatencyMs)</b></span><span>上游 <b>@DurationValue(selectedErrorDetail.UpstreamLatencyMs)</b></span><span>响应 <b>@DurationValue(selectedErrorDetail.ResponseLatencyMs)</b></span><span>首 Token <b>@DurationValue(selectedErrorDetail.TimeToFirstTokenMs)</b></span></div>
            <section class="error-payload"><h3>响应内容</h3><pre>@SelectedErrorPayload</pre></section>
            @if (errorDetailKind == "request")
            {
                <section class="correlated-errors"><h3>关联上游错误（@correlatedUpstreamErrors.Count）</h3>@if (correlatedUpstreamErrors.Count == 0) { <p>没有关联的上游错误。</p> } else { @foreach (var item in correlatedUpstreamErrors) { <article><header><span>@FormatDateTime(item.CreatedAt)</span><b class="danger">@item.StatusCode</b></header><p>@item.Message</p><small>@item.AccountName · @item.UpstreamModel · @DurationValue(item.UpstreamLatencyMs)</small>@if (!string.IsNullOrWhiteSpace(ErrorPayload(item, "upstream"))) { <pre>@ErrorPayload(item, "upstream")</pre> }</article> } }</section>
            }
            @if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger">@modalError</div> }
        }
    </ChildContent>
    <Footer>@if (selectedErrorDetail is not null) { <button type="button" class="secondary-button" @onclick="() => ToggleSelectedErrorResolvedAsync()">@(selectedErrorDetail.Resolved ? "重新打开" : "标记解决")</button> }<span class="footer-spacer"></span><button type="button" class="primary-button" @onclick="CloseErrorDetail">关闭</button></Footer>
</AppModal>

<AppModal Open="@alertDetailOpen" Title="告警事件详情" MaxWidth="920px" OnClose="CloseAlertEventDetail">
    <ChildContent>
        @if (alertDetailLoading)
        {
            <LoadingState Text="正在加载告警详情" />
        }
        else if (selectedAlertEvent is null)
        {
            @if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger">@modalError</div> }
            <EmptyState Title="告警详情不可用" Description="该事件可能已被清理，请刷新后重试。" />
        }
        else
        {
            <div class="alert-detail-summary">
                <div><span class="level-badge @SeverityTone(selectedAlertEvent.Severity)">@selectedAlertEvent.Severity</span><span class="level-badge @AlertStatusTone(selectedAlertEvent.Status)">@AlertStatus(selectedAlertEvent.Status)</span><h3>@(string.IsNullOrWhiteSpace(selectedAlertEvent.Title) ? "未命名告警" : selectedAlertEvent.Title)</h3><p>@selectedAlertEvent.Description</p></div>
                <div class="alert-detail-actions"><label><span>静默</span><select @bind="alertSilenceDuration"><option value="1h">1 小时</option><option value="24h">24 小时</option><option value="7d">7 天</option></select></label><button type="button" class="secondary-button" disabled="@alertActionLoading" @onclick="SilenceSelectedAlertAsync">应用静默</button><button type="button" class="secondary-button" disabled="@(alertActionLoading || selectedAlertEvent.Status == "manual_resolved")" @onclick="ResolveSelectedAlertAsync">手动解决</button></div>
            </div>
            <div class="error-detail-grid alert-detail-grid">
                <article><span>触发时间</span><b>@FormatDateTime(selectedAlertEvent.FiredAt ?? selectedAlertEvent.CreatedAt)</b></article>
                <article><span>恢复时间</span><b>@FormatDateTime(selectedAlertEvent.ResolvedAt)</b></article>
                <article><span>规则 ID</span><div><code>#@selectedAlertEvent.RuleId</code><button type="button" class="text-button" @onclick="OpenSelectedAlertRuleAsync">查看规则</button></div></article>
                <article><span>指标 / 阈值</span><b>@(selectedAlertEvent.MetricValue?.ToString("0.###") ?? "-") / @(selectedAlertEvent.ThresholdValue?.ToString("0.###") ?? "-")</b></article>
                <article class="span-two"><span>告警维度</span><b>@AlertDimensionsSummary(selectedAlertEvent)</b></article>
                <article><span>邮件通知</span><b>@(selectedAlertEvent.EmailSent ? "已发送" : "未发送")</b></article>
                <article><span>持续时间</span><b>@AlertDurationLabel(selectedAlertEvent)</b></article>
            </div>
            <div class="alert-detail-links"><button type="button" class="secondary-button" @onclick="OpenSelectedAlertLogsAsync">查看关联错误日志</button></div>
            <section class="alert-history">
                <header><div><h3>同规则、同维度历史</h3><p>用于判断告警是否反复出现。</p></div><select value="@alertHistoryRange" @onchange="AlertHistoryRangeChangedAsync"><option value="7d">最近 7 天</option><option value="30d">最近 30 天</option></select></header>
                @if (alertHistoryLoading) { <LoadingState Text="正在加载告警历史" /> }
                else if (alertHistory.Count == 0) { <p class="empty-history">暂无历史事件</p> }
                else { <div class="table-scroll"><table class="ops-table"><thead><tr><th>时间</th><th>状态</th><th>指标 / 阈值</th></tr></thead><tbody>@foreach (var item in alertHistory) { <tr><td>@FormatDateTime(item.FiredAt ?? item.CreatedAt)</td><td>@AlertStatus(item.Status)</td><td>@(item.MetricValue?.ToString("0.##") ?? "-") / @(item.ThresholdValue?.ToString("0.##") ?? "-")</td></tr> }</tbody></table></div> }
            </section>
            @if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger">@modalError</div> }
        }
    </ChildContent>
    <Footer><span class="footer-spacer"></span><button type="button" class="primary-button" @onclick="CloseAlertEventDetail">关闭</button></Footer>
</AppModal>

<AppModal Open="@alertRulesOpen" Title="预警规则" MaxWidth="1050px" OnClose="CloseAlertRules">
    <ChildContent>
        @if (!ruleEditorOpen)
        {
            <div class="modal-toolbar"><p>按监控指标自动触发告警事件与邮件通知。</p><button type="button" class="primary-button" @onclick="OpenNewRule"><Icon Name="plus" Size="15" />新建规则</button></div>
            <div class="table-scroll"><table class="ops-table"><thead><tr><th>名称</th><th>指标</th><th>条件</th><th>级别</th><th>启用</th><th>最近触发</th><th>操作</th></tr></thead><tbody>@if (alertRules.Count == 0) { <tr><td colspan="7" class="empty-cell">暂无告警规则</td></tr> } else { @foreach (var row in alertRules) { <tr><td><b>@row.Name</b><small>@row.Description</small></td><td><code>@row.MetricType</code></td><td>@row.Operator @row.Threshold</td><td><span class="level-badge @SeverityTone(row.Severity)">@row.Severity</span></td><td><button type="button" class="switch-button @(row.Enabled ? "on" : null)" aria-label="切换规则启用状态" @onclick="() => ToggleRuleAsync(row)"><i></i></button></td><td>@FormatDateTime(row.LastTriggeredAt)</td><td><div class="row-actions"><button type="button" @onclick="() => EditRule(row)">编辑</button><button type="button" class="danger-link" @onclick="() => DeleteRuleAsync(row)">删除</button></div></td></tr> } }</tbody></table></div>
        }
        else
        {
            <div class="form-grid two">
                <label><span>名称</span><input @bind="ruleDraft.Name" /></label>
