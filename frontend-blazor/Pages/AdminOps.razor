    private void ApplyRuleGroupFilter()
    {
        if (!IsGroupMetric(ruleDraft.MetricType))
        {
            if (ruleDraft.Filters is not null)
            {
                ruleDraft.Filters.Remove("group_id");
                if (ruleDraft.Filters.Count == 0) ruleDraft.Filters = null;
            }
            return;
        }

        if (!long.TryParse(ruleGroupIdValue, out var groupIdValue) || groupIdValue <= 0) return;
        ruleDraft.Filters ??= [];
        ruleDraft.Filters["group_id"] = JsonSerializer.SerializeToElement(groupIdValue);
    }

    private static bool IsGroupMetric(string? metricType) => !string.IsNullOrWhiteSpace(metricType) && GroupAlertMetricTypes.Contains(metricType);

