    private RenderFragment UsageCell(SubscriptionDto subscription, bool large) => builder =>
    {
        var group = subscription.Group;
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", large ? "subscription-usage-cell large" : "subscription-usage-cell");
        if (group is null || !HasAnyLimit(group))
        {
            builder.OpenElement(2, "div"); builder.AddAttribute(3, "class", "unlimited-usage"); builder.OpenElement(4, "strong"); builder.AddContent(5, "∞"); builder.CloseElement(); builder.OpenElement(6, "span"); builder.AddContent(7, large ? "无限制 · 该订阅无用量限制" : "无限制"); builder.CloseElement(); builder.CloseElement();
        }
        else
        {
            var sequence = 10;
            if (group.DailyLimitUsd is > 0) AddUsageWindow(builder, ref sequence, "每日", subscription.DailyUsageUsd, group.DailyLimitUsd.Value, DailyResetLabel(subscription));
            if (group.WeeklyLimitUsd is > 0) AddUsageWindow(builder, ref sequence, "每周", subscription.WeeklyUsageUsd, group.WeeklyLimitUsd.Value, ResetLabel(subscription.WeeklyWindowStart, TimeSpan.FromDays(7)));
            if (group.MonthlyLimitUsd is > 0) AddUsageWindow(builder, ref sequence, "每月", subscription.MonthlyUsageUsd, group.MonthlyLimitUsd.Value, ResetLabel(subscription.MonthlyWindowStart, TimeSpan.FromDays(30)));
        }
        builder.CloseElement();
    };

    private static void AddUsageWindow(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int sequence, string label, double used, double limit, string reset)
    {
        var percentage = limit <= 0 ? 0 : Math.Min(100, used / limit * 100);
        var progressClass = percentage >= 90 ? "danger" : percentage >= 70 ? "warning" : "success";
        builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "subscription-usage-row");
        builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "subscription-usage-line");
        builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "usage-window-label"); builder.AddContent(sequence++, label); builder.CloseElement();
        builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "usage-progress"); builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", $"{progressClass}"); builder.AddAttribute(sequence++, "style", $"width:{percentage.ToString("0.##", CultureInfo.InvariantCulture)}%"); builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "usage-numbers"); builder.AddContent(sequence++, $"${used:0.00} / ${limit:0.00}"); builder.CloseElement(); builder.CloseElement();
        if (!string.IsNullOrWhiteSpace(reset)) { builder.OpenElement(sequence++, "small"); builder.AddContent(sequence++, reset); builder.CloseElement(); }
        builder.CloseElement();
    }

    private static bool HasAnyLimit(GoGroup group) => group.DailyLimitUsd is > 0 || group.WeeklyLimitUsd is > 0 || group.MonthlyLimitUsd is > 0;
    private static bool IsOneTimeDailyQuota(SubscriptionDto subscription) => subscription.StartsAt.HasValue && subscription.ExpiresAt.HasValue && subscription.ExpiresAt.Value <= subscription.StartsAt.Value.AddDays(1);
    private static string DailyResetLabel(SubscriptionDto subscription) => IsOneTimeDailyQuota(subscription) && subscription.ExpiresAt.HasValue ? DurationLabel(subscription.ExpiresAt.Value, "额度将在", "后结束") : ResetLabel(subscription.DailyWindowStart, TimeSpan.FromDays(1));
    private static string ResetLabel(DateTimeOffset? start, TimeSpan window) => start.HasValue ? DurationLabel(start.Value.Add(window), string.Empty, "后重置") : "窗口未激活";
    private static string DurationLabel(DateTimeOffset target, string prefix, string suffix)
    {
        var remaining = target - DateTimeOffset.Now;
        if (remaining <= TimeSpan.Zero) return "窗口未激活";
        var totalMinutes = Math.Max(0, (int)Math.Floor(remaining.TotalMinutes));
        var days = totalMinutes / 1440; var hours = totalMinutes % 1440 / 60; var minutes = totalMinutes % 60;
        var value = days > 0 ? $"{days} 天 {hours} 小时" : hours > 0 ? $"{hours} 小时 {minutes} 分钟" : $"{minutes} 分钟";
        return $"{prefix}{value}{suffix}";
    }

    private string UserDisplay(SubscriptionDto value) => userColumnMode == "username" ? value.User?.Username ?? "—" : value.User?.Email ?? $"用户 #{value.UserId}";
    private string UserInitial(SubscriptionDto value) => Initial(userColumnMode == "username" ? value.User?.Username : value.User?.Email);
    private static string UserEmail(SubscriptionDto value) => value.User?.Email ?? $"用户 #{value.UserId}";
    private static string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[..1].ToUpperInvariant();
    private static string UserResultDetail(GoUser user) { var values = new List<string> { $"#{user.Id}" }; if (!string.IsNullOrWhiteSpace(user.Username)) values.Add(user.Username); if (!string.IsNullOrWhiteSpace(user.Notes)) values.Add(user.Notes); return string.Join(" · ", values); }
    private static string StatusLabel(string status) => status switch { "active" => "生效中", "expired" => "已过期", "revoked" => "已撤销", "suspended" => "已暂停", _ => status };
    private static string SelfStatusLabel(string status) => status switch { "active" => "有效", "expired" => "已过期", "revoked" => "已撤销", "suspended" => "已暂停", _ => status };
    private static string FormatDateTime(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    private static string? RemainingExpiry(DateTimeOffset value)
    {
        var remaining = value - DateTimeOffset.Now; if (remaining <= TimeSpan.Zero) return null;
        if (remaining >= TimeSpan.FromDays(1)) return $"剩余 {(int)Math.Ceiling(remaining.TotalDays)} 天";
        var minutes = Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes)); var hours = minutes / 60; minutes %= 60;
        return hours > 0 ? $"剩余 {hours} 小时 {minutes} 分钟" : $"剩余 {minutes} 分钟";
    }
    private static string ExpiryClass(DateTimeOffset value) => value <= DateTimeOffset.Now ? "expired" : value - DateTimeOffset.Now <= TimeSpan.FromDays(7) ? "soon" : string.Empty;
    private static string SelfExpiration(DateTimeOffset? value) => !value.HasValue ? "无到期时间" : value.Value <= DateTimeOffset.Now ? "已过期" : $"剩余 {(int)Math.Ceiling((value.Value - DateTimeOffset.Now).TotalDays)} 天（{FormatDateTime(value.Value)}）";
    private static string PlatformLabel(string? value) => value switch { "anthropic" => "Anthropic", "openai" => "OpenAI", "gemini" => "Gemini", "antigravity" => "Antigravity", "grok" => "Grok", "composite" => "Composite", _ => string.IsNullOrWhiteSpace(value) ? "未知平台" : value };
    private static string PlatformClass(string? value) => value switch { "anthropic" => "anthropic", "openai" => "openai", "gemini" => "gemini", "antigravity" => "antigravity", "grok" => "grok", _ => "other" };
    private static string FormatRate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string PeakRateLabel(GoGroup group) => $"{group.PeakStart}–{group.PeakEnd} ×{FormatRate(group.PeakRateMultiplier)}";

