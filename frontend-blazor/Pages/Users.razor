    private void SetQuotaRows(IEnumerable<AdminPlatformQuotaDto> source) { var map = source.ToDictionary(x => x.Platform, StringComparer.OrdinalIgnoreCase); quotaRows = QuotaPlatforms.Select(platform => map.TryGetValue(platform, out var row) ? row : new AdminPlatformQuotaDto { Platform = platform }).ToList(); }
    private void CloseQuota() { if (!saving) quotaOpen = false; }
    private async Task ClearAllQuotasAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "确认清空全部平台的日 / 周 / 月限额？所有平台将变为\"无限额\"，本地无法撤销，需要在保存前手动重填。");
        if (!confirmed) return;
        foreach (var quota in quotaRows)
        {
            quota.DailyLimitUsd = null;
            quota.WeeklyLimitUsd = null;
            quota.MonthlyLimitUsd = null;
        }
    }
    private async Task SaveQuotaAsync()
    {
        if (actionUser is null) return;
        modalError = null;
        var invalidFields = quotaRows
            .SelectMany(row => new[]
            {
                (Name: $"{row.Platform}.daily", Value: row.DailyLimitUsd),
                (Name: $"{row.Platform}.weekly", Value: row.WeeklyLimitUsd),
                (Name: $"{row.Platform}.monthly", Value: row.MonthlyLimitUsd)
            })
            .Where(field => field.Value.HasValue && (!double.IsFinite(field.Value.Value) || field.Value.Value < 0))
            .Select(field => field.Name)
            .ToList();
        if (invalidFields.Count > 0)
        {
            modalError = $"以下字段填写不是合法数字，请修正后再保存：{string.Join(", ", invalidFields)}";
            return;
        }
        saving = true;
        try { var payload = quotaRows.Select(x => (object)new { platform = x.Platform, daily_limit_usd = x.DailyLimitUsd, weekly_limit_usd = x.WeeklyLimitUsd, monthly_limit_usd = x.MonthlyLimitUsd }); SetQuotaRows((await Api.UpdateAdminUserPlatformQuotasAsync(actionUser.Id, payload)).PlatformQuotas); Toasts.Success("平台限额已更新"); platformQuotaStats[actionUser.Id] = quotaRows; quotaOpen = false; }
        catch (ApiException ex) { modalError = ex.Message; }
        finally { saving = false; }
    }
