    private async Task SaveUserAsync()
    {
        modalError = null;
        if (editingUser is null && string.IsNullOrWhiteSpace(editor.Password)) { modalError = "请输入初始密码"; return; }
        if (!string.IsNullOrWhiteSpace(editor.Password) && editor.Password.Length < 6) { modalError = "密码至少需要 6 个字符"; return; }
        if (editor.Concurrency < 0 || editor.RpmLimit < 0) { modalError = "并发和 RPM 不能为负数"; return; }
        saving = true;
        var editing = editingUser;
        var succeeded = await RunSensitiveAsync(async () =>
        {
            if (editing is null)
            {
                var payload = new Dictionary<string, object?> { ["email"] = editor.Email.Trim(), ["password"] = editor.Password, ["username"] = editor.Username.Trim(), ["role"] = editor.Role, ["concurrency"] = editor.Concurrency, ["rpm_limit"] = editor.RpmLimit };
                if (editor.Balance.HasValue) payload["balance"] = editor.Balance.Value;
                await Api.CreateAdminUserAsync(payload);
            }
            else
            {
                var payload = new Dictionary<string, object?> { ["email"] = editor.Email.Trim(), ["username"] = editor.Username.Trim(), ["notes"] = editor.Notes.Trim(), ["role"] = editor.Role, ["concurrency"] = editor.Concurrency, ["rpm_limit"] = editor.RpmLimit };
                if (!string.IsNullOrWhiteSpace(editor.Password)) payload["password"] = editor.Password.Trim();
                await Api.UpdateAdminUserAsync(editing.Id, payload);
                if (EnabledAttributes.Count > 0) await Api.UpdateUserAttributeValuesAsync(editing.Id.ToString(), editorAttributes);
            }
        });
        saving = false;
        if (!succeeded) return;
        editorOpen = false; Toasts.Success(editing is null ? "用户已创建" : "用户已更新");
        if (editing is not null && editing.Id.ToString() == Auth.User?.Id) await Auth.RefreshAsync();
        await LoadAsync();
    }

    private async Task<bool> RunSensitiveAsync(Func<Task> operation)
    {
        try { await operation(); return true; }
        catch (ApiException ex) when (string.Equals(ex.Code, "STEP_UP_REQUIRED", StringComparison.OrdinalIgnoreCase))
        {
            var code = await JS.InvokeAsync<string?>("prompt", "请输入管理员 TOTP 验证码以继续");
            if (string.IsNullOrWhiteSpace(code)) return false;
            try { await Api.VerifyTotpStepUpAsync(code); await operation(); return true; }
            catch (ApiException retry) { modalError = retry.Message; return false; }
        }
        catch (ApiException ex) { modalError = ex.Message; return false; }
    }

