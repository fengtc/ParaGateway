    private string FormatAttributeValue(long userId, UserAttributeDefinitionDto definition)
    {
        if (!userAttributeValues.TryGetValue(userId, out var values) || !values.TryGetValue(definition.Id, out var value) || string.IsNullOrWhiteSpace(value)) return "-";
        if (definition.Type == "select") return definition.Options.FirstOrDefault(x => x.Value == value)?.Label ?? value;
        if (definition.Type == "multi_select") { try { var items = JsonSerializer.Deserialize<List<string>>(value) ?? []; return string.Join("、", items.Select(item => definition.Options.FirstOrDefault(x => x.Value == item)?.Label ?? item)); } catch (JsonException) { } }
        return value;
    }
    private string UsageCell(long userId, string? platform)
    {
        if (!usageStats.TryGetValue(userId, out var stats)) return "今日 $0.00 / 累计 $0.00";
        if (platform is null) return $"今日 {Money(stats.TodayActualCost)} / 累计 {Money(stats.TotalActualCost)}";
        var row = stats.ByPlatform.FirstOrDefault(x => string.Equals(x.Platform, platform, StringComparison.OrdinalIgnoreCase));
        return row is null ? "今日 $0.00 / 累计 $0.00" : $"今日 {Money(row.TodayActualCost)} / 累计 {Money(row.TotalActualCost)}";
    }
    private RenderFragment UsageSortHeader(string key, string label) => @<div class="usage-sort-heading">
        <span>@label</span>
        <div class="usage-sort-anchor">
            <button type="button" class="usage-sort-trigger @(usageSortKey == key ? "active" : null)" title="排序" data-test="usage-sort-trigger-@key" @onclick="() => ToggleUsageSortMenu(key)">
                @if (usageSortKey == key)
                {
                    <small>@(usageSortMetric == "today" ? "今日" : "近30天")</small>
                    <span class="usage-sort-arrow @(usageSortOrder == "desc" ? "descending" : null)">↑</span>
                }
                else
                {
                    <Icon Name="chevrons-up-down" Size="14" />
                }
            </button>
            @if (openUsageSortMenu == key)
            {
                <button type="button" class="usage-sort-backdrop" aria-label="关闭用量排序菜单" @onclick="CloseUsageSortMenu"></button>
                <div class="usage-sort-menu">
                    <button type="button" class="@(IsUsageSortActive(key, "today") ? "active" : null)" data-test="usage-sort-@key-today" @onclick='() => ToggleUsageSortAsync(key, "today")'>
                        <span>今日</span><strong>@UsageSortIndicator(key, "today")</strong>
                    </button>
                    <button type="button" class="@(IsUsageSortActive(key, "total") ? "active" : null)" data-test="usage-sort-@key-total" @onclick='() => ToggleUsageSortAsync(key, "total")'>
                        <span>近30天</span><strong>@UsageSortIndicator(key, "total")</strong>
                    </button>
                    <small>仅排序当前页</small>
                </div>
            }
        </div>
    </div>;
    private void ToggleUsageSortMenu(string key) { activeActionId = null; expandedGroupUserId = null; openUsageSortMenu = openUsageSortMenu == key ? null : key; }
    private void CloseUsageSortMenu() => openUsageSortMenu = null;
    private bool IsUsageSortActive(string key, string metric) => usageSortKey == key && usageSortMetric == metric;
    private string UsageSortIndicator(string key, string metric) => IsUsageSortActive(key, metric) ? usageSortOrder == "asc" ? "↑" : "↓" : string.Empty;
    private async Task ToggleUsageSortAsync(string key, string metric)
    {
        if (IsUsageSortActive(key, metric))
        {
            if (usageSortOrder == "desc") usageSortOrder = "asc";
            else { usageSortKey = null; usageSortMetric = "today"; usageSortOrder = "desc"; }
        }
        else
        {
            usageSortKey = key;
            usageSortMetric = metric == "total" ? "total" : "today";
            usageSortOrder = "desc";
        }
        openUsageSortMenu = null;
        await PersistUsageSortAsync();
    }
    private async Task ClearUsageSortAsync()
    {
        usageSortKey = null;
        usageSortMetric = "today";
        usageSortOrder = "desc";
        openUsageSortMenu = null;
        try { await JS.InvokeVoidAsync("localStorage.removeItem", UsageSortStorageKey); } catch (JSException) { }
    }
    private async Task PersistUsageSortAsync()
    {
        try
        {
            if (usageSortKey is null) await JS.InvokeVoidAsync("localStorage.removeItem", UsageSortStorageKey);
            else await JS.InvokeVoidAsync("localStorage.setItem", UsageSortStorageKey, JsonSerializer.Serialize(new UsageSortPreference { Key = usageSortKey, Metric = usageSortMetric, Order = usageSortOrder }));
        }
        catch (JSException) { }
    }
    private double GetUsageSortValue(long userId, string key, string metric)
    {
        if (!usageStats.TryGetValue(userId, out var stats)) return 0;
        if (key == "usage") return metric == "today" ? stats.TodayActualCost : stats.TotalActualCost;
        var platform = key switch { "usage_anthropic" => "anthropic", "usage_openai" => "openai", "usage_gemini" => "gemini", "usage_antigravity" => "antigravity", _ => string.Empty };
        var row = stats.ByPlatform.FirstOrDefault(x => string.Equals(x.Platform, platform, StringComparison.OrdinalIgnoreCase));
        if (row is null) return 0;
        return metric == "today" ? row.TodayActualCost : row.TotalActualCost;
    }
    private IReadOnlyList<AdminPlatformQuotaDto> GetConfiguredQuotaRows(long userId) => platformQuotaStats.TryGetValue(userId, out var values)
        ? values.Where(x => x.DailyLimitUsd.HasValue || x.WeeklyLimitUsd.HasValue || x.MonthlyLimitUsd.HasValue).OrderBy(x => Array.IndexOf(QuotaPlatforms, x.Platform)).ToList()
        : [];
    private static bool HasActiveSubscription(GoUser user) => user.Subscriptions.Any(x => string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase));
    private static string FormatQuotaNumber(double value) => Math.Round(value, 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string FormatQuotaLimit(double? value) => value.HasValue ? FormatQuotaNumber(value.Value) : "—";
    private static string Initial(string email) => string.IsNullOrWhiteSpace(email) ? "?" : char.ToUpperInvariant(email[0]).ToString();
    private static string Money(decimal value) => $"${value.ToString("0.00######", System.Globalization.CultureInfo.InvariantCulture)}";
    private static string Money(double value) => $"${value.ToString("0.00######", System.Globalization.CultureInfo.InvariantCulture)}";
    private static string FormatDateTime(DateTimeOffset? value) => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";
    private static int ConcurrencyPercent(GoUser user) => user.Concurrency <= 0 ? 0 : Math.Clamp((int)Math.Round(user.CurrentConcurrency * 100d / user.Concurrency), 0, 100);
    private static string PlatformLabel(string value) => value.ToLowerInvariant() switch { "anthropic" => "Anthropic", "openai" => "OpenAI", "gemini" => "Gemini", "antigravity" => "Antigravity", "grok" => "Grok", _ => value };
    private static string WindowLabel(string value) => value switch { "daily" => "每日", "weekly" => "每周", "monthly" => "每月", _ => value };
    private static bool IsBalanceHistory(AdminBalanceHistoryItemDto item) => item.Type is "balance" or "affiliate_balance" or "admin_balance";
    private static string HistoryIcon(AdminBalanceHistoryItemDto item) => IsBalanceHistory(item) ? "dollar" : item.Type == "subscription" ? "ticket" : "activity";
    private static string HistoryTone(AdminBalanceHistoryItemDto item) => item.Type == "subscription" ? "purple" : item.Value >= 0 ? "success" : "danger";
    private static string HistoryTitle(AdminBalanceHistoryItemDto item) => item.Type switch { "balance" => "兑换码充值", "affiliate_balance" => "邀请返利", "admin_balance" => item.Value >= 0 ? "管理员充值" : "管理员扣款", "concurrency" => "兑换并发", "admin_concurrency" => item.Value >= 0 ? "管理员增加并发" : "管理员减少并发", "subscription" => "分配订阅", _ => "未知变更" };
    private static string HistoryValue(AdminBalanceHistoryItemDto item) { if (item.Type == "subscription") return $"{(item.ValidityDays > 0 ? item.ValidityDays : Math.Round(item.Value))} 天 · {item.Group?.Name ?? "订阅"}"; var sign = item.Value >= 0 ? "+" : string.Empty; return IsBalanceHistory(item) ? $"{sign}{Money(item.Value)}" : $"{sign}{item.Value:0.##}"; }

