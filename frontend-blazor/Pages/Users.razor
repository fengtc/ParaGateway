        var publicGroups = groups.Where(x => !x.IsExclusive && x.Status == "active" && x.SubscriptionType == "standard").ToList();
        return new(exclusive.Count, publicGroups.Count, $"专属：{(exclusive.Count == 0 ? "无" : string.Join("、", exclusive.Select(x => x.Name)))}；公开：{(publicGroups.Count == 0 ? "无" : string.Join("、", publicGroups.Select(x => x.Name)))}");
