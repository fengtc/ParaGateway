@page "/admin/work-distribution"
@using System.Globalization
@inject ApiClient Api

<PageTitle>工作内容分析 · ParaGateway</PageTitle>

<div class="work-page">
    <section class="work-filters" aria-label="工作内容筛选">
        <label><span>人员</span><select value="@SelectedUser" @onchange="UserChanged"><option value="">全部人员</option>@foreach (var item in people.OrderBy(x => x.Email)) { <option value="@item.UserId">@item.Email</option> }</select></label>
        <label><span>部门</span><select value="@department" @onchange="e => department = e.Value?.ToString() ?? string.Empty"><option value="">全部部门</option>@foreach (var item in departments.Order()) { <option value="@item">@Label(item)</option> }</select></label>
        <label><span>岗位角色</span><select value="@role" @onchange="e => role = e.Value?.ToString() ?? string.Empty"><option value="">全部岗位</option>@foreach (var item in roles.Order()) { <option value="@item">@Label(item)</option> }</select></label>
        <label><span>开始时间</span><input type="datetime-local" step="1" value="@startDate" aria-label="开始时间（精确到秒）" @onchange="e => startDate = e.Value?.ToString() ?? startDate" /></label>
        <label><span>结束时间</span><input type="datetime-local" step="1" value="@endDate" aria-label="结束时间（精确到秒）" @onchange="e => endDate = e.Value?.ToString() ?? endDate" /></label>
        <div class="work-actions"><div class="metric-switch"><button class="@(metric == "requests" ? "active" : null)" @onclick='() => SetMetricAsync("requests")'>提交次数</button><button class="@(metric == "tokens" ? "active" : null)" @onclick='() => SetMetricAsync("tokens")'>工作量</button></div><button class="button primary" disabled="@loading" @onclick="LoadAsync"><Icon Name="filter" Size="16" />应用</button></div>
    </section>

    @if (loading && summary is null) { <LoadingState Text="正在载入工作内容分析" /> }
    else if (!string.IsNullOrWhiteSpace(error)) { <ErrorState Message="@error" OnRetry="LoadAsync" /> }
    else if (summary is not null && (summary.Coverage.TotalRequests == 0 || string.Equals(summary.CollectionStatus, "no_data", StringComparison.OrdinalIgnoreCase)))
    {
        <EmptyState Title="暂无请求样本" Description="当前筛选范围内没有 API 请求，因此不生成工作分布统计。" />
    }
    else if (summary is not null)
    {
        <section class="work-kpis">
            <article><small>样本数</small><strong>@Number(summary.Coverage.TotalRequests)</strong></article>
            <article><small>工作相关占比</small><strong>@Percent(WorkShare)</strong></article>
            <article><small>分类覆盖率</small><strong>@Percent(summary.Coverage.ClassifiedPercent)</strong></article>
            <article><small>平均置信度</small><strong>@Confidence(summary.AverageConfidence)</strong><span>@Number(summary.ConfidenceSampleCount) 个样本</span></article>
        </section>

        <section class="work-panel">
            <header><div><h2>工作相关占比</h2><p>工作相关、非工作和不确定样本</p></div></header>
            <div class="chart-list"><article><div class="chart-label"><strong>全部样本</strong><small>@Number(summary.Coverage.TotalRequests) 次</small></div><div class="stacked-chart">@foreach (var segment in RelationSegments) { <span style="@SegmentStyle(segment)" title="@SegmentTitle(segment)"></span> }</div></article></div>
        </section>

        <section class="work-panel">
            <header><div><h2>工作内容分布</h2><p>编码、文档、分析/运维及不确定占比</p></div></header>
            <div class="work-legend">@foreach (var item in Legend) { <span><i style="background:@item.Color"></i>@item.Label</span> }</div>
            <div class="chart-list">
                <article><div class="chart-label"><strong>全部人员</strong><small>@SummaryMeta(summary.Coverage.TotalRequests, summary.AverageConfidence)</small></div><div class="stacked-chart">@foreach (var segment in BuildSegments(summary.Categories)) { <span style="@SegmentStyle(segment)" title="@SegmentTitle(segment)"></span> }</div></article>
                @foreach (var item in summary.Users) { <article><div class="chart-label"><strong>@item.Email</strong><small>@Label(item.Department) · @Label(item.Role) · @SummaryMeta(item.Requests, item.AverageConfidence)</small></div><div class="stacked-chart">@foreach (var segment in BuildSegments(item.Categories)) { <span style="@SegmentStyle(segment)" title="@SegmentTitle(segment)"></span> }</div></article> }
            </div>
        </section>

        <section class="work-panel">
            <header><div><h2>部门分布</h2><p>按部门汇总的工作内容占比</p></div></header>
            @if (summary.Departments.Count == 0) { <EmptyState Title="暂无部门数据" Description="当前筛选范围没有可统计样本。" /> }
            else { <div class="chart-list">@foreach (var item in summary.Departments) { <article><div class="chart-label"><strong>@Label(item.Department)</strong><small>@SummaryMeta(item.Requests, item.AverageConfidence)</small></div><div class="stacked-chart">@foreach (var segment in BuildSegments(item.Categories)) { <span style="@SegmentStyle(segment)" title="@SegmentTitle(segment)"></span> }</div></article> }</div> }
        </section>
    }
</div>

@code {
    private WorkDistributionSummaryDto? summary;
    private bool loading;
    private string? error;
    private string startDate = DateTime.Today.ToString("yyyy-MM-dd'T'00:00:00", CultureInfo.InvariantCulture);
    private string endDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd'T'00:00:00", CultureInfo.InvariantCulture);
    private string department = string.Empty;
    private string role = string.Empty;
    private string metric = "requests";
    private long? userId;
    private readonly List<WorkDistributionUserDto> people = [];
    private readonly HashSet<string> departments = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> roles = new(StringComparer.OrdinalIgnoreCase);

    private string SelectedUser => userId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    private double WorkShare => summary?.WorkRelated.FirstOrDefault(x => x.WorkRelated == "work")?.Percent ?? 0;
    private IReadOnlyList<ChartSegment> RelationSegments => summary?.WorkRelated.Select(x => new ChartSegment(RelationLabel(x.WorkRelated), x.Percent, RelationColor(x.WorkRelated))).ToList() ?? [];
    private static readonly ChartSegment[] Legend = [new("编码", 0, "#2563eb"), new("文档", 0, "#16a34a"), new("分析/运维", 0, "#7c3aed"), new("其他工作", 0, "#0891b2"), new("不确定", 0, "#94a3b8"), new("非工作", 0, "#dc2626")];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (loading) return;
        loading = true;
        error = null;
        summary = null;
        try
        {
            summary = await Api.GetAdminWorkDistributionSummaryAsync(new() { StartDate = startDate, EndDate = endDate, UserId = userId, Department = department, Role = role, Metric = metric });
            foreach (var item in summary.Users) if (people.All(x => x.UserId != item.UserId)) people.Add(item);
            foreach (var item in summary.Departments) if (!string.IsNullOrWhiteSpace(item.Department)) departments.Add(item.Department);
            foreach (var item in summary.Roles) if (!string.IsNullOrWhiteSpace(item.Role)) roles.Add(item.Role);
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task SetMetricAsync(string value) { metric = value; await LoadAsync(); }
    private void UserChanged(ChangeEventArgs e) { userId = long.TryParse(e.Value?.ToString(), out var value) ? value : null; }
    private static IReadOnlyList<ChartSegment> BuildSegments(IEnumerable<WorkDistributionCategoryDto> source)
    {
        var values = source.GroupBy(x => Group(x.Category)).ToDictionary(x => x.Key, x => x.Sum(y => y.Value));
        var total = values.Values.Sum();
        if (total <= 0) return [];
        return Legend.Select(x => new ChartSegment(x.Label, values.GetValueOrDefault(x.Label) * 100d / total, x.Color)).Where(x => x.Percent > 0).ToList();
    }
    private static string Group(string value) => value switch { "coding" => "编码", "documentation" => "文档", "data_analysis" or "operations" => "分析/运维", "unclassified" => "不确定", "non_work" => "非工作", _ => "其他工作" };
    private static string RelationLabel(string value) => value switch { "work" => "工作相关", "non_work" => "非工作", _ => "不确定" };
    private static string RelationColor(string value) => value switch { "work" => "#2563eb", "non_work" => "#dc2626", _ => "#94a3b8" };
    private static string Label(string? value) => string.IsNullOrWhiteSpace(value) || value == "unknown" ? "未设置" : value;
    private static string Number(long value) => value.ToString("N0", CultureInfo.InvariantCulture);
    private static string Percent(double value) => $"{value:0.0}%";
    private static string Confidence(double? value) => value.HasValue ? $"{value.Value * 100:0.0}%" : "--";
    private static string SummaryMeta(long samples, double? confidence) => $"{Number(samples)} 个样本 · 置信度 {Confidence(confidence)}";
    private static string SegmentStyle(ChartSegment item) => $"width:{item.Percent.ToString("0.####", CultureInfo.InvariantCulture)}%;background:{item.Color}";
    private static string SegmentTitle(ChartSegment item) => $"{item.Label} {item.Percent:0.0}%";

    private sealed record ChartSegment(string Label, double Percent, string Color);
}
