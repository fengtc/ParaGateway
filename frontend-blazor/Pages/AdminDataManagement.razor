@page "/admin/data-management"
@inject NavigationManager Navigation

<PageTitle>备份管理 · ParaGateway</PageTitle>

<div class="app-boot" role="status">
    <span class="spinner"></span>
    <span>正在打开备份管理</span>
</div>

@code {
    protected override void OnInitialized()
    {
        // 保留旧地址，避免书签或外部链接进入已废弃的数据管理代理页面。
        Navigation.NavigateTo("/admin/backups", replace: true);
    }
}
