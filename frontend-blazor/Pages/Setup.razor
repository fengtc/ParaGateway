@page "/setup"
@layout AuthLayout
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>初始化安装 · ParaGateway</PageTitle>

<div class="setup-page">
    <div class="setup-brand">
        <BrandMark />
        <span><strong>ParaGateway</strong><small>首次安装</small></span>
    </div>

    <section class="setup-panel" aria-label="首次安装向导">
        <header class="setup-header">
            <span class="eyebrow">独立主机初始化</span>
            <h1>配置 ParaGateway</h1>
            <p>按官方 Go 服务的安装契约配置 PostgreSQL、Redis 和管理员账户。</p>
        </header>

        <div class="setup-steps" aria-label="安装步骤">
            @for (var index = 0; index < steps.Length; index++)
            {
                <div class="setup-step @(currentStep == index ? "active" : currentStep > index ? "complete" : null)">
                    <span>@(currentStep > index ? "✓" : (index + 1).ToString())</span>
                    <small>@steps[index]</small>
                </div>
                @if (index < steps.Length - 1)
                {
                    <i class="setup-step-line @(currentStep > index ? "complete" : null)"></i>
                }
            }
        </div>

        @if (statusChecked && !needsSetup && error is null && !installing)
        {
            <div class="inline-alert success" role="status">
                <Icon Name="circle-check" Size="18" />
                <span>系统已经完成初始化。</span>
                <a class="text-link" href="/login">前往登录</a>
            </div>
        }
        else if (!statusChecked)
        {
            <LoadingState Text="正在检查安装状态" />
        }
        else if (statusProbeFailed)
        {
            <ErrorState Message="@(error ?? "无法读取 Go 服务的安装状态。")" OnRetry="CheckStatusAsync" />
        }
        else if (installSuccess)
        {
            <div class="setup-success" role="status">
                <span class="setup-success-icon"><Icon Name="circle-check" Size="28" /></span>
                <h2>@(serviceReady ? "安装完成" : "服务正在重启")</h2>
                <p>@(serviceReady ? "系统已就绪，即将进入登录页。" : "Go 服务正在应用配置，页面会自动等待服务恢复。")</p>
                @if (!serviceReady)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <a class="button primary" href="/login">前往登录</a>
                }
            </div>
        }
        else
        {
            @if (currentStep == 0)
            {
                <div class="setup-form-step">
                    <div class="setup-step-heading"><h2>数据库</h2><p>PostgreSQL 用于保存账户、渠道、用量和配置。</p></div>
                    <div class="form-grid">
                        <div class="form-field"><label for="setup-db-host">主机</label><InputText id="setup-db-host" @bind-Value="database.Host" /></div>
                        <div class="form-field"><label for="setup-db-port">端口</label><InputNumber id="setup-db-port" @bind-Value="database.Port" /></div>
                        <div class="form-field"><label for="setup-db-user">用户名</label><InputText id="setup-db-user" @bind-Value="database.User" /></div>
                        <div class="form-field"><label for="setup-db-password">密码</label><InputText id="setup-db-password" type="password" autocomplete="new-password" @bind-Value="database.Password" /></div>
                        <div class="form-field"><label for="setup-db-name">数据库名</label><InputText id="setup-db-name" @bind-Value="database.DatabaseName" /></div>
                        <div class="form-field"><label for="setup-db-ssl">SSL 模式</label><InputSelect id="setup-db-ssl" @bind-Value="database.SslMode"><option value="disable">disable</option><option value="require">require</option><option value="verify-ca">verify-ca</option><option value="verify-full">verify-full</option></InputSelect></div>
                    </div>
                    <button type="button" class="button secondary setup-test-button" disabled="@testingDatabase" @onclick="TestDatabaseAsync"><Icon Name="plug" Size="16" /> @(testingDatabase ? "正在测试…" : databaseConnected ? "数据库连接成功" : "测试数据库连接")</button>
                </div>
            }
            else if (currentStep == 1)
            {
                <div class="setup-form-step">
                    <div class="setup-step-heading"><h2>Redis</h2><p>Redis 用于会话、限流、调度和缓存。</p></div>
                    <div class="form-grid">
                        <div class="form-field"><label for="setup-redis-host">主机</label><InputText id="setup-redis-host" @bind-Value="redis.Host" /></div>
                        <div class="form-field"><label for="setup-redis-port">端口</label><InputNumber id="setup-redis-port" @bind-Value="redis.Port" /></div>
                        <div class="form-field"><label for="setup-redis-user">用户名（可选）</label><InputText id="setup-redis-user" @bind-Value="redis.Username" /></div>
                        <div class="form-field"><label for="setup-redis-password">密码（可选）</label><InputText id="setup-redis-password" type="password" autocomplete="new-password" @bind-Value="redis.Password" /></div>
                        <div class="form-field"><label for="setup-redis-db">数据库编号</label><InputNumber id="setup-redis-db" @bind-Value="redis.Db" /></div>
                        <label class="toggle-row"><InputCheckbox @bind-Value="redis.EnableTls" /><span><strong>启用 TLS</strong><small>仅在 Redis 服务端启用 TLS 时勾选。</small></span></label>
                    </div>
                    <button type="button" class="button secondary setup-test-button" disabled="@testingRedis" @onclick="TestRedisAsync"><Icon Name="plug" Size="16" /> @(testingRedis ? "正在测试…" : redisConnected ? "Redis 连接成功" : "测试 Redis 连接")</button>
                </div>
            }
            else if (currentStep == 2)
            {
                <div class="setup-form-step">
                    <div class="setup-step-heading"><h2>管理员账户</h2><p>该账户用于登录管理台，请使用强密码。</p></div>
                    <div class="form-grid single-column">
                        <div class="form-field"><label for="setup-admin-email">管理员邮箱</label><InputText id="setup-admin-email" type="email" autocomplete="username" @bind-Value="admin.Email" /></div>
                        <div class="form-field"><label for="setup-admin-password">管理员密码</label><InputText id="setup-admin-password" type="password" autocomplete="new-password" @bind-Value="admin.Password" /></div>
                        <div class="form-field"><label for="setup-admin-confirm">确认密码</label><InputText id="setup-admin-confirm" type="password" autocomplete="new-password" @bind-Value="confirmPassword" /></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(adminError)) { <div class="inline-alert warning" role="alert"><Icon Name="alert" Size="18" /><span>@adminError</span></div> }
                </div>
            }
            else
            {
                <div class="setup-form-step">
                    <div class="setup-step-heading"><h2>确认安装</h2><p>确认以下配置后，Go 服务会写入配置并重启。</p></div>
                    <div class="setup-summary"><div><span>PostgreSQL</span><strong>@($"{database.User}@{database.Host}:{database.Port}/{database.DatabaseName}")</strong></div><div><span>Redis</span><strong>@($"{redis.Host}:{redis.Port}（DB {redis.Db}）")</strong></div><div><span>管理员</span><strong>@admin.Email</strong></div></div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@error</span></div>
            }
            <div class="setup-actions">
                <button type="button" class="button secondary" disabled="@(currentStep == 0 || busy)" @onclick="PreviousStep"><Icon Name="chevron-left" Size="16" /> 上一步</button>
                @if (currentStep < steps.Length - 1)
                {
                    <button type="button" class="button primary" disabled="@(!CanProceed || busy)" @onclick="NextStep">下一步 <Icon Name="chevron-right" Size="16" /></button>
                }
                else
                {
                    <button type="button" class="button primary" disabled="@(busy || installing)" @onclick="InstallAsync"><Icon Name="check" Size="16" /> @(installing ? "正在安装…" : "完成安装")</button>
                }
            </div>
        }
    </section>
</div>

@code {
    private static readonly string[] steps = ["数据库", "Redis", "管理员", "确认"];
    private readonly SetupDatabaseInput database = new();
    private readonly SetupRedisInput redis = new();
    private readonly SetupAdminInput admin = new();
    private readonly SetupServerInput server = new();
    private string confirmPassword = string.Empty;
    private int currentStep;
    private bool statusChecked;
    private bool needsSetup;
    private bool databaseConnected;
    private bool redisConnected;
    private bool testingDatabase;
    private bool testingRedis;
    private bool installing;
    private bool installSuccess;
    private bool serviceReady;
    private bool busy;
    private bool statusProbeFailed;
    private string? error;
    private CancellationTokenSource? pollingCancellation;

    private bool CanProceed => currentStep switch
    {
        0 => databaseConnected,
        1 => redisConnected,
        2 => IsAdminValid,
        _ => true
    };

    private bool IsAdminValid => new EmailAddressAttribute().IsValid(admin.Email)
        && admin.Password.Length is >= 8 and <= 128
        && string.Equals(admin.Password, confirmPassword, StringComparison.Ordinal);

    private string? adminError => !string.IsNullOrWhiteSpace(admin.Email) && !new EmailAddressAttribute().IsValid(admin.Email)
        ? "请输入有效的邮箱地址。"
        : admin.Password.Length > 0 && admin.Password.Length < 8
            ? "管理员密码至少需要 8 个字符。"
            : !string.IsNullOrWhiteSpace(confirmPassword) && !string.Equals(admin.Password, confirmPassword, StringComparison.Ordinal)
                ? "两次输入的密码不一致。"
                : null;

    protected override async Task OnInitializedAsync()
    {
        await CheckStatusAsync();
    }

    private async Task CheckStatusAsync()
    {
        statusChecked = false;
        statusProbeFailed = false;
        error = null;
        server.Port = 8080;
        try
        {
            var value = await Api.GetSetupStatusAsync();
            needsSetup = value.ValueKind == JsonValueKind.Object
                && value.TryGetProperty("needs_setup", out var needs)
                && needs.ValueKind == JsonValueKind.True;
            statusChecked = true;
            if (!needsSetup) serviceReady = true;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            statusProbeFailed = true;
            statusChecked = true;
        }
    }

    private async Task TestDatabaseAsync()
    {
        testingDatabase = true; databaseConnected = false; error = null;
        try { await Api.TestSetupDatabaseAsync(database); databaseConnected = true; }
        catch (ApiException ex) { error = ex.Message; }
        finally { testingDatabase = false; }
    }

    private async Task TestRedisAsync()
    {
        testingRedis = true; redisConnected = false; error = null;
        try { await Api.TestSetupRedisAsync(redis); redisConnected = true; }
        catch (ApiException ex) { error = ex.Message; }
        finally { testingRedis = false; }
    }

    private void NextStep()
    {
        error = null;
        if (CanProceed && currentStep < steps.Length - 1) currentStep++;
    }

    private void PreviousStep()
    {
        error = null;
        if (currentStep > 0) currentStep--;
    }

    private async Task InstallAsync()
    {
        if (!needsSetup || !CanProceed) return;
        installing = true; busy = true; error = null;
        try
        {
            await Api.InstallSetupAsync(new SetupInstallInput { Database = database, Redis = redis, Admin = admin, Server = server });
            installSuccess = true;
            _ = WaitForServiceAsync();
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { installing = false; busy = false; }
    }

    private async Task WaitForServiceAsync()
    {
        pollingCancellation = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), pollingCancellation.Token);
            for (var attempt = 0; attempt < 60 && !pollingCancellation.IsCancellationRequested; attempt++)
            {
                try
                {
                    var value = await Api.GetSetupStatusAsync();
                    var stillNeedsSetup = value.ValueKind == JsonValueKind.Object
                        && value.TryGetProperty("needs_setup", out var needs)
                        && needs.ValueKind == JsonValueKind.True;
                    if (!stillNeedsSetup)
                    {
                        serviceReady = true;
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(1200, pollingCancellation.Token);
                        Navigation.NavigateTo("/login", replace: true);
                        return;
                    }
                }
                catch (ApiException) { }
                await Task.Delay(TimeSpan.FromSeconds(1), pollingCancellation.Token);
            }
            error = "服务未能在 60 秒内恢复，请检查 Go 服务日志后刷新页面。";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        pollingCancellation?.Cancel();
        pollingCancellation?.Dispose();
    }
}
