@page "/admin/settings"
@using System.Text.Json
@using ParaGateway.Frontend.Models
@inject ApiClient Api
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>系统设置 · ParaGateway</PageTitle>

<div class="settings-page">
    <header class="settings-heading">
        <div><span>系统配置</span><h1>系统设置</h1><p>配置站点、安全、用户默认值、网关行为、邮件和备份。敏感字段仅显示配置状态，不会回显服务端明文。</p></div>
        <button type="button" class="button secondary" disabled="@loading" @onclick="LoadAsync"><Icon Name="refresh" Size="16" />刷新</button>
    </header>

    <nav class="settings-tabs" role="tablist" aria-label="系统设置">
        @foreach (var tab in Tabs)
        {
            <button type="button" id="settings-tab-@tab.Id" role="tab" aria-selected="@(activeTab == tab.Id)" class="@(activeTab == tab.Id ? "active" : null)" @onclick="() => activeTab = tab.Id"><Icon Name="@tab.Icon" Size="16" />@tab.Label</button>
        }
    </nav>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="17" /><span>@error</span><button type="button" @onclick="LoadAsync">重试</button></div>
    }

    @if (loading)
    {
        <LoadingState Text="正在载入系统设置" />
    }
    else
    {
        <main class="settings-content">
            @if (activeTab == "general")
            {
                <section class="settings-card">
                    <header><div><h2>站点与品牌</h2><p>控制公共首页、文档入口和表格默认展示。</p></div></header>
                    <div class="settings-grid">
                        <Field Label="站点名称"><InputText @bind-Value="settings.SiteName" /></Field>
                        <Field Label="站点副标题"><InputText @bind-Value="settings.SiteSubtitle" /></Field>
                        <Field Label="Logo 地址" Full="true"><InputText @bind-Value="settings.SiteLogo" /></Field>
                        <Field Label="API 基础地址"><InputText @bind-Value="settings.ApiBaseUrl" /></Field>
                        <Field Label="文档地址"><InputText @bind-Value="settings.DocUrl" /></Field>
                        <Field Label="联系信息" Full="true"><InputText @bind-Value="settings.ContactInfo" /></Field>
                        <Field Label="首页内容" Full="true"><InputTextArea @bind-Value="settings.HomeContent" rows="7" /></Field>
                        <Field Label="表格默认每页"><InputNumber @bind-Value="settings.TableDefaultPageSize" /></Field>
                        <Field Label="表格页数选项（逗号分隔）"><InputText @bind-Value="pageSizeOptionsText" /></Field>
                        <ToggleField Label="紧凑首页" Hint="为已登录用户使用紧凑工作台布局"><InputCheckbox @bind-Value="settings.CompactHomeEnabled" /></ToggleField>
                        <ToggleField Label="隐藏 CCS 导入入口" Hint="不在上游账号页面显示 CCS 导入按钮"><InputCheckbox @bind-Value="settings.HideCcsImportButton" /></ToggleField>
                        <ToggleField Label="后端模式" Hint="由 Go 服务控制精简模式访问边界"><InputCheckbox @bind-Value="settings.BackendModeEnabled" /></ToggleField>
                    </div>
                </section>
                <CustomNavigationSettings Endpoints="settings.CustomEndpoints" MenuItems="settings.CustomMenuItems" />
            }
            else if (activeTab == "agreement")
            {
                <section class="settings-card">
                    <header><div><h2>登录协议</h2><p>控制登录时展示的服务协议和隐私文档；管理员合规确认弹窗仍按 ParaGateway 要求保持关闭。</p></div></header>
                    <div class="settings-grid">
                        <ToggleField Label="启用登录协议" Hint="用户登录前必须查看或确认协议"><InputCheckbox @bind-Value="settings.LoginAgreementEnabled" /></ToggleField>
                        <Field Label="确认模式"><InputSelect @bind-Value="settings.LoginAgreementMode"><option value="modal">弹窗确认</option><option value="checkbox">勾选确认</option></InputSelect></Field>
                        <Field Label="条款更新日期" Hint="日期或内容变化后，用户需要重新同意"><input type="date" value="@settings.LoginAgreementUpdatedAt" @onchange="args => settings.LoginAgreementUpdatedAt = args.Value?.ToString() ?? string.Empty" /></Field>
                    </div>
                </section>
                <AgreementDocumentsEditor Documents="settings.LoginAgreementDocuments" Enabled="settings.LoginAgreementEnabled" />
            }
            else if (activeTab == "features")
            {
                <section class="settings-card">
                    <header><div><h2>功能开关</h2><p>对应官方侧栏和公共功能入口；支付功能已按要求排除。</p></div></header>
                    <div class="settings-grid">
                        <ToggleField Label="Ops 监控" Hint="采集并展示网关运维指标"><InputCheckbox @bind-Value="settings.OpsMonitoringEnabled" /></ToggleField>
                        <ToggleField Label="实时监控" Hint="启用 Ops WebSocket 实时指标"><InputCheckbox @bind-Value="settings.OpsRealtimeMonitoringEnabled" /></ToggleField>
                        <Field Label="Ops 查询模式"><InputSelect @bind-Value="settings.OpsQueryModeDefault"><option value="auto">自动</option><option value="raw">原始日志</option><option value="preagg">预聚合</option></InputSelect></Field>
                        <Field Label="指标采集间隔（秒）"><InputNumber @bind-Value="settings.OpsMetricsIntervalSeconds" /></Field>
                        <ToggleField Label="渠道监控" Hint="开放渠道监控页及后台任务"><InputCheckbox @bind-Value="settings.ChannelMonitorEnabled" /></ToggleField>
                        <Field Label="渠道监控模式"><InputSelect @bind-Value="settings.ChannelMonitorMode"><option value="v1">V1 主动探测</option><option value="v2">V2 被动聚合</option></InputSelect></Field>
                        <Field Label="默认探测间隔（秒）"><InputNumber @bind-Value="settings.ChannelMonitorDefaultIntervalSeconds" /></Field>
                        <ToggleField Label="隐藏吞吐量" Hint="对非管理员隐藏绝对吞吐数值"><InputCheckbox @bind-Value="settings.ChannelMonitorHideThroughput" /></ToggleField>
                        @if (settings.ChannelMonitorMode == "v1")
                        {
                            <ToggleField Label="用户端展示配额快照" Hint="允许用户在渠道状态页查看账号最近一次配额或余额快照"><InputCheckbox @bind-Value="settings.ChannelMonitorShowQuota" /></ToggleField>
                        }
                        <ToggleField Label="可用渠道" Hint="允许用户查看当前可用渠道"><InputCheckbox @bind-Value="settings.AvailableChannelsEnabled" /></ToggleField>
                        <ToggleField Label="模型广场" Hint="开放模型目录页"><InputCheckbox @bind-Value="settings.ModelPlazaEnabled" /></ToggleField>
                        <ToggleField Label="模型广场要求登录" Hint="未登录用户不能访问模型目录"><InputCheckbox @bind-Value="settings.ModelPlazaRequireAuth" /></ToggleField>
                        <ToggleField Label="风险控制" Hint="开放内容审计与风控处理"><InputCheckbox @bind-Value="settings.RiskControlEnabled" /></ToggleField>
                        <ToggleField Label="邀请返利" Hint="开放邀请与返利功能"><InputCheckbox @bind-Value="settings.AffiliateEnabled" /></ToggleField>
                        <ToggleField Label="Cyber 会话屏蔽" Hint="对命中 Cyber 风控规则的会话执行临时屏蔽"><InputCheckbox @bind-Value="settings.CyberSessionBlockEnabled" /></ToggleField>
                        @if (settings.CyberSessionBlockEnabled)
                        {
                            <Field Label="会话屏蔽 TTL（秒）"><InputNumber @bind-Value="settings.CyberSessionBlockTtlSeconds" min="1" /></Field>
                        }
                        @if (settings.AffiliateEnabled)
                        {
                            <ToggleField Label="管理员充值计入返利" Hint="管理员为被邀请用户充值时也产生邀请返利"><InputCheckbox @bind-Value="settings.AffiliateAdminRechargeEnabled" /></ToggleField>
                            <Field Label="返利比例（%）"><InputNumber @bind-Value="settings.AffiliateRebateRate" min="0" max="100" step="0.01" /></Field>
                            <Field Label="返利冻结时间（小时）"><InputNumber @bind-Value="settings.AffiliateRebateFreezeHours" min="0" max="720" /></Field>
                            <Field Label="返利有效期（天）" Hint="0 表示长期有效"><InputNumber @bind-Value="settings.AffiliateRebateDurationDays" min="0" max="3650" /></Field>
                            <Field Label="单个受邀人返利上限" Hint="0 表示不限制"><InputNumber @bind-Value="settings.AffiliateRebatePerInviteeCap" min="0" step="0.01" /></Field>
                        }
                        <Field Label="模型广场说明" Full="true"><InputTextArea @bind-Value="settings.ModelPlazaDescription" rows="4" /></Field>
                    </div>
                </section>
            }
            else if (activeTab == "security")
            {
                <section class="settings-card admin-key-card">
                    <header><div><h2>管理员 API Key</h2><p>用于机器调用管理接口。完整密钥只在创建或重新生成后显示一次。</p></div></header>
                    @if (!adminApiKey.Exists)
                    {
                        <div class="empty-secret"><span>尚未配置管理员 API Key</span><button type="button" class="button primary" disabled="@adminKeyBusy" @onclick="GenerateAdminApiKeyAsync">创建密钥</button></div>
                    }
                    else
                    {
                        <div class="secret-status"><code>@adminApiKey.MaskedKey</code><div><button type="button" class="button secondary" disabled="@adminKeyBusy" @onclick="GenerateAdminApiKeyAsync">重新生成</button><button type="button" class="button danger" disabled="@adminKeyBusy" @onclick="DeleteAdminApiKeyAsync">删除</button></div></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(generatedAdminApiKey))
                    {
                        <div class="generated-secret"><div><b>请立即保存，此密钥关闭后无法再次查看</b><code>@generatedAdminApiKey</code></div><button type="button" class="button primary" @onclick="CopyAdminApiKeyAsync"><Icon Name="copy" Size="15" />复制密钥</button></div>
                    }
                </section>
                <section class="settings-card">
                    <header><div><h2>注册与会话安全</h2><p>影响新用户注册、二次验证、会话绑定和审计保留。</p></div></header>
                    <div class="settings-grid">
                        <ToggleField Label="开放注册" Hint="允许新用户创建账户"><InputCheckbox @bind-Value="settings.RegistrationEnabled" /></ToggleField>
                        <ToggleField Label="注册邮箱验证" Hint="新用户必须完成邮箱验证"><InputCheckbox @bind-Value="settings.EmailVerifyEnabled" /></ToggleField>
                        <ToggleField Label="邮箱域名配额" Hint="启用按邮箱域名限制注册数量"><InputCheckbox @bind-Value="settings.RegistrationEmailDomainQuotaEnabled" /></ToggleField>
                        <ToggleField Label="注册优惠码" Hint="注册流程显示优惠码输入"><InputCheckbox @bind-Value="settings.PromoCodeEnabled" /></ToggleField>
                        <ToggleField Label="邀请码注册" Hint="注册时必须提交邀请码"><InputCheckbox @bind-Value="settings.InvitationCodeEnabled" /></ToggleField>
                        <ToggleField Label="允许重置密码" Hint="开放忘记密码流程"><InputCheckbox @bind-Value="settings.PasswordResetEnabled" /></ToggleField>
                        <ToggleField Label="TOTP 双因素认证" Hint="@(settings.TotpEncryptionKeyConfigured ? "加密密钥已配置" : "尚未配置 TOTP 加密密钥")"><InputCheckbox @bind-Value="settings.TotpEnabled" /></ToggleField>
                        <ToggleField Label="Passkey 登录" Hint="@(settings.PasskeyConfigured ? $"RP ID：{settings.PasskeyRpId}" : "尚未完成 Passkey 部署配置")"><InputCheckbox @bind-Value="settings.PasskeyEnabled" /></ToggleField>
                        <ToggleField Label="敏感操作二次确认" Hint="备份、恢复及高风险修改要求 step-up"><InputCheckbox @bind-Value="settings.StepUpEnabled" /></ToggleField>
                        <ToggleField Label="会话绑定" Hint="绑定登录 IP 与 User-Agent"><InputCheckbox @bind-Value="settings.SessionBindingEnabled" /></ToggleField>
                        <Field Label="审计日志保留天数"><InputNumber @bind-Value="settings.AuditLogRetentionDays" /></Field>
                        <Field Label="前端地址"><InputText @bind-Value="settings.FrontendUrl" /></Field>
                        <Field Label="注册邮箱后缀白名单" Hint="多个后缀用逗号分隔" Full="true"><InputText @bind-Value="suffixText" /></Field>
                    </div>
                </section>
                <section class="settings-card">
                    <header><div><h2>面板 API 限流</h2><p>保护用户面板及公共接口，限制值由 Go 服务实时执行。</p></div><button type="button" class="button primary small" disabled="@runtimeSaving" @onclick="SavePanelRateLimitAsync">保存此项</button></header>
                    <div class="settings-grid">
                        <ToggleField Label="启用面板限流" Hint="按用户或来源 IP 执行分钟窗口"><InputCheckbox @bind-Value="panelRateLimit.Enabled" /></ToggleField>
                        <ToggleField Label="管理员豁免" Hint="JWT 管理员不受普通面板限流"><InputCheckbox @bind-Value="panelRateLimit.ExemptAdmin" /></ToggleField>
                        <Field Label="用户 RPM"><InputNumber @bind-Value="panelRateLimit.UserRpm" /></Field>
                        <Field Label="重接口 RPM"><InputNumber @bind-Value="panelRateLimit.HeavyRpm" /></Field>
                        <Field Label="公共接口 IP RPM"><InputNumber @bind-Value="panelRateLimit.PublicIpRpm" /></Field>
                    </div>
                </section>
                <SecurityAdvancedSettings Settings="settings" Secrets="securitySecrets" />
            }
            else if (activeTab == "users")
            {
                <UserDefaultsSettings Settings="settings" />
            }
            else if (activeTab == "gateway")
            {
                <section class="settings-card">
                    <header><div><h2>529 过载冷却</h2><p>上游返回 529 时暂停账号调度，避免持续打满过载节点。</p></div><button type="button" class="button primary small" disabled="@runtimeSaving" @onclick="SaveOverloadAsync">保存此项</button></header>
                    <div class="settings-grid"><ToggleField Label="启用 529 冷却" Hint="由账号调度器自动标记临时不可用"><InputCheckbox @bind-Value="overloadCooldown.Enabled" /></ToggleField><Field Label="冷却时间（分钟）"><InputNumber @bind-Value="overloadCooldown.CooldownMinutes" /></Field></div>
                </section>
                <section class="settings-card">
                    <header><div><h2>429 默认回避</h2><p>无法解析上游重置时间时使用默认冷却窗口。</p></div><button type="button" class="button primary small" disabled="@runtimeSaving" @onclick="SaveRateLimit429Async">保存此项</button></header>
                    <div class="settings-grid"><ToggleField Label="启用 429 冷却" Hint="避免立刻重试同一个限流账号"><InputCheckbox @bind-Value="rateLimit429.Enabled" /></ToggleField><Field Label="冷却时间（秒）"><InputNumber @bind-Value="rateLimit429.CooldownSeconds" /></Field></div>
                </section>
                <section class="settings-card">
                    <header><div><h2>流超时处理</h2><p>连续流式请求超时达到阈值后执行指定动作。</p></div><button type="button" class="button primary small" disabled="@runtimeSaving" @onclick="SaveStreamTimeoutAsync">保存此项</button></header>
                    <div class="settings-grid">
                        <ToggleField Label="启用流超时处理" Hint="按账号累计滑动窗口"><InputCheckbox @bind-Value="streamTimeout.Enabled" /></ToggleField>
                        <Field Label="处理动作"><InputSelect @bind-Value="streamTimeout.Action"><option value="temp_unsched">临时停止调度</option><option value="error">标记账号错误</option><option value="none">仅记录</option></InputSelect></Field>
                        <Field Label="停止调度（分钟）"><InputNumber @bind-Value="streamTimeout.TempUnschedMinutes" /></Field>
                        <Field Label="触发次数"><InputNumber @bind-Value="streamTimeout.ThresholdCount" /></Field>
                        <Field Label="统计窗口（分钟）"><InputNumber @bind-Value="streamTimeout.ThresholdWindowMinutes" /></Field>
                    </div>
                </section>
                <section class="settings-card">
                    <header><div><h2>请求整流器</h2><p>修复部分客户端缺失的 thinking 与 API Key 签名结构。</p></div><button type="button" class="button primary small" disabled="@runtimeSaving" @onclick="SaveRectifierAsync">保存此项</button></header>
                    <div class="settings-grid">
                        <ToggleField Label="启用整流器" Hint="允许对符合条件的请求进行兼容修正"><InputCheckbox @bind-Value="rectifier.Enabled" /></ToggleField>
                        <ToggleField Label="Thinking Signature" Hint="修正缺失的 thinking 签名"><InputCheckbox @bind-Value="rectifier.ThinkingSignatureEnabled" /></ToggleField>
                        <ToggleField Label="Thinking Budget" Hint="修正 thinking budget"><InputCheckbox @bind-Value="rectifier.ThinkingBudgetEnabled" /></ToggleField>
                        <ToggleField Label="API Key Signature" Hint="按自定义关键词识别客户端"><InputCheckbox @bind-Value="rectifier.ApiKeySignatureEnabled" /></ToggleField>
                        <Field Label="API Key 匹配关键词" Hint="每行一个，最多 50 条" Full="true"><InputTextArea @bind-Value="rectifierPatternsText" rows="7" /></Field>
                    </div>
                </section>
                <BetaPolicySettings />
                <AccountUsageRuntimeSettings />
                <WebSearchSettings />
                <GatewayAdvancedSettings Settings="settings" />
            }
            else if (activeTab == "email")
            {
                <section class="settings-card">
                    <header>
                        <div><h2>SMTP 邮件</h2><p>配置系统邮件发送。密码留空时测试和保存都会复用服务端现有密钥。</p></div>
                        <div class="card-header-actions"><button type="button" class="button secondary small" disabled="@smtpBusy" @onclick="TestSmtpAsync">测试连接</button><button type="button" class="button primary small" disabled="@(smtpBusy || string.IsNullOrWhiteSpace(testEmailAddress))" @onclick="SendTestEmailAsync">发送测试邮件</button></div>
                    </header>
                    <div class="settings-grid">
                        <Field Label="SMTP 主机"><InputText @bind-Value="settings.SmtpHost" /></Field>
                        <Field Label="SMTP 端口"><InputNumber @bind-Value="settings.SmtpPort" /></Field>
                        <Field Label="SMTP 用户名"><InputText @bind-Value="settings.SmtpUsername" /></Field>
                        <Field Label="SMTP 密码" Hint="@(settings.SmtpPasswordConfigured ? "已配置；留空保留" : "尚未配置")"><input type="password" autocomplete="new-password" @bind="smtpPassword" /></Field>
                        <Field Label="发件地址"><InputText @bind-Value="settings.SmtpFromEmail" /></Field>
                        <Field Label="发件名称"><InputText @bind-Value="settings.SmtpFromName" /></Field>
                        <ToggleField Label="使用 TLS" Hint="连接 SMTP 时协商 TLS"><InputCheckbox @bind-Value="settings.SmtpUseTls" /></ToggleField>
                        <Field Label="测试收件地址" Hint="只用于当前测试，不会保存"><input type="email" autocomplete="email" @bind="testEmailAddress" @bind:event="oninput" /></Field>
                    </div>
                </section>
                <NotificationSettings Settings="settings" />
                <EmailTemplateEditor />
            }
            else if (activeTab == "backup")
            {
                <section class="settings-card backup-links">
                    <header><div><h2>备份与数据管理</h2><p>备份目标修改、下载和恢复属于敏感操作，由 Go 后端执行 step-up 2FA。</p></div></header>
                    <div><a class="backup-link" href="/admin/data-management"><Icon Name="database" Size="22" /><span><b>数据管理</b><small>Agent 状态、来源配置、S3 档案与备份任务</small></span><Icon Name="chevron-right" /></a><a class="backup-link" href="/admin/backups"><Icon Name="box" Size="22" /><span><b>备份管理</b><small>S3、定时备份、下载、恢复及删除</small></span><Icon Name="chevron-right" /></a></div>
                </section>
            }
        </main>

        @if (activeTab != "backup")
        {
            <footer class="settings-savebar"><div><b>保存通用设置</b><span>密钥输入仅在非空时提交；未显示字段保持服务端原值。</span></div><button type="button" class="button primary" disabled="@saving" @onclick="SaveAsync"><Icon Name="save" Size="16" />@(saving ? "正在保存…" : "保存设置")</button></footer>
        }
    }
</div>

@code {
    private static readonly (string Id, string Label, string Icon)[] Tabs =
    [
        ("general", "常规", "dashboard"), ("agreement", "用户协议", "file-text"), ("features", "功能", "sparkles"),
        ("security", "安全", "shield"), ("users", "用户", "user"), ("gateway", "网关", "server"),
        ("email", "邮件", "bell"), ("backup", "备份", "database")
    ];
    private static readonly JsonSerializerOptions WebJson = new(JsonSerializerDefaults.Web) { PropertyNameCaseInsensitive = true };
    private static readonly string[] AuthSourceIds = ["email", "linuxdo", "oidc", "wechat", "github", "google", "dingtalk"];
    private static readonly string[] QuotaPlatforms = ["anthropic", "openai", "gemini", "antigravity", "grok"];
    private static readonly string[] SchedulingThresholdPlatforms = ["openai", "anthropic", "grok", "kimi", "zhipu"];

    private AdminSettingsDto settings = new();
    private AdminApiKeyStatusDto adminApiKey = new();
    private OverloadCooldownSettingsDto overloadCooldown = new();
    private RateLimit429CooldownSettingsDto rateLimit429 = new();
    private PanelRateLimitSettingsDto panelRateLimit = new();
    private StreamTimeoutSettingsDto streamTimeout = new();
    private RectifierSettingsDto rectifier = new();
    private AdminSecuritySecretInputs securitySecrets = new();
    private Dictionary<string, JsonElement> original = new(StringComparer.OrdinalIgnoreCase);
    private string activeTab = "general", suffixText = string.Empty, pageSizeOptionsText = string.Empty, rectifierPatternsText = string.Empty;
    private string smtpPassword = string.Empty, generatedAdminApiKey = string.Empty, testEmailAddress = string.Empty;
    private bool loading = true, saving, runtimeSaving, adminKeyBusy, smtpBusy;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; error = null; generatedAdminApiKey = string.Empty;
        try
        {
            var settingsTask = Api.GetAdminSettingsAsync();
            var keyTask = Api.GetAdminApiKeyStatusAsync();
            var overloadTask = Api.GetOverloadCooldownSettingsAsync();
            var rateTask = Api.GetRateLimit429CooldownSettingsAsync();
            var panelTask = Api.GetPanelRateLimitSettingsAsync();
            var streamTask = Api.GetStreamTimeoutSettingsAsync();
            var rectifierTask = Api.GetRectifierSettingsAsync();
            await Task.WhenAll(settingsTask, keyTask, overloadTask, rateTask, panelTask, streamTask, rectifierTask);

            var raw = await settingsTask;
            original = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(raw.GetRawText(), WebJson) ?? new(StringComparer.OrdinalIgnoreCase);
            settings = raw.Deserialize<AdminSettingsDto>(WebJson) ?? new();
            NormalizeUserDefaults();
            adminApiKey = await keyTask; overloadCooldown = await overloadTask; rateLimit429 = await rateTask;
            panelRateLimit = await panelTask; streamTimeout = await streamTask; rectifier = await rectifierTask;
            suffixText = string.Join(", ", settings.RegistrationEmailSuffixWhitelist);
            pageSizeOptionsText = string.Join(", ", settings.TablePageSizeOptions);
            rectifierPatternsText = string.Join(Environment.NewLine, rectifier.ApiKeySignaturePatterns);
            smtpPassword = string.Empty;
            securitySecrets = new();
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        saving = true; error = null;
        try
        {
            var payload = original.ToDictionary(x => x.Key, x => (object?)x.Value.Clone(), StringComparer.OrdinalIgnoreCase);
            var values = new Dictionary<string, object?>
            {
                ["registration_enabled"] = settings.RegistrationEnabled, ["email_verify_enabled"] = settings.EmailVerifyEnabled,
                ["registration_email_suffix_whitelist"] = SplitDistinct(suffixText), ["registration_email_domain_quota_enabled"] = settings.RegistrationEmailDomainQuotaEnabled,
                ["promo_code_enabled"] = settings.PromoCodeEnabled, ["password_reset_enabled"] = settings.PasswordResetEnabled,
                ["frontend_url"] = settings.FrontendUrl.Trim(), ["invitation_code_enabled"] = settings.InvitationCodeEnabled,
                ["totp_enabled"] = settings.TotpEnabled, ["passkey_enabled"] = settings.PasskeyEnabled, ["session_binding_enabled"] = settings.SessionBindingEnabled,
