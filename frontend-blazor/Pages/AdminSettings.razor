    private async Task ReloadGenericStateAsync()
    {
        var raw = await Api.GetAdminSettingsAsync();
        original = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(raw.GetRawText(), WebJson) ?? original;
        settings = raw.Deserialize<AdminSettingsDto>(WebJson) ?? settings;
        NormalizeUserDefaults();
        suffixText = string.Join(", ", settings.RegistrationEmailSuffixWhitelist);
        pageSizeOptionsText = string.Join(", ", settings.TablePageSizeOptions);
    }

    private async Task GenerateAdminApiKeyAsync()
    {
        if (adminApiKey.Exists && !await JS.InvokeAsync<bool>("confirm", "重新生成后，旧管理员 API Key 会立即失效。确认继续？")) return;
        adminKeyBusy = true; error = null;
        try { var generated = await Api.RegenerateAdminApiKeyAsync(); generatedAdminApiKey = generated.Key; adminApiKey = await Api.GetAdminApiKeyStatusAsync(); Toasts.Success("管理员 API Key 已生成"); }
        catch (ApiException ex) { error = ex.Message; }
        finally { adminKeyBusy = false; }
    }

