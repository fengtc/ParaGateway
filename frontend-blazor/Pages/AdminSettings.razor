    private static List<string> SplitDistinct(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static List<int> SplitPositiveIntegers(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(x => int.TryParse(x, out var number) ? number : 0).Where(x => x > 0).Distinct().Order().ToList();
    private static List<DefaultSubscriptionSettingDto> SanitizeSubscriptions(IEnumerable<DefaultSubscriptionSettingDto> items) => items
        .Where(item => item.GroupId > 0 && item.ValidityDays > 0)
        .GroupBy(item => item.GroupId)
        .Select(group => new DefaultSubscriptionSettingDto { GroupId = group.Key, ValidityDays = Math.Clamp(group.First().ValidityDays, 1, 36500) })
        .ToList();

    private static Dictionary<string, PlatformQuotaLimitsDto> NormalizePlatformQuotas(Dictionary<string, PlatformQuotaLimitsDto>? quotas)
    {
        var normalized = new Dictionary<string, PlatformQuotaLimitsDto>(StringComparer.OrdinalIgnoreCase);
        foreach (var platform in QuotaPlatforms)
        {
            PlatformQuotaLimitsDto? quota = null;
            if (quotas is not null) quotas.TryGetValue(platform, out quota);
            normalized[platform] = new PlatformQuotaLimitsDto
            {
                Daily = quota?.Daily is >= 0 ? quota.Daily : null,
                Weekly = quota?.Weekly is >= 0 ? quota.Weekly : null,
                Monthly = quota?.Monthly is >= 0 ? quota.Monthly : null
            };
        }
        return normalized;
    }

    private static Dictionary<string, int> NormalizeSchedulingThresholds(Dictionary<string, int>? thresholds)
    {
        var normalized = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var platform in SchedulingThresholdPlatforms)
        {
            normalized[platform] = thresholds is not null && thresholds.TryGetValue(platform, out var value)
                ? Math.Clamp(value, 1, 100)
                : 100;
        }
        return normalized;
    }

    private void NormalizeUserDefaults()
    {
        settings.DefaultSubscriptions ??= [];
        settings.DefaultPlatformQuotas = NormalizePlatformQuotas(settings.DefaultPlatformQuotas);
        settings.AccountSchedulingThresholds = NormalizeSchedulingThresholds(settings.AccountSchedulingThresholds);
        settings.AuthSourceDefaults = new(StringComparer.OrdinalIgnoreCase);
        foreach (var sourceId in AuthSourceIds)
        {
            settings.AuthSourceDefaults[sourceId] = new AuthSourceDefaultsDto
            {
                Balance = ReadExtra($"auth_source_default_{sourceId}_balance", 0m),
                Concurrency = Math.Max(1, ReadExtra($"auth_source_default_{sourceId}_concurrency", 5)),
                Subscriptions = ReadExtra($"auth_source_default_{sourceId}_subscriptions", new List<DefaultSubscriptionSettingDto>()),
                GrantOnSignup = ReadExtra($"auth_source_default_{sourceId}_grant_on_signup", false),
                GrantOnFirstBind = ReadExtra($"auth_source_default_{sourceId}_grant_on_first_bind", false),
                PlatformQuotas = NormalizePlatformQuotas(ReadExtra($"auth_source_default_{sourceId}_platform_quotas", new Dictionary<string, PlatformQuotaLimitsDto>()))
            };
        }
    }

    private T ReadExtra<T>(string key, T fallback)
    {
        if (settings.Extra is null || !settings.Extra.TryGetValue(key, out var value)) return fallback;
        try { return value.Deserialize<T>(WebJson) ?? fallback; }
        catch (JsonException) { return fallback; }
    }

    private static string FirstNonEmpty(params string[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;
    private static void AddSecretIfPresent(Dictionary<string, object?> payload, string key, string value)
    {
        if (!string.IsNullOrWhiteSpace(value)) payload[key] = value;
    }

    private static string NormalizeDocumentSlug(string value, int index)
    {
        var normalized = new string((value ?? string.Empty).Trim().ToLowerInvariant().Select(character => char.IsLetterOrDigit(character) || character is '-' or '_' ? character : '-').ToArray()).Trim('-', '_');
        return string.IsNullOrWhiteSpace(normalized) ? $"document-{index + 1}" : normalized;
    }
