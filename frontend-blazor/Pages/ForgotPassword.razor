@page "/forgot-password"
@layout AuthLayout
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>找回密码 · ParaGateway</PageTitle>

<div class="login-page">
    <div class="login-brand"><BrandMark /><span><strong>ParaGateway</strong></span></div>
    <section class="login-panel">
        @if (submitted)
        {
            <header><h1>邮件已发送</h1><p>如果邮箱已注册，稍后会收到密码重置链接。</p></header>
            <div class="inline-alert success" role="status"><Icon Name="circle-check" Size="18" /><span>请检查收件箱和垃圾邮件文件夹。</span></div>
            <a class="button primary login-button" href="/login">返回登录</a>
        }
        else
        {
            <header><h1>找回密码</h1><p>输入注册邮箱，我们会发送一次性重置链接。</p></header>
            @if (error is not null) { <div class="inline-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@error</span></div> }
            <EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="forgot-password">
                <DataAnnotationsValidator />
                <div class="form-field"><label for="forgot-email">邮箱</label><InputText id="forgot-email" @bind-Value="form.Email" type="email" autocomplete="email" /><ValidationMessage For="() => form.Email" /></div>
                <CaptchaChallenge @ref="captcha" TurnstileEnabled="settings.TurnstileEnabled" TurnstileSiteKey="settings.TurnstileSiteKey" TencentEnabled="settings.TencentCaptchaEnabled" TencentAppId="settings.TencentCaptchaAppId" TencentRegion="settings.TencentCaptchaRegion" AliyunEnabled="settings.AliyunCaptchaEnabled" AliyunSceneId="settings.AliyunCaptchaSceneId" AliyunPrefix="settings.AliyunCaptchaPrefix" AliyunRegion="settings.AliyunCaptchaRegion" />
                <button type="submit" class="button primary login-button" disabled="@busy">@(busy ? "正在发送…" : "发送重置链接")</button>
            </EditForm>
            <div class="auth-footer"><a href="/login">返回登录</a></div>
        }
    </section>
</div>

@code {
    private readonly ForgotPasswordRequest form = new();
    private bool busy;
    private bool submitted;
    private string? error;
    private PublicSettingsDto settings = new();
    private CaptchaChallenge? captcha;

    protected override async Task OnInitializedAsync()
    {
        try { settings = await Api.GetPublicSettingsAsync(); }
        catch (ApiException) { }
    }

    private async Task SubmitAsync()
    {
        busy = true; error = null;
        try { form.ApplyCaptcha(captcha is null ? null : await captcha.GetProofAsync()); await Api.ForgotPasswordAsync(form); submitted = true; }
        catch (ApiException ex) { error = ex.Message; }
        finally { if (!submitted && captcha is not null) await captcha.ResetAsync(); busy = false; }
    }
}
