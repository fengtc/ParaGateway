@page "/admin/prompt-audit"
@using ParaGateway.Frontend.Models
@inject ApiClient Api
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>提示词审计 · ParaGateway</PageTitle>

<div class="prompt-page @(activeTab == "config" ? "with-savebar" : null)">
    <header class="prompt-heading">
        <div><span>安全审计</span><h1>提示词审计</h1><p>通过 OpenAI 兼容 Qwen3Guard 节点异步复核或同步阻止用户输入；完整提示词仅供管理员复核。</p></div>
        @if (!loading) { <aside><b>配置版本 v@config.ConfigVersion</b>@if (config.UpdatedAt.HasValue) { <small>@FormatDateTime(config.UpdatedAt)</small> }</aside> }
    </header>

    @if (!string.IsNullOrWhiteSpace(error)) { <div class="inline-alert danger"><Icon Name="alert" Size="17" /><span>@error</span><button type="button" @onclick="LoadAllAsync">重试</button></div> }
    @if (loading) { <LoadingState Text="正在载入提示词审计" /> }
    else
    {
        <nav class="page-tabs" role="tablist" aria-label="提示词审计"><button type="button" role="tab" aria-selected="@(activeTab == "events")" class="@(activeTab == "events" ? "active" : null)" @onclick='() => activeTab = "events"'>事件</button><button type="button" role="tab" aria-selected="@(activeTab == "config")" class="@(activeTab == "config" ? "active" : null)" @onclick='() => activeTab = "config"'>配置</button></nav>
        <main class="prompt-card">
            @if (activeTab == "config")
            {
                <section class="runtime-section">
                    <header class="section-header-row"><div><h2>运行概览</h2><p>显示服务端当前生效状态；未保存的草稿不会改变这些数值。</p></div><button type="button" class="button secondary small" disabled="@runtimeLoading" @onclick="LoadRuntimeAsync"><Icon Name="refresh" Size="15" />刷新运行态</button></header>
                    @if (!string.IsNullOrWhiteSpace(runtimeError)) { <div class="inline-alert danger"><span>@runtimeError</span></div> }
                    else
                    {
                        <div class="runtime-summary"><article><small>进程状态</small><strong><i class="@RuntimeTone(runtime.ProcessStatus)"></i>@StatusLabel(runtime.ProcessStatus)</strong></article><article><small>生效模式</small><strong>@ModeLabel(runtime.EffectiveMode)</strong></article><article><small>生效 / 期望版本</small><strong>@runtime.ActiveConfigVersion / @runtime.ExpectedConfigVersion</strong></article><article><small>活动 / 总 Worker</small><strong>@runtime.WorkerActive / @runtime.WorkerTotal</strong></article><article><small>活动任务 / 容量</small><strong>@runtime.Queue.Active / @runtime.QueueCapacity</strong></article><article><small>依赖</small><strong>DB @runtime.DatabaseStatus · Redis @runtime.RedisStatus</strong></article></div>
                        <div class="runtime-details"><section><h3>同步 Guard 指标</h3><div class="guard-grid"><article><small>总计</small><b>@runtime.GuardMetrics.Total</b></article><article><small>放行</small><b>@runtime.GuardMetrics.Allowed</b></article><article><small>标记</small><b>@runtime.GuardMetrics.Flagged</b></article><article><small>阻止</small><b>@runtime.GuardMetrics.Blocked</b></article><article><small>不可用</small><b>@runtime.GuardMetrics.Unavailable</b></article><article><small>超时</small><b>@runtime.GuardMetrics.Timeouts</b></article><article><small>故障切换</small><b>@runtime.GuardMetrics.Failovers</b></article><article><small>P95</small><b>@Ms(runtime.GuardMetrics.LatencyP95Ms)</b></article></div><p>queued @runtime.Queue.Queued · processing @runtime.Queue.Processing · retry @runtime.Queue.Retry · done @runtime.Queue.Done · failed @runtime.Queue.Failed<br />累计入队 @runtime.EnqueuedTotal · 丢弃 @runtime.DroppedTotal · 处理 @runtime.ProcessedTotal · 失败 @runtime.FailedTotal</p></section><section><h3>最近处理与错误</h3><p class="latest-time">@(runtime.LastProcessedAt.HasValue ? FormatDateTime(runtime.LastProcessedAt) : "从未")</p>@if (!string.IsNullOrWhiteSpace(runtime.LastErrorCode)) { <div class="runtime-error">@runtime.LastErrorCode@if (!string.IsNullOrWhiteSpace(runtime.LastErrorMessage)) { <text> · @runtime.LastErrorMessage</text> }</div> }<div class="runtime-endpoints">@foreach (var item in runtime.Endpoints) { <span class="@(item.Value.Ok ? "success" : "danger")">@item.Key · @item.Value.Status · @item.Value.LatencyMs ms</span> }</div></section></div>
                    }
                </section>

                <section class="pool-section">
                    <header class="section-header-row"><div><h2>审计池</h2><p>按顺序使用启用的 OpenAI 兼容节点；探测由服务端真实网络环境发起。</p></div><button type="button" class="button primary small" @onclick="OpenNewEndpoint"><Icon Name="plus" Size="15" />新增节点</button></header>
                    @if (config.Endpoints.Count == 0) { <div class="pool-empty">尚未配置审计节点。</div> }
                    else
                    {
                        <div class="endpoint-table"><div class="endpoint-head"><span>节点</span><span>模型</span><span>超时 / 单片上限</span><span>凭据与探测</span><span>操作</span></div>@foreach (var endpoint in config.Endpoints) { <article><div class="endpoint-name"><input type="checkbox" checked="@endpoint.Enabled" @onchange="e => ToggleEndpoint(endpoint, e)" /><span><b>@endpoint.Name</b><small title="@endpoint.BaseUrl">@endpoint.BaseUrl</small></span></div><div><b>@Dash(endpoint.Model)</b></div><div class="limit-tags"><span>@endpoint.TimeoutMs ms</span><span>@endpoint.InputLimit chars</span></div><div class="credential"><span class="@CredentialTone(endpoint)"><i></i>@CredentialLabel(endpoint)</span>@if (probingIds.Contains(endpoint.Id)) { <small>配置校验 ✓ · 等待服务响应…</small> }@if (probeResults.TryGetValue(endpoint.Id, out var result)) { <small class="@(result.Ok ? "success" : "danger")">HTTP @(result.HttpStatus == 0 ? "—" : result.HttpStatus) · @result.Status · @result.LatencyMs ms · @result.Message</small> }</div><div class="endpoint-actions"><button type="button" class="button secondary small" disabled="@probingIds.Contains(endpoint.Id)" @onclick="() => ProbeEndpointAsync(endpoint)">连接测试</button><button type="button" class="text-action" @onclick="() => OpenEditEndpoint(endpoint)">编辑</button><button type="button" class="text-action danger" @onclick="() => RemoveEndpointAsync(endpoint)">删除</button></div></article> }</div>
                    }
                </section>

                <section class="policy-section">
                    <header><h2>审计策略</h2><p>配置适用分组、九类输入风险、Worker 与队列边界。</p></header>
                    <div class="policy-layout"><section><fieldset><legend>适用范围</legend><div class="radio-row"><label><input type="radio" name="prompt-scope" checked="@config.AllGroups" @onchange="() => SetAllGroups(true)" />全部分组</label><label><input type="radio" name="prompt-scope" checked="@(!config.AllGroups)" @onchange="() => SetAllGroups(false)" />指定分组</label></div></fieldset>@if (!config.AllGroups) { <div class="audit-groups"><input @bind="groupSearch" @bind:event="oninput" placeholder="搜索分组" />@if (FilteredGroups.Count == 0) { <p>没有匹配分组</p> } else { <div>@foreach (var group in FilteredGroups) { <label><span><input type="checkbox" checked="@config.GroupIds.Contains(group.Id)" @onchange="e => ToggleGroup(group.Id, e)" />@group.Name</span><small>@group.Platform · @group.Status</small></label> }</div> }<small>已选择 @config.GroupIds.Count 个分组</small></div> }<fieldset class="scanner-fieldset"><legend>Qwen3Guard 输入风险分类</legend><div class="scanner-grid">@foreach (var scanner in ScannerCatalog) { <label><input type="checkbox" checked="@config.Scanners.Contains(scanner.Id)" @onchange="e => ToggleScanner(scanner.Id, e)" />@scanner.Label</label> }</div></fieldset></section><aside><label><span>Worker 数量</span><input type="number" min="1" max="32" @bind="config.WorkerCount" /></label><label><span>持久队列容量</span><input type="number" min="1" max="100000" @bind="config.QueueCapacity" /></label><div><b>节点策略</b><p>priority · 按配置顺序优先尝试，必要时故障切换。</p></div></aside></div>
                </section>
            }
            else
            {
                @if (config.Enabled && !config.StorePassEvents) { <div class="pass-notice"><span>当前未开启“保存安全事件”：安全请求仍会完成审计，但不会出现在事件列表中；Flag 和 Critical 仍会保存。</span><button type="button" @onclick='() => activeTab = "config"'>前往配置</button></div> }
                <section class="events-section">
                    <header class="section-header-row"><div><h2>审计事件</h2><p>按身份、入口、风险、Hash 和时间复核事件，详情中可查看完整提示词。</p></div><div><button type="button" class="button secondary small" disabled="@(selectedEventIds.Count == 0 || deleting)" @onclick="DeleteSelectedAsync">删除选中项（@selectedEventIds.Count）</button><button type="button" class="button danger small" disabled="@deleting" @onclick="OpenFilterDelete">按筛选删除</button></div></header>
                    <div class="event-filters"><label><span>判定</span><select @bind="filters.Decision"><option value="">全部</option><option value="pass">通过</option><option value="flag">标记</option><option value="critical">严重</option></select></label><label><span>风险等级</span><select @bind="filters.RiskLevel"><option value="">全部</option><option value="low">低</option><option value="medium">中</option><option value="high">高</option><option value="critical">严重</option></select></label><FilterInput Label="入口" Value="@filters.Endpoint" Changed="v => filters.Endpoint = v" /><FilterInput Label="分组 ID" Type="number" Value="@filters.GroupId" Changed="v => filters.GroupId = v" /><FilterInput Label="用户 ID" Type="number" Value="@filters.UserId" Changed="v => filters.UserId = v" /><FilterInput Label="API Key ID" Type="number" Value="@filters.ApiKeyId" Changed="v => filters.ApiKeyId = v" /><FilterInput Label="Request ID" Value="@filters.RequestId" Changed="v => filters.RequestId = v" /><FilterInput Label="Prompt SHA-256" Value="@filters.PromptHash" Changed="v => filters.PromptHash = v" /><FilterInput Label="关键词" Value="@filters.Keyword" Changed="v => filters.Keyword = v" /><label><span>开始时间</span><input type="datetime-local" value="@filters.StartAt" @onchange="SetFilterStart" /></label><label><span>结束时间</span><input type="datetime-local" value="@filters.EndAt" @onchange="SetFilterEnd" /></label><div class="filter-actions"><button type="button" class="button primary small" @onclick="ApplyFiltersAsync">搜索</button><button type="button" class="text-action" @onclick="ResetFiltersAsync">重置</button></div></div>
                    @if (!string.IsNullOrWhiteSpace(eventsError)) { <div class="inline-alert danger"><span>@eventsError</span></div> }
                    <div class="events-table-wrap"><table class="events-table"><thead><tr><th><input type="checkbox" checked="@AllPageSelected" @onchange="ToggleAllEvents" aria-label="选择当前页全部事件" /></th><th>时间</th><th>用户 / 邮箱 / API Key</th><th>分组</th><th>入口 / 模型</th><th>判定 / 风险</th><th>脱敏预览</th><th>操作</th></tr></thead><tbody>@if (eventsLoading) { <tr><td colspan="8"><LoadingState Text="正在载入审计事件" /></td></tr> } else if (eventsPage.Items.Count == 0) { <tr><td colspan="8"><EmptyState Title="没有符合条件的事件" Description="调整筛选条件后重试。" /></td></tr> } else { @foreach (var item in eventsPage.Items) { <tr><td><input type="checkbox" checked="@selectedEventIds.Contains(item.Id)" @onchange="e => ToggleEvent(item.Id, e)" aria-label="选择事件 @item.Id" /></td><td class="nowrap">@FormatDateTime(item.CreatedAt)</td><td><span class="identity"><small>用户名</small><b>@Dash(item.Snapshot.Username)</b><small>用户邮箱</small><b>@Dash(item.Snapshot.UserEmail)</b><small>API Key</small><b>@Dash(item.Snapshot.ApiKeyName)</b></span></td><td>@Dash(item.Snapshot.GroupName)</td><td><span class="route"><b>@Dash(item.Snapshot.Endpoint)</b><small>@Dash(item.Snapshot.Model) · @Dash(item.Snapshot.Protocol) · @Dash(item.Snapshot.Stage)</small></span></td><td><span class="decision @DecisionTone(item.Decision)">@DecisionLabel(item.Decision) · @RiskLabel(item.RiskLevel)</span><small class="categories">@Categories(item.Categories)</small></td><td><p class="preview" title="@item.Snapshot.RedactedPreview">@Dash(item.Snapshot.RedactedPreview)</p></td><td class="row-actions"><button type="button" @onclick="() => OpenEventAsync(item.Id)">查看</button><button type="button" class="danger" @onclick="() => DeleteSingleAsync(item)">删除</button></td></tr> } }</tbody></table></div>
                    <footer class="event-pagination"><span>共 @eventsPage.Total.ToString("N0") 条</span><div><select value="@eventPageSize" @onchange="PageSizeChangedAsync"><option value="10">10 / 页</option><option value="20">20 / 页</option><option value="50">50 / 页</option><option value="100">100 / 页</option></select><button type="button" class="icon-button" disabled="@(eventPage <= 1)" @onclick="() => ChangeEventPageAsync(eventPage - 1)"><Icon Name="chevron-left" Size="15" /></button><span>@(eventPage) / @EventTotalPages</span><button type="button" class="icon-button" disabled="@(eventPage >= EventTotalPages)" @onclick="() => ChangeEventPageAsync(eventPage + 1)"><Icon Name="chevron-right" Size="15" /></button></div></footer>
                </section>
            }
        </main>

        @if (activeTab == "config")
        {
            <div class="save-bar"><div class="save-toggles"><label><input type="checkbox" @bind="config.Enabled" />启用提示词审计</label><label><input type="checkbox" checked="@config.BlockingEnabled" disabled="@(!config.Enabled)" @onchange="BlockingChangedAsync" />同步阻止</label><label><input type="checkbox" @bind="config.BlockingLatestTurnOnly" disabled="@(!config.Enabled || !config.BlockingEnabled)" />仅审最新输入和上一轮输出</label><label><input type="checkbox" @bind="config.StorePassEvents" />保存安全事件</label></div><div class="save-actions"><span class="@(Dirty ? "dirty" : null)">@(Dirty ? "有未保存的更改" : "配置已同步")</span><button type="button" class="button secondary" disabled="@(!Dirty || saving)" @onclick="ResetDraft">重置</button><button type="button" class="button primary" disabled="@(!Dirty || saving)" @onclick="SaveConfigAsync">@(saving ? "保存中…" : "保存")</button></div></div>
        }
    }
</div>

<AppModal Open="endpointEditorOpen" Title="@(editingEndpointIndex < 0 ? "新增审计节点" : "编辑审计节点")" MaxWidth="760px" OnClose="CloseEndpointEditor">
    <ChildContent>@if (editingEndpoint is not null) { <div class="endpoint-form"><label><span>节点名称</span><input @bind="editingEndpoint.Name" /></label><label><span>稳定节点 ID</span><input @bind="editingEndpoint.Id" disabled="@(editingEndpointIndex >= 0)" /></label><label class="span-two"><span>Base URL</span><input @bind="editingEndpoint.BaseUrl" inputmode="url" /></label><label class="span-two"><span>API Key</span><input type="password" autocomplete="new-password" @bind="editingEndpoint.Token" placeholder="@(editingEndpoint.HasToken ? editingEndpoint.TokenStatus == "invalid" ? "API Key 无法解密，请重新输入" : "留空以保留已保存的 API Key" : null)" /><small>明文只在本次编辑内存中存在；保存成功后会立即清除。</small></label>@if (editingEndpoint.HasToken) { <label class="clear-secret span-two"><input type="checkbox" @bind="editingEndpoint.ClearToken" />显式清除已保存的 API Key</label> }<label class="span-two"><span>模型</span><input @bind="editingEndpoint.Model" /></label><label><span>总超时（毫秒）</span><input type="number" min="100" max="30000" @bind="editingEndpoint.TimeoutMs" /></label><label><span>单片 Unicode 字符上限</span><input type="number" min="128" max="100000" @bind="editingEndpoint.InputLimit" /></label></div>@if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger"><span>@modalError</span></div> } }</ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseEndpointEditor">取消</button><button type="button" class="button primary" @onclick="SaveEndpointEditor">保存</button></Footer>
</AppModal>

<AppModal Open="eventDetailOpen" Title="提示词审计事件详情" MaxWidth="1120px" OnClose="CloseEventDetail">
    <ChildContent>@if (eventDetailLoading) { <LoadingState Text="正在载入事件详情" /> } else if (activeEvent is not null) { <nav class="detail-tabs"><button type="button" class="@(detailTab == "summary" ? "active" : null)" @onclick='() => detailTab = "summary"'>审计摘要</button><button type="button" class="@(detailTab == "risks" ? "active" : null)" @onclick='() => detailTab = "risks"'>具体风险</button><button type="button" class="@(detailTab == "technical" ? "active" : null)" @onclick='() => detailTab = "technical"'>技术信息</button></nav><div class="detail-panel">@if (detailTab == "summary") { <div class="summary-layout"><section><h3>完整提示词（未脱敏）</h3><pre>@DisplayPrompt(activeEvent)</pre></section><dl><dt>判定</dt><dd>@DecisionLabel(activeEvent.Decision) · @ActionLabel(activeEvent.Action)</dd><dt>用户名</dt><dd>@Dash(activeEvent.Snapshot.Username)</dd><dt>用户邮箱</dt><dd>@Dash(activeEvent.Snapshot.UserEmail)</dd><dt>API Key</dt><dd>@Dash(activeEvent.Snapshot.ApiKeyName)</dd><dt>分组</dt><dd>@Dash(activeEvent.Snapshot.GroupName)</dd><dt>模型</dt><dd>@Dash(activeEvent.Snapshot.Model)</dd><dt>分类</dt><dd>@Categories(activeEvent.Categories)</dd></dl></div> } else if (detailTab == "risks") { <div class="risk-detail-top"><section><h3>完整提示词（未脱敏）</h3><p>完整提示词仅供管理员复核，请按敏感数据妥善处理。</p><pre>@DisplayPrompt(activeEvent)</pre></section><section><h3>模型审计返回</h3><p>Guard 归一化后的结构化结果，不含原始响应体。</p><pre>@GuardReturnJson(activeEvent)</pre></section></div><div class="issue-list"><h3>风险摘要</h3>@if (activeEvent.IssueSummaries.Count == 0) { <p>本事件没有派生风险摘要。</p> } else { @foreach (var issue in activeEvent.IssueSummaries) { <article><header><b>@ScannerLabel(string.IsNullOrWhiteSpace(issue.Category) ? issue.ScannerId : issue.Category)</b><span>@RiskLabel(issue.Severity) · @ActionLabel(issue.Action)</span></header><p>@(string.IsNullOrWhiteSpace(issue.Description) ? ScannerDescription(issue.ScannerId) : issue.Description)</p><dl><div><dt>分类</dt><dd>@ScannerLabel(string.IsNullOrWhiteSpace(issue.Category) ? issue.ScannerId : issue.Category)</dd></div><div><dt>分数</dt><dd>@issue.Score</dd></div><div><dt>脱敏证据</dt><dd>@Dash(issue.Evidence)</dd></div></dl></article> } }</div> } else { <dl class="technical-list"><dt>Request ID</dt><dd>@Dash(activeEvent.Snapshot.RequestId)</dd><dt>Prompt SHA-256</dt><dd>@Dash(activeEvent.Snapshot.PromptHash)</dd><dt>扫描器</dt><dd>@Dash(activeEvent.ScannerBackend) · @Dash(activeEvent.ScannerVersion)</dd><dt>策略</dt><dd>@Dash(activeEvent.PolicyId) · v@activeEvent.PolicyVersion</dd><dt>Guard 节点</dt><dd>@Dash(activeEvent.GuardEndpointId)</dd><dt>配置版本</dt><dd>v@activeEvent.ConfigVersion</dd><dt>分片数</dt><dd>@activeEvent.ChunkTotal</dd><dt>耗时</dt><dd>@activeEvent.LatencyMs ms</dd><dt>请求阶段</dt><dd>@Dash(activeEvent.Snapshot.Stage)</dd><dt>协议</dt><dd>@Dash(activeEvent.Snapshot.Protocol) · @Dash(activeEvent.Snapshot.Endpoint)</dd></dl> }</div> }</ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseEventDetail">关闭</button></Footer>
</AppModal>

<AppModal Open="filterDeleteOpen" Title="按筛选删除审计事件" MaxWidth="760px" OnClose="CloseFilterDelete">
    <ChildContent><div class="delete-filter"><p>选择时间范围与风险条件后执行删除；删除不可恢复。可先获取服务端删除预览。</p><fieldset><legend>删除时间范围</legend><div class="preset-row">@foreach (var option in DeletePresets) { <button type="button" class="@(deletePreset == option.Id ? "active" : null)" @onclick="() => SetDeletePreset(option.Id)">@option.Label</button> }</div><small>删除所选截止时间之前产生的事件；预览后新产生的事件不受影响。</small>@if (deletePreset == "custom") { <div class="custom-range"><label><span>开始时间</span><input type="datetime-local" value="@deleteFilters.StartAt" @onchange="SetDeleteStart" /></label><label><span>结束时间</span><input type="datetime-local" value="@deleteFilters.EndAt" @onchange="SetDeleteEnd" /></label></div>@if (!DeleteRangeValid) { <span class="validation">自定义范围需要有效的开始与结束时间，且开始早于结束。</span> } }</fieldset><div class="delete-basic"><label><span>判定</span><select @bind="deleteFilters.Decision" @bind:after="ClearDeletePreview"><option value="">全部</option><option value="pass">通过</option><option value="flag">标记</option><option value="critical">严重</option></select></label><label><span>风险等级</span><select @bind="deleteFilters.RiskLevel" @bind:after="ClearDeletePreview"><option value="">全部</option><option value="low">低</option><option value="medium">中</option><option value="high">高</option><option value="critical">严重</option></select></label></div><details><summary>更多条件（入口 / 关键词 / 分组 / 用户）</summary><div><FilterInput Label="入口" Value="@deleteFilters.Endpoint" Changed="SetDeleteEndpoint" /><FilterInput Label="关键词" Value="@deleteFilters.Keyword" Changed="SetDeleteKeyword" /><FilterInput Label="分组 ID" Type="number" Value="@deleteFilters.GroupId" Changed="SetDeleteGroup" /><FilterInput Label="用户 ID" Type="number" Value="@deleteFilters.UserId" Changed="SetDeleteUser" /></div></details>@if (deletePreview is not null) { <section class="delete-preview"><b>服务端快照匹配 @deletePreview.MatchedCount 条事件。</b><dl><dt>快照最大事件 ID</dt><dd>@deletePreview.SnapshotMaxId</dd><dt>Filter SHA-256</dt><dd>@deletePreview.FilterHash</dd><dt>确认令牌过期时间</dt><dd>@FormatDateTime(deletePreview.ExpiresAt)</dd></dl><p>只删除预览高水位内的事件；预览后产生的新事件会保留。</p></section> } else { <div class="delete-preview-empty">可直接确认删除；如需提前查看匹配数量，可先获取删除预览。</div> }@if (!string.IsNullOrWhiteSpace(modalError)) { <div class="inline-alert danger"><span>@modalError</span></div> }</div></ChildContent>
    <Footer><button type="button" class="button secondary" @onclick="CloseFilterDelete">取消</button><button type="button" class="button secondary" disabled="@(!DeleteRangeValid || previewing || deleting)" @onclick="PreviewFilterDeleteAsync">@(previewing ? "正在生成预览…" : "获取删除预览")</button><button type="button" class="button danger" disabled="@(!DeleteRangeValid || previewing || deleting || deletePreview?.MatchedCount == 0)" @onclick="ConfirmFilterDeleteAsync">@(deleting ? "提交中…" : "确认永久删除")</button></Footer>
</AppModal>

@code {
    private static readonly (string Id, string Label)[] ScannerCatalog = [("violent", "暴力"), ("non_violent_illegal_acts", "非暴力违法行为"), ("sexual_content_or_sexual_acts", "色情内容或性行为"), ("pii", "个人身份信息"), ("suicide_and_self_harm", "自杀与自残"), ("unethical_acts", "不道德行为"), ("politically_sensitive_topics", "政治敏感话题"), ("copyright_violation", "版权侵犯"), ("jailbreak", "越狱")];
    private static readonly (string Id, string Label, int? Days)[] DeletePresets = [("1d", "1 天前", 1), ("7d", "7 天前", 7), ("30d", "30 天前", 30), ("90d", "90 天前", 90), ("all", "全部时间", null), ("custom", "自定义范围", null)];
    private PromptAuditConfigDto config = new(); private PromptAuditConfigDto? serverConfig; private PromptAuditRuntimeDto runtime = new(); private PagedEnvelope<PromptAuditEventDto> eventsPage = new(); private PromptAuditEventFiltersDto filters = new(), appliedFilters = new(), deleteFilters = new(); private List<PromptAuditGroupDto> groups = [];
