    protected override Task OnInitializedAsync() => LoadAllAsync();
    private async Task LoadAllAsync()
    {
        loading = true; error = null;
        try { var c = Api.GetPromptAuditConfigAsync(); var r = Api.GetPromptAuditRuntimeAsync(); var g = Api.GetPromptAuditGroupsAsync(); await Task.WhenAll(c, r, g); config = await c; NormalizeConfig(); serverConfig = CloneConfig(config); serverFingerprint = BuildFingerprint(config); runtime = await r; groups = await g; await LoadEventsAsync(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { loading = false; }
    }
    private void NormalizeConfig() { config.Endpoints ??= []; config.Scanners ??= []; config.GroupIds ??= []; foreach (var endpoint in config.Endpoints) { endpoint.Token = string.Empty; endpoint.ClearToken = false; if (endpoint.TimeoutMs <= 0) endpoint.TimeoutMs = 3000; if (endpoint.InputLimit <= 0) endpoint.InputLimit = 4000; } if (config.WorkerCount <= 0) config.WorkerCount = 4; if (config.QueueCapacity <= 0) config.QueueCapacity = 32768; }
    private async Task LoadRuntimeAsync() { runtimeLoading = true; runtimeError = null; try { runtime = await Api.GetPromptAuditRuntimeAsync(); } catch (ApiException ex) { runtimeError = ex.Message; } finally { runtimeLoading = false; } }
    private async Task LoadEventsAsync() { eventsLoading = true; eventsError = null; try { eventsPage = await Api.GetPromptAuditEventsAsync(eventPage, eventPageSize, NormalizeFilters(appliedFilters)); eventPage = eventsPage.Page <= 0 ? eventPage : eventsPage.Page; selectedEventIds.RemoveWhere(id => eventsPage.Items.All(x => x.Id != id)); } catch (ApiException ex) { eventsError = ex.Message; } finally { eventsLoading = false; } }

    private async Task SaveConfigAsync()
    {
        modalError = ValidateConfig(); if (modalError is not null) { error = modalError; return; } saving = true; error = null;
        try { var saved = await Api.UpdatePromptAuditConfigAsync(BuildUpdatePayload(config)); config = saved; NormalizeConfig(); serverConfig = CloneConfig(config); serverFingerprint = BuildFingerprint(config); Toasts.Success("提示词审计配置已保存，明文 API Key 状态已清除"); await LoadRuntimeAsync(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { saving = false; }
    }
    private string? ValidateConfig() { if (config.Enabled && !config.Endpoints.Any(x => x.Enabled)) return "启用审计前至少需要一个启用节点。"; if (!config.AllGroups && config.GroupIds.Count == 0) return "指定分组模式至少需要选择一个分组。"; if (config.Scanners.Count == 0) return "至少需要启用一个风险分类。"; foreach (var endpoint in config.Endpoints) { if (string.IsNullOrWhiteSpace(endpoint.Id) || string.IsNullOrWhiteSpace(endpoint.Name) || !Uri.TryCreate(endpoint.BaseUrl, UriKind.Absolute, out _)) return "审计节点配置无效。"; } return null; }
    private object BuildUpdatePayload(PromptAuditConfigDto value) => new { expected_config_version = value.ConfigVersion, enabled = value.Enabled, blocking_enabled = value.Enabled && value.BlockingEnabled, blocking_latest_turn_only = value.BlockingLatestTurnOnly, store_pass_events = value.StorePassEvents, strategy = "priority", worker_count = value.WorkerCount, queue_capacity = value.QueueCapacity, scanners = value.Scanners, all_groups = value.AllGroups, group_ids = value.AllGroups ? new List<long>() : value.GroupIds.Order().ToList(), endpoints = value.Endpoints.Select(x => new { id = x.Id.Trim(), name = x.Name.Trim(), protocol = "openai_compatible", base_url = x.BaseUrl.Trim(), model = string.IsNullOrWhiteSpace(x.Model) ? "sileader/qwen3guard:0.6b" : x.Model.Trim(), token = string.IsNullOrWhiteSpace(x.Token) ? null : x.Token.Trim(), clear_token = x.ClearToken, timeout_ms = x.TimeoutMs, input_limit = x.InputLimit, enabled = x.Enabled }).ToList() };
    private string BuildFingerprint(PromptAuditConfigDto value) => System.Text.Json.JsonSerializer.Serialize(BuildUpdatePayload(value));
    private bool Dirty => BuildFingerprint(config) != serverFingerprint;
    private void ResetDraft() { if (serverConfig is not null) config = CloneConfig(serverConfig); }
    private async Task BlockingChangedAsync(ChangeEventArgs args) { var enabled = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); if (enabled && !config.BlockingEnabled) { if (!await JS.InvokeAsync<bool>("confirm", "开启同步阻止后，适用请求会在账号选择、计费和访问上游前等待 Guard；Guard 不可用或响应非法时也会阻止请求。确认开启？")) return; } config.BlockingEnabled = enabled; }

    private void OpenNewEndpoint() { editingEndpointIndex = -1; editingEndpoint = new() { Id = $"guard-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}-{config.Endpoints.Count + 1}", Name = $"Guard {config.Endpoints.Count + 1}", Protocol = "openai_compatible", BaseUrl = "http://127.0.0.1:8000", Model = "sileader/qwen3guard:0.6b", TimeoutMs = 3000, InputLimit = 4000, Enabled = true, TokenStatus = "missing" }; modalError = null; endpointEditorOpen = true; }
    private void OpenEditEndpoint(PromptAuditEndpointDto endpoint) { editingEndpointIndex = config.Endpoints.IndexOf(endpoint); editingEndpoint = CloneEndpoint(endpoint); modalError = null; endpointEditorOpen = true; }
    private Task CloseEndpointEditor() { endpointEditorOpen = false; editingEndpoint = null; editingEndpointIndex = -1; modalError = null; return Task.CompletedTask; }
    private void SaveEndpointEditor() { if (editingEndpoint is null) return; if (string.IsNullOrWhiteSpace(editingEndpoint.Id) || string.IsNullOrWhiteSpace(editingEndpoint.Name) || !Uri.TryCreate(editingEndpoint.BaseUrl, UriKind.Absolute, out _)) { modalError = "请填写有效的节点 ID、名称和 Base URL。"; return; } if (editingEndpointIndex < 0 && config.Endpoints.Any(x => x.Id.Equals(editingEndpoint.Id, StringComparison.OrdinalIgnoreCase))) { modalError = "节点 ID 已存在。"; return; } if (!string.IsNullOrWhiteSpace(editingEndpoint.Token)) editingEndpoint.ClearToken = false; var copy = CloneEndpoint(editingEndpoint); if (editingEndpointIndex < 0) config.Endpoints.Add(copy); else config.Endpoints[editingEndpointIndex] = copy; _ = CloseEndpointEditor(); }
    private void ToggleEndpoint(PromptAuditEndpointDto endpoint, ChangeEventArgs args) => endpoint.Enabled = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    private async Task RemoveEndpointAsync(PromptAuditEndpointDto endpoint) { if (!await JS.InvokeAsync<bool>("confirm", $"从草稿中删除节点“{endpoint.Name}”？保存配置后生效。")) return; config.Endpoints.Remove(endpoint); probeResults.Remove(endpoint.Id); }
    private async Task ProbeEndpointAsync(PromptAuditEndpointDto endpoint) { if (!probingIds.Add(endpoint.Id)) return; try { var result = await Api.ProbePromptAuditEndpointAsync(endpoint); probeResults[endpoint.Id] = result; if (result.Ok) Toasts.Success("审计节点连接正常"); else Toasts.Error($"{result.ErrorCode}: {result.Message}"); } catch (ApiException ex) { error = ex.Message; } finally { probingIds.Remove(endpoint.Id); } }

    private void SetAllGroups(bool value) { config.AllGroups = value; if (value) config.GroupIds.Clear(); }
    private void ToggleGroup(long id, ChangeEventArgs args) { var selected = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); if (selected) { if (!config.GroupIds.Contains(id)) config.GroupIds.Add(id); } else config.GroupIds.Remove(id); }
    private void ToggleScanner(string id, ChangeEventArgs args) { var selected = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); if (selected) { if (!config.Scanners.Contains(id)) config.Scanners.Add(id); } else config.Scanners.Remove(id); }

    private async Task ApplyFiltersAsync() { appliedFilters = CloneFilters(filters); eventPage = 1; selectedEventIds.Clear(); await LoadEventsAsync(); }
    private void SetFilterStart(ChangeEventArgs args) => filters.StartAt = args.Value?.ToString() ?? string.Empty;
    private void SetFilterEnd(ChangeEventArgs args) => filters.EndAt = args.Value?.ToString() ?? string.Empty;
    private async Task ResetFiltersAsync() { filters = new(); appliedFilters = new(); eventPage = 1; selectedEventIds.Clear(); await LoadEventsAsync(); }
    private async Task ChangeEventPageAsync(int value) { eventPage = Math.Clamp(value, 1, EventTotalPages); await LoadEventsAsync(); }
    private async Task PageSizeChangedAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var value)) eventPageSize = value; eventPage = 1; await LoadEventsAsync(); }
    private void ToggleEvent(long id, ChangeEventArgs args) { var selected = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); if (selected) selectedEventIds.Add(id); else selectedEventIds.Remove(id); }
    private void ToggleAllEvents(ChangeEventArgs args) { var selected = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); if (selected) foreach (var item in eventsPage.Items) selectedEventIds.Add(item.Id); else foreach (var item in eventsPage.Items) selectedEventIds.Remove(item.Id); }
    private async Task OpenEventAsync(long id) { eventDetailOpen = true; eventDetailLoading = true; detailTab = "summary"; activeEvent = null; try { activeEvent = await Api.GetPromptAuditEventAsync(id); } catch (ApiException ex) { eventDetailOpen = false; error = ex.Message; } finally { eventDetailLoading = false; } }
    private Task CloseEventDetail() { eventDetailOpen = false; activeEvent = null; return Task.CompletedTask; }
    private async Task DeleteSingleAsync(PromptAuditEventDto item) { if (!await JS.InvokeAsync<bool>("confirm", "将永久删除 1 条事件及符合条件的孤立任务。确认删除？")) return; deleting = true; try { var result = await Api.DeletePromptAuditEventAsync(item.Id); Toasts.Success($"已删除 {result.DeletedEvents} 条审计事件"); await Task.WhenAll(LoadEventsAsync(), LoadRuntimeAsync()); } catch (ApiException ex) { error = ex.Message; } finally { deleting = false; } }
    private async Task DeleteSelectedAsync() { var ids = selectedEventIds.ToArray(); if (ids.Length == 0 || !await JS.InvokeAsync<bool>("confirm", $"将永久删除 {ids.Length} 条事件及符合条件的孤立任务。确认删除？")) return; deleting = true; try { var result = await Api.BatchDeletePromptAuditEventsAsync(ids); selectedEventIds.Clear(); Toasts.Success($"已删除 {result.DeletedEvents} 条审计事件"); await Task.WhenAll(LoadEventsAsync(), LoadRuntimeAsync()); } catch (ApiException ex) { error = ex.Message; } finally { deleting = false; } }

    private void OpenFilterDelete() { deleteFilters = CloneFilters(filters); deletePreset = HasValidRange(deleteFilters) ? "custom" : "7d"; deletePreview = null; modalError = null; filterDeleteOpen = true; }
    private Task CloseFilterDelete() { filterDeleteOpen = false; deletePreview = null; modalError = null; return Task.CompletedTask; }
    private void SetDeletePreset(string value) { deletePreset = value; ClearDeletePreview(); }
    private void SetDeleteStart(ChangeEventArgs args) { deleteFilters.StartAt = args.Value?.ToString() ?? string.Empty; ClearDeletePreview(); }
    private void SetDeleteEnd(ChangeEventArgs args) { deleteFilters.EndAt = args.Value?.ToString() ?? string.Empty; ClearDeletePreview(); }
    private void ClearDeletePreview() { deletePreview = null; modalError = null; }
    private async Task PreviewFilterDeleteAsync() { if (!DeleteRangeValid) return; previewing = true; modalError = null; try { deletePreview = await Api.PreviewPromptAuditDeleteAsync(ResolveDeleteFilters()); } catch (ApiException ex) { modalError = ex.Message; } finally { previewing = false; } }
    private async Task ConfirmFilterDeleteAsync() { if (!DeleteRangeValid || !await JS.InvokeAsync<bool>("confirm", "确认永久删除当前筛选范围内的审计事件？此操作不可恢复。")) return; deleting = true; modalError = null; try { var resolved = ResolveDeleteFilters(); var preview = deletePreview ?? await Api.PreviewPromptAuditDeleteAsync(resolved); if (preview.MatchedCount == 0) { deletePreview = preview; return; } var result = await Api.DeletePromptAuditEventsByFilterAsync(resolved, preview); await CloseFilterDelete(); Toasts.Success($"已删除 {result.DeletedEvents} 条审计事件"); await Task.WhenAll(LoadEventsAsync(), LoadRuntimeAsync()); } catch (ApiException ex) { modalError = ex.Message; deletePreview = null; } finally { deleting = false; } }
    private PromptAuditEventFiltersDto ResolveDeleteFilters() { if (deletePreset == "custom") return NormalizeFilters(deleteFilters); var copy = CloneFilters(deleteFilters); var now = DateTimeOffset.UtcNow; var days = DeletePresets.First(x => x.Id == deletePreset).Days; copy.StartAt = DateTimeOffset.UnixEpoch.ToString("O"); copy.EndAt = (days.HasValue ? now.AddDays(-days.Value) : now).ToString("O"); return NormalizeFilters(copy); }
    private void SetDeleteEndpoint(string value) { deleteFilters.Endpoint = value; ClearDeletePreview(); } private void SetDeleteKeyword(string value) { deleteFilters.Keyword = value; ClearDeletePreview(); } private void SetDeleteGroup(string value) { deleteFilters.GroupId = value; ClearDeletePreview(); } private void SetDeleteUser(string value) { deleteFilters.UserId = value; ClearDeletePreview(); }

    private List<PromptAuditGroupDto> FilteredGroups => groups.Where(x => string.IsNullOrWhiteSpace(groupSearch) || $"{x.Name} {x.Id} {x.Platform}".Contains(groupSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    private bool AllPageSelected => eventsPage.Items.Count > 0 && eventsPage.Items.All(x => selectedEventIds.Contains(x.Id));
    private int EventTotalPages => Math.Max(1, eventsPage.Pages > 0 ? eventsPage.Pages : (int)Math.Ceiling(eventsPage.Total / (double)Math.Max(1, eventPageSize)));
    private bool DeleteRangeValid => deletePreset != "custom" || HasValidRange(deleteFilters);
    private static bool HasValidRange(PromptAuditEventFiltersDto value) => DateTimeOffset.TryParse(value.StartAt, out var start) && DateTimeOffset.TryParse(value.EndAt, out var end) && start < end;
    private static PromptAuditEventFiltersDto NormalizeFilters(PromptAuditEventFiltersDto value) { var copy = CloneFilters(value); copy.GroupId = PositiveInteger(copy.GroupId); copy.UserId = PositiveInteger(copy.UserId); copy.ApiKeyId = PositiveInteger(copy.ApiKeyId); copy.StartAt = ToIso(copy.StartAt); copy.EndAt = ToIso(copy.EndAt); return copy; }
    private static string PositiveInteger(string value) => long.TryParse(value, out var number) && number > 0 ? number.ToString() : string.Empty;
    private static string ToIso(string value) => DateTimeOffset.TryParse(value, out var date) ? date.ToUniversalTime().ToString("O") : string.Empty;
    private static PromptAuditEventFiltersDto CloneFilters(PromptAuditEventFiltersDto x) => new() { Decision = x.Decision, RiskLevel = x.RiskLevel, Endpoint = x.Endpoint, GroupId = x.GroupId, UserId = x.UserId, ApiKeyId = x.ApiKeyId, RequestId = x.RequestId, PromptHash = x.PromptHash, Keyword = x.Keyword, StartAt = x.StartAt, EndAt = x.EndAt };
    private static PromptAuditEndpointDto CloneEndpoint(PromptAuditEndpointDto x) => new() { Id = x.Id, Name = x.Name, Protocol = x.Protocol, BaseUrl = x.BaseUrl, Model = x.Model, TimeoutMs = x.TimeoutMs, InputLimit = x.InputLimit, Enabled = x.Enabled, HasToken = x.HasToken, TokenStatus = x.TokenStatus, Token = x.Token, ClearToken = x.ClearToken };
    private static PromptAuditConfigDto CloneConfig(PromptAuditConfigDto x) => new() { Enabled = x.Enabled, BlockingEnabled = x.BlockingEnabled, BlockingLatestTurnOnly = x.BlockingLatestTurnOnly, StorePassEvents = x.StorePassEvents, EffectiveMode = x.EffectiveMode, Strategy = x.Strategy, WorkerCount = x.WorkerCount, QueueCapacity = x.QueueCapacity, Scanners = [.. x.Scanners], AllGroups = x.AllGroups, GroupIds = [.. x.GroupIds], Endpoints = x.Endpoints.Select(CloneEndpoint).ToList(), ConfigVersion = x.ConfigVersion, UpdatedAt = x.UpdatedAt, UpdatedBy = x.UpdatedBy, ChangeSummary = x.ChangeSummary };

    private static string RuntimeTone(string value) => value switch { "running" => "success", "degraded" => "warning", "disabled" => "neutral", _ => "danger" };
    private static string StatusLabel(string value) => value switch { "running" => "运行中", "degraded" => "降级", "disabled" => "未启用", "error" => "错误", "healthy" => "健康", "failed" => "失败", "stale" => "心跳过期", _ => Dash(value) };
    private static string ModeLabel(string value) => value switch { "off" => "已关闭", "async_audit" => "异步只审计", "blocking" => "同步审计并阻止", _ => Dash(value) };
    private static string CredentialLabel(PromptAuditEndpointDto x) => x.TokenStatus == "invalid" && string.IsNullOrWhiteSpace(x.Token) ? "API Key 无法解密" : !string.IsNullOrWhiteSpace(x.Token) || x.HasToken && !x.ClearToken ? "API Key 已配置" : "未配置 API Key";
    private static string CredentialTone(PromptAuditEndpointDto x) => x.TokenStatus == "invalid" && string.IsNullOrWhiteSpace(x.Token) ? "danger" : !string.IsNullOrWhiteSpace(x.Token) || x.HasToken && !x.ClearToken ? "success" : "neutral";
    private static string DecisionLabel(string value) => value switch { "pass" => "通过", "flag" => "标记", "critical" => "严重", _ => Dash(value) };
    private static string DecisionTone(string value) => value switch { "critical" => "danger", "flag" => "warning", _ => "success" };
    private static string RiskLabel(string value) => value switch { "low" => "低", "medium" => "中", "high" => "高", "critical" => "严重", _ => Dash(value) };
    private static string ActionLabel(string value) => value switch { "Allow" => "放行", "Warn" => "警告", "Block" => "阻止", _ => Dash(value) };
    private static string ScannerLabel(string id) => ScannerCatalog.FirstOrDefault(x => x.Id == id).Label ?? Dash(id);
    private static string ScannerDescription(string id) => id switch { "violent" => "暴力或暴力威胁", "non_violent_illegal_acts" => "非暴力违法活动", "sexual_content_or_sexual_acts" => "色情内容或性行为", "pii" => "个人身份信息", "suicide_and_self_harm" => "自杀或自残", "unethical_acts" => "不道德行为", "politically_sensitive_topics" => "政治敏感话题", "copyright_violation" => "版权侵权", "jailbreak" => "提示注入或越狱尝试", _ => string.Empty };
    private static string Categories(IEnumerable<string> value) { var items = value.Select(ScannerLabel).ToList(); return items.Count == 0 ? "—" : string.Join("、", items); }
    private static string DisplayPrompt(PromptAuditEventDto value) => !string.IsNullOrWhiteSpace(value.Snapshot.FullPrompt) ? value.Snapshot.FullPrompt : Dash(value.Snapshot.RedactedPreview);
    private static string GuardReturnJson(PromptAuditEventDto value) => System.Text.Json.JsonSerializer.Serialize(new { decision = DecisionLabel(value.Decision), risk_level = RiskLabel(value.RiskLevel), action = ActionLabel(value.Action), categories = value.Categories.Select(ScannerLabel), matched_scanners = value.MatchedScanners.Select(ScannerLabel), scanner_scores = value.ScannerScores, scanner_evidence = value.ScannerEvidence, scanner_backend = value.ScannerBackend, scanner_version = value.ScannerVersion, guard_endpoint_id = value.GuardEndpointId, chunk_total = value.ChunkTotal, latency_ms = value.LatencyMs }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    private static string Ms(double? value) => value.HasValue ? $"{value:0} ms" : "—";
    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string FormatDateTime(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—";
