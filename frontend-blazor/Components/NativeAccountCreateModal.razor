@using System.Net
@implements IAsyncDisposable
@inject ApiClient Api
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JS

<AppModal Open="@Open" Title="添加账号" MaxWidth="980px" OnClose="CloseAsync">
    <ChildContent>
        <div class="native-account-content">
                @if (IsOAuthFlow)
                {
                    <div class="native-account-stepper" aria-label="创建账号步骤">
                        <div class="native-step @(step >= 1 ? "active" : string.Empty)">
                            <span>1</span><strong>授权方式</strong>
                        </div>
                        <i></i>
                        <div class="native-step @(step >= 2 ? "active" : string.Empty)">
                            <span>2</span><strong>@OAuthStepTitle</strong>
                        </div>
                    </div>
                }

                @if (error is not null)
                {
                    <div class="native-account-alert danger" role="alert"><Icon Name="alert" Size="18" /><span>@error</span></div>
                }

                @if (step == 1)
                {
                    <div class="native-account-form">
                        <div class="native-field">
                            <label for="native-account-name">账号名称</label>
                            <input id="native-account-name" @bind="form.Name" @bind:event="oninput" autocomplete="off" placeholder="请输入账号名称" />
                        </div>

                        <div class="native-field">
                            <label for="native-account-notes">备注</label>
                            <textarea id="native-account-notes" @bind="form.Notes" @bind:event="oninput" rows="3" placeholder="请输入备注"></textarea>
                            <small>备注可选</small>
                        </div>

                        <div class="native-field">
                            <label>平台</label>
                            <div class="native-platform-segments" role="tablist" aria-label="选择平台">
                                @foreach (var option in PlatformOptions)
                                {
                                    <button type="button" role="tab" aria-selected="@(platform == option.Key ? "true" : "false")" class="native-platform-tab @(platform == option.Key ? "selected" : string.Empty) platform-@option.Key" @onclick="() => SelectPlatform(option.Key)">
                                        <Icon Name="@option.Icon" Size="19" /> <span>@option.Label</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="native-field">
                            <label>账号类型</label>
                            <div class="native-category-grid category-count-@CurrentCategories.Count() platform-@platform">
                                @foreach (var option in CurrentCategories)
                                {
                                    <button type="button" class="native-category-card category-@option.Value @(accountCategory == option.Value ? "selected" : string.Empty)" @onclick="() => SelectCategory(option.Value)">
                                        <span class="native-category-icon"><Icon Name="@option.Icon" Size="22" /></span>
                                        <span class="native-category-copy"><strong>@option.Title</strong><small>@option.Description</small></span>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (platform == "gemini" && accountCategory == "oauth-based")
                        {
                            <div class="native-provider-options">
                                <div class="native-field">
                                    <label for="native-gemini-oauth-type">OAuth 类型</label>
                                    <select id="native-gemini-oauth-type" @bind="geminiOAuthType">
                                        <option value="code_assist">GCP Code Assist</option>
                                        <option value="google_one">Google One</option>
                                        <option value="ai_studio">自定义授权（AI Studio）</option>
                                    </select>
                                    <small>选择与 Google 账号对应的授权通道；AI Studio 需要管理员预先配置 OAuth Client。</small>
                                </div>
                                @if (geminiOAuthType == "code_assist")
                                {
                                    <div class="native-field">
                                        <label for="native-gemini-project">Project ID（可选）</label>
                                        <input id="native-gemini-project" value="@geminiProjectId" @oninput="e => geminiProjectId = e.Value?.ToString() ?? string.Empty" placeholder="例如：my-gcp-project" />
                                        <small>留空时授权兑换阶段会自动探测 GCP 项目。</small>
                                    </div>
                                }
                                <div class="native-field">
                                    <label for="native-gemini-tier">账号等级（探测失败时的回退）</label>
                                    <select id="native-gemini-tier" @bind="geminiTier">
                                        @if (geminiOAuthType == "google_one")
                                        {
                                            <option value="google_one_free">Google One Free</option>
                                            <option value="google_ai_pro">Google One Pro</option>
                                            <option value="google_ai_ultra">Google One Ultra</option>
                                        }
                                        else if (geminiOAuthType == "code_assist")
                                        {
                                            <option value="gcp_standard">GCP Standard</option>
                                            <option value="gcp_enterprise">GCP Enterprise</option>
                                        }
                                        else
                                        {
                                            <option value="aistudio_free">Google AI Free</option>
                                            <option value="aistudio_paid">Google AI Pay-as-you-go</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                        else if (platform == "gemini" && accountCategory == "apikey")
                        {
                            <div class="native-field">
                                <label for="native-gemini-tier">Gemini 账号等级</label>
                                <select id="native-gemini-tier" @bind="geminiTier">
                                    <option value="aistudio_free">Google AI Free</option>
                                    <option value="aistudio_paid">Google AI Pay-as-you-go</option>
                                </select>
                                <small>用于上游倍率和配额探测失败时的本地回退。</small>
                            </div>
                        }
                        else if (platform == "antigravity" && accountCategory == "oauth-based")
                        {
                            <div class="native-field">
                                <label for="native-antigravity-project">Project ID（可选）</label>
                                <input id="native-antigravity-project" value="@antigravityProjectId" @oninput="e => antigravityProjectId = e.Value?.ToString() ?? string.Empty" placeholder="例如：cloud-ai-companion-xxxxx" />
                                <small>授权后用于绑定 Antigravity 的上游项目。</small>
                            </div>
                        }

                        @if (platform == "anthropic" && accountCategory == "oauth-based")
                        {
                            <div class="native-field native-radio-field">
                                <label>添加方式</label>
                                <div class="native-radio-group">
                                    <label><input type="radio" name="native-anthropic-method" checked="@(addMethod == "oauth")" @onchange='() => SetAddMethod("oauth")' /> <span>OAuth</span></label>
                                    <label><input type="radio" name="native-anthropic-method" checked="@(addMethod == "setup-token")" @onchange='() => SetAddMethod("setup-token")' /> <span>Setup Token（长期有效）</span></label>
                                </div>
                            </div>
                        }

                        @if (!IsOAuthFlow || (platform == "anthropic" && addMethod == "setup-token"))
                        {
                            @if (accountCategory == "apikey")
                            {
                                <div class="native-credentials-grid">
                                    <div class="native-field">
                                        <label for="native-base-url">@(platform == "antigravity" ? "Base URL" : "Base URL（可选）")</label>
                                        <input id="native-base-url" value="@form.BaseUrl" @oninput="SetBaseUrl" placeholder="@PlatformBaseUrl" autocomplete="url" required="@(platform == "antigravity")" />
                                    </div>
                                    <div class="native-field">
                                        <label for="native-api-key">API Key</label>
                                        <input id="native-api-key" type="password" value="@form.ApiKey" @oninput="SetApiKey" autocomplete="new-password" placeholder="@PlatformApiKeyPlaceholder" />
                                    </div>
                                </div>
                            }
                            else if (accountCategory is "bedrock" or "service_account")
                            {
                                <div class="native-field">
                                    <label for="native-credentials-json">@(accountCategory == "bedrock" ? "AWS Bedrock 凭据 JSON" : "Vertex Service Account JSON")</label>
                                    <textarea id="native-credentials-json" rows="5" value="@form.CredentialsJson" @oninput="SetCredentialsJson" placeholder="粘贴 JSON 凭据"></textarea>
                                    <small>@(accountCategory == "bedrock" ? "支持 SigV4 凭据或 API Key 配置。" : "粘贴 Google Cloud Service Account JSON。")</small>
                                </div>
                            }
                        }

                        @if (ShouldShowOptions)
                        {
                            <div class="native-options-section">
                                <div class="native-option-row">
                                    <div>
                                        <strong>临时不可调度</strong>
                                        <small>当错误码与关键词同时匹配时，账号会在指定时间内被临时禁用。</small>
                                    </div>
                                    <button type="button" class="native-switch @(tempUnschedulableEnabled ? "on" : string.Empty)" role="switch" aria-checked="@(tempUnschedulableEnabled ? "true" : "false")" aria-label="切换临时不可调度" @onclick="ToggleTempRules">
                                        <span></span>
                                    </button>
                                </div>
                                @if (tempUnschedulableEnabled)
                                {
                                    <div class="native-rule-editor">
                                        <p>错误码和关键词同时匹配时才会触发规则。</p>
                                        @for (var i = 0; i < tempRules.Count; i++)
                                        {
                                            var index = i;
                                            <div class="native-rule-card">
                                                <div class="native-rule-card-header"><strong>规则 @(index + 1)</strong><button type="button" class="native-rule-remove" title="删除规则" aria-label="删除规则 @(index + 1)" @onclick="() => RemoveTempRule(index)"><Icon Name="trash" Size="15" /></button></div>
                                                <div class="native-rule-row">
                                                    <div class="native-field"><label>错误码</label><input type="number" min="100" max="599" value="@tempRules[index].ErrorCode" @oninput="e => SetRuleCode(index, e)" placeholder="429" /></div>
                                                    <div class="native-field"><label>持续时间（分钟）</label><input type="number" min="1" value="@tempRules[index].DurationMinutes" @oninput="e => SetRuleDuration(index, e)" placeholder="10" /></div>
                                                    <div class="native-field native-rule-wide"><label>关键词</label><input value="@tempRules[index].Keywords" @oninput="e => SetRuleKeywords(index, e)" placeholder="rate limit, too many requests" /><small>多个关键词用逗号分隔。</small></div>
                                                    <div class="native-field native-rule-wide"><label>说明（可选）</label><input value="@tempRules[index].Description" @oninput="e => SetRuleDescription(index, e)" placeholder="触发限流后暂时暂停" /></div>
                                                </div>
                                            </div>
                                        }
                                        <button type="button" class="native-rule-add" @onclick="AddTempRule"><Icon Name="plus" Size="15" /> 添加规则</button>
                                    </div>
                                }
                                @if (platform is "anthropic" or "antigravity")
                                {
                                    <div class="native-option-row">
                                        <div>
                                            <strong>拦截预热请求</strong>
                                            <small>启用后，标题生成等预热请求将返回 mock 响应，不消耗上游 token。</small>
                                        </div>
                                        <button type="button" class="native-switch @(interceptWarmupRequests ? "on" : string.Empty)" role="switch" aria-checked="@(interceptWarmupRequests ? "true" : "false")" aria-label="切换拦截预热请求" @onclick="ToggleInterceptWarmup">
                                            <span></span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="native-common-settings">
                            <div class="native-field">
                                <label for="native-proxy">代理</label>
                                <select id="native-proxy" value="@ProxyValue" @onchange="ProxyChanged">
                                    <option value="">直连（不使用代理）</option>
                                    @foreach (var proxy in Proxies.Where(x => string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@proxy.Id">@proxy.Name · @proxy.Protocol://@proxy.Host:@proxy.Port</option>
                                    }
                                </select>
                                <small>授权和上游请求将通过所选代理发出。</small>
                            </div>

                            <div class="native-settings-grid">
                                <div class="native-field">
                                    <label for="native-concurrency">并发上限</label>
                                    <input id="native-concurrency" type="number" min="1" value="@form.Concurrency" @oninput="SetConcurrency" />
                                </div>
                                <div class="native-field">
                                    <label for="native-load-factor">负载因子</label>
                                    <input id="native-load-factor" type="number" min="1" value="@LoadFactorValue" @oninput="SetLoadFactor" placeholder="跟随并发上限" />
                                    <small>留空时按并发上限参与调度。</small>
                                </div>
                                <div class="native-field">
                                    <label for="native-priority">优先级</label>
                                    <input id="native-priority" type="number" min="0" value="@form.Priority" @oninput="SetPriority" />
                                    <small>数值越小越优先。</small>
                                </div>
                                <div class="native-field">
                                    <label for="native-rate-multiplier">计费倍率</label>
                                    <input id="native-rate-multiplier" type="number" min="0" step="0.001" value="@form.RateMultiplier" @oninput="SetRateMultiplier" />
                                    <small>默认 1.000。</small>
                                </div>
                            </div>

                            <div class="native-field native-expiry-field">
                                <label for="native-expires-at">过期时间</label>
                                <input id="native-expires-at" type="datetime-local" value="@expiresAtLocal" @oninput="SetExpiry" />
                                <small>留空表示永不过期。</small>
                            </div>

                            @if (Groups.Count > 0)
                            {
                                <div class="native-field">
                                    <label>所属分组</label>
                                    <div class="native-group-picker">
                                        @foreach (var group in Groups.Where(IsGroupAvailable))
                                        {
                                            var groupId = ParseGroupId(group.Id);
                                            <label class="native-check-option"><input type="checkbox" checked="@form.GroupIds.Contains(groupId)" @onchange="e => ToggleGroup(groupId, e.Value is true)" /><span>@group.Name</span></label>
                                        }
                                    </div>
                                    <small>可选择多个分组；分组策略会参与模型路由和计费。</small>
                                </div>
                            }

                            <div class="native-options-section native-secondary-options">
                                <div class="native-option-row">
                                    <div><strong>启用账号调度</strong><small>关闭后账号保留在列表中，但不会被网关自动选中。</small></div>
                                    <button type="button" class="native-switch @(schedulable ? "on" : string.Empty)" role="switch" aria-checked="@(schedulable ? "true" : "false")" aria-label="切换账号调度" @onclick="ToggleSchedulable"><span></span></button>
                                </div>
                                @if (accountCategory == "apikey" && ApiClient.IsUpstreamBillingProbeAccount(platform, form.Type))
                                {
                                    <div class="native-option-row">
                                        <div><strong>自动探测上游计费倍率</strong><small>创建后读取上游站点声明的倍率，用于统计和告警参考。</small></div>
                                        <button type="button" class="native-switch @(form.ProbeEnabled ? "on" : string.Empty)" role="switch" aria-checked="@(form.ProbeEnabled ? "true" : "false")" aria-label="切换上游计费探测" @onclick="ToggleProbe"><span></span></button>
                                    </div>
                                    <div class="native-option-row">
                                        <div><strong>同步上游计费倍率</strong><small>启用后将上游声明倍率同步到账号配置，请确认上游数据可信。</small></div>
                                        <button type="button" class="native-switch @(form.RateSyncEnabled ? "on" : string.Empty)" role="switch" aria-checked="@(form.RateSyncEnabled ? "true" : "false")" aria-label="切换上游倍率同步" @onclick="ToggleRateSync"><span></span></button>
                                    </div>
                                }
                                <div class="native-option-row">
                                    <div><strong>到期自动暂停</strong><small>账号到期后自动停止调度，凭据不会被删除。</small></div>
                                    <button type="button" class="native-switch @(autoPauseOnExpired ? "on" : string.Empty)" role="switch" aria-checked="@(autoPauseOnExpired ? "true" : "false")" aria-label="切换到期自动暂停" @onclick="ToggleAutoPause"><span></span></button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="native-oauth-step">
                        @if (platform == "copilot" && copilotFlow is not null)
                        {
                            <div class="native-oauth-status">
                                <span class="native-status-dot @(copilotFlow.Status == "completed" ? "success" : copilotFlow.Status is "failed" or "expired" ? "danger" : "pending")"></span>
                                <strong>@CopilotStatusText</strong>
                                @if (copilotFlow.Status == "pending")
                                {
                                    <small>授权页完成后页面会自动检查状态</small>
                                }
                            </div>
                            @if (copilotFlow.Status == "pending")
                            {
                                <div class="native-device-code">
                                    <div><small>请在 GitHub 页面输入一次性设备码</small><code>@copilotFlow.UserCode</code></div>
                                    <button type="button" class="icon-button" title="复制设备码" aria-label="复制设备码" @onclick="CopyCopilotCodeAsync"><Icon Name="copy" Size="18" /></button>
                                </div>
                                <div class="native-oauth-actions">
                                    <a class="button primary" href="@copilotFlow.VerificationUri" target="_blank" rel="noopener noreferrer"><Icon Name="arrow-right" Size="17" /> 打开 GitHub 授权页</a>
                                    <button type="button" class="button secondary" disabled="@oauthBusy" @onclick="PollCopilotOnceAsync"><Icon Name="refresh" Size="17" /> 立即检查</button>
                                </div>
                            }
                            else if (copilotFlow.Status == "completed")
                            {
                                <div class="native-account-alert success"><Icon Name="circle-check" Size="18" /><span>GitHub Copilot 账号已创建。</span></div>
                            }
                            else
                            {
                                <div class="native-account-alert warning"><Icon Name="alert" Size="18" /><span>@CopilotStatusText，请重新发起授权。</span></div>
                            }
                        }
                        else if (platform == "anthropic" && addMethod == "setup-token")
                        {
                            <div class="native-field">
                                <label for="native-setup-token">Setup Token</label>
                                <input id="native-setup-token" type="password" @bind="form.AccessToken" @bind:event="oninput" autocomplete="new-password" placeholder="粘贴 Claude Setup Token" />
                                <small>Setup Token 长期有效，请妥善保管。</small>
                            </div>
                        }
                        else
                        {
                            <div class="native-oauth-intro">
                                <div class="native-oauth-icon"><Icon Name="shield" Size="26" /></div>
                                <div>
                                    <strong>@PlatformTitle 官方授权</strong>
                                    @if (platform == "openai")
                                    {
                                        <p>OpenAI 使用 Codex 官方 localhost:1455 回调；授权后请复制浏览器地址栏中的完整回调链接并粘贴到下方。</p>
                                    }
                                    else
                                    {
                                        <p>请在新窗口完成授权，完成后将回调链接或授权码粘贴到下方。</p>
                                    }
                                </div>
                            </div>
                            @if (oauthStart is not null)
                            {
                                <div class="native-account-alert success"><Icon Name="circle-check" Size="18" /><span>授权链接已生成。</span><a href="@oauthStart.AuthorizationUrl" target="_blank" rel="noopener noreferrer">打开授权页</a></div>
                                <div class="native-field">
                                    <label for="native-oauth-code">授权链接或 Code</label>
                                    <textarea id="native-oauth-code" @bind="authCode" @bind:event="oninput" rows="3" placeholder="粘贴完整 callback URL、?code=... 或裸 code"></textarea>
                                    <small>支持完整回调 URL，系统会自动解析 code、state 和 session_id。</small>
                                </div>
                                <div class="native-oauth-session"><span>会话 ID</span><code>@oauthStart.SessionId</code></div>
                            }
                            else
                            {
                                <div class="native-account-alert info"><Icon Name="info" Size="18" /><span>点击“下一步”生成官方授权链接。</span></div>
                            }
                        }
                    </div>
                }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="button secondary" @onclick="CloseAsync">取消</button>
        @if (step == 2 && platform == "copilot" && copilotFlow?.Status == "pending")
        {
            <button type="button" class="button secondary" @onclick="ResetOAuthAsync"><Icon Name="refresh" Size="16" /> 重新授权</button>
        }
        @if (step == 2 && !(platform == "copilot" && copilotFlow?.Status == "completed"))
        {
            <button type="button" class="button secondary" disabled="@oauthBusy" @onclick="BackToFirstStepAsync"><Icon Name="chevron-left" Size="16" /> 返回上一步</button>
        }
        @if (step == 1)
        {
            <button type="button" class="button primary" disabled="@oauthBusy" @onclick="NextAsync"><Icon Name="@(IsOAuthFlow && !(platform == "anthropic" && addMethod == "setup-token") ? "arrow-right" : "plus")" Size="16" /> @(IsOAuthFlow && !(platform == "anthropic" && addMethod == "setup-token") ? "下一步" : "创建账号")</button>
        }
        else if (platform == "copilot")
        {
            @if (copilotFlow?.Status == "completed")
            {
                <button type="button" class="button primary" @onclick="FinishAsync"><Icon Name="check" Size="16" /> 完成</button>
            }
        }
        else
        {
            <button type="button" class="button primary" disabled="@oauthBusy" @onclick="CompleteSecondStepAsync"><Icon Name="check" Size="16" /> @(oauthBusy ? "处理中…" : "完成并创建")</button>
        }
    </Footer>
</AppModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCreated { get; set; }
    [Parameter] public IReadOnlyList<GroupDto> Groups { get; set; } = Array.Empty<GroupDto>();
    [Parameter] public IReadOnlyList<ProxyDto> Proxies { get; set; } = Array.Empty<ProxyDto>();

    private readonly CancellationTokenSource disposeCancellation = new();
    private CancellationTokenSource? copilotPollingCancellation;
    private Task? copilotPollingTask;
    private readonly SemaphoreSlim copilotPollGate = new(1, 1);
    private bool wasOpen;
    private int step = 1;
    private bool oauthBusy;
    private string platform = "anthropic";
    private string accountCategory = "oauth-based";
    private string addMethod = "oauth";
    private string authCode = string.Empty;
    private string authState = string.Empty;
    private string geminiOAuthType = "code_assist";
    private string geminiProjectId = string.Empty;
    private string geminiTier = "gcp_standard";
    private string antigravityProjectId = string.Empty;
    private string? error;
    private OfficialOAuthStartDto? oauthStart;
    private CopilotOAuthFlowDto? copilotFlow;
    private bool interceptWarmupRequests;
    private bool tempUnschedulableEnabled;
    private bool autoPauseOnExpired = true;
    private bool schedulable = true;
    private string expiresAtLocal = string.Empty;
    private readonly List<TempRule> tempRules = [];
    private AccountInput form = CreateDefaultForm();

    private static readonly PlatformOption[] PlatformOptions =
    [
        new("anthropic", "Anthropic", "sparkles"),
        new("openai", "OpenAI", "zap"),
        new("gemini", "Gemini", "star"),
        new("antigravity", "Antigravity", "cloud"),
        new("copilot", "Copilot", "zap"),
        new("grok", "Grok", "eye-off")
    ];

    private bool IsOAuthFlow => accountCategory == "oauth-based";
    private bool ShouldShowOptions => true;
    private string ProxyValue => form.ProxyId?.ToString() ?? string.Empty;
    private string LoadFactorValue => form.LoadFactor?.ToString() ?? string.Empty;
    private string PlatformTitle => platform switch
    {
        "anthropic" => "Claude",
        "openai" => "OpenAI",
        "gemini" => "Gemini",
        "antigravity" => "Antigravity",
        "copilot" => "GitHub Copilot",
        "grok" => "Grok",
        _ => platform
