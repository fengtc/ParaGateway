    public async ValueTask DisposeAsync()
    {
        disposeCancellation.Cancel();
        var pollingTask = copilotPollingTask;
        StopCopilotPolling();
        if (pollingTask is not null)
        {
            try { await pollingTask; } catch (OperationCanceledException) { }
        }
        await copilotPollGate.WaitAsync();
        copilotPollGate.Release();
        await CancelCopilotFlowBestEffortAsync();
        copilotPollGate.Dispose();
        disposeCancellation.Dispose();
    }

