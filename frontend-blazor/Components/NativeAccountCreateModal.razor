    internal static string DefaultCNBaseUrl(string provider, string mode, string protocol)
    {
        if (protocol == "anthropic")
        {
            return provider switch
            {
                "kimi" => mode == "coding" ? "https://api.kimi.com/coding" : "https://api.moonshot.cn/anthropic",
                "zhipu" => "https://open.bigmodel.cn/api/anthropic",
                "deepseek" => "https://api.deepseek.com/anthropic",
                _ => string.Empty
            };
        }
        return provider switch
        {
            "kimi" => mode == "coding" ? "https://api.kimi.com/coding/v1" : "https://api.moonshot.cn/v1",
            "zhipu" => mode == "coding" ? "https://open.bigmodel.cn/api/coding/paas/v4" : "https://open.bigmodel.cn/api/paas/v4",
            "deepseek" => "https://api.deepseek.com",
            _ => string.Empty
        };
    }

    private void EnsureAdaptiveBaseUrls(AccountInput input, string? previousMode = null, bool force = false)
    {
        var previousChat = previousMode is null ? string.Empty : DefaultCNBaseUrl(platform, previousMode, "chat_completions");
        var previousAnthropic = previousMode is null ? string.Empty : DefaultCNBaseUrl(platform, previousMode, "anthropic");
        var previousResponses = previousMode is null ? string.Empty : DefaultCNBaseUrl(platform, previousMode, "responses");
        input.AdaptiveChatCompletionsBaseUrl = RebaseAdaptiveUrl(
            input.AdaptiveChatCompletionsBaseUrl,
            previousChat,
            DefaultCNBaseUrl(platform, input.AccountMode, "chat_completions"),
            force);
        input.AdaptiveAnthropicBaseUrl = RebaseAdaptiveUrl(
            input.AdaptiveAnthropicBaseUrl,
            previousAnthropic,
            DefaultCNBaseUrl(platform, input.AccountMode, "anthropic"),
            force);
        input.AdaptiveResponsesBaseUrl = platform == "deepseek"
            ? RebaseAdaptiveUrl(
                input.AdaptiveResponsesBaseUrl,
                previousResponses,
                DefaultCNBaseUrl(platform, input.AccountMode, "responses"),
                force)
            : string.Empty;
        input.BaseUrl = input.AdaptiveChatCompletionsBaseUrl;
    }

    private static string RebaseAdaptiveUrl(string current, string previousDefault, string nextDefault, bool force)
    {
        if (force || string.IsNullOrWhiteSpace(current)
            || (!string.IsNullOrWhiteSpace(previousDefault)
                && string.Equals(current.Trim(), previousDefault, StringComparison.OrdinalIgnoreCase)))
        {
            return nextDefault;
        }
        return current.Trim();
    }

    private string? ValidateAdaptiveBaseUrls()
    {
        if (string.IsNullOrWhiteSpace(form.AdaptiveChatCompletionsBaseUrl))
            return "请输入 Chat Completions Base URL";
        if (string.IsNullOrWhiteSpace(form.AdaptiveAnthropicBaseUrl))
            return "请输入 Anthropic Base URL";
        if (platform == "deepseek" && string.IsNullOrWhiteSpace(form.AdaptiveResponsesBaseUrl))
            return "请输入 Responses Base URL";
        return null;
    }

