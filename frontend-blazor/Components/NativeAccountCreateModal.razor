        oauthStart = null;
        await CancelCopilotFlowBestEffortAsync();
        copilotFlow = null;
        authCode = string.Empty;
        authState = string.Empty;
        step = 1;
        await InvokeAsync(StateHasChanged);
    }

    private void StartCopilotPolling()
    {
        StopCopilotPolling();
        if (copilotFlow is null || string.IsNullOrWhiteSpace(copilotFlow.FlowId)) return;
        var generation = Interlocked.Increment(ref copilotPollingGeneration);
        var flowId = copilotFlow.FlowId;
        copilotPollingCancellation = CancellationTokenSource.CreateLinkedTokenSource(disposeCancellation.Token);
        copilotPollingTask = PollCopilotLoopAsync(generation, flowId, copilotPollingCancellation.Token);
    }

    private async Task PollCopilotLoopAsync(long generation, string flowId, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested
                && IsCopilotFlowCurrent(generation, flowId)
                && copilotFlow?.Status == "pending")
            {
                var wait = copilotFlow.NextPollAt - DateTimeOffset.UtcNow;
                if (wait < TimeSpan.FromSeconds(1)) wait = TimeSpan.FromSeconds(1);
                await Task.Delay(wait, cancellationToken);
                if (!cancellationToken.IsCancellationRequested)
                    await InvokeAsync(() => PollCopilotOnceAsync(generation, flowId));
            }
        }
        catch (OperationCanceledException) { }
    }

    private Task PollCopilotOnceAsync()
    {
        var flow = copilotFlow;
        return flow is null
            ? Task.CompletedTask
            : PollCopilotOnceAsync(Volatile.Read(ref copilotPollingGeneration), flow.FlowId);
    }

    private async Task PollCopilotOnceAsync(long generation, string flowId)
    {
        if (!IsCopilotFlowCurrent(generation, flowId)
            || copilotFlow?.Status != "pending"
            || !await copilotPollGate.WaitAsync(0)) return;
        oauthBusy = true;
        error = null;
        try
        {
            var result = await Api.PollCopilotOAuthAsync(flowId);
            if (!IsCopilotFlowCurrent(generation, flowId)) return;
            copilotFlow = result;
            if (copilotFlow.Status is "completed" or "failed" or "expired") StopCopilotPolling();
            await InvokeAsync(StateHasChanged);
        }
        catch (ApiException ex)
        {
            if (IsCopilotFlowCurrent(generation, flowId)) error = ex.Message;
        }
        finally { oauthBusy = false; copilotPollGate.Release(); }
    }

    private void StopCopilotPolling()
    {
        Interlocked.Increment(ref copilotPollingGeneration);
        copilotPollingCancellation?.Cancel();
        copilotPollingCancellation?.Dispose();
        copilotPollingCancellation = null;
        copilotPollingTask = null;
    }

    private async Task CancelCopilotFlowBestEffortAsync()
    {
        var flow = copilotFlow;
        if (flow is null
            || !string.Equals(flow.Status, "pending", StringComparison.Ordinal)
            || string.IsNullOrWhiteSpace(flow.FlowId))
            return;

        copilotFlow = null;
        try
        {
            await Api.CancelCopilotOAuthAsync(flow.FlowId);
        }
        catch (ApiException) { }
        catch (OperationCanceledException) { }
    }

    private bool IsCopilotFlowCurrent(long generation, string flowId) =>
        generation == Volatile.Read(ref copilotPollingGeneration)
        && string.Equals(copilotFlow?.FlowId, flowId, StringComparison.Ordinal);

