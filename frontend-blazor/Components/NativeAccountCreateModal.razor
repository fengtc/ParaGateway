    private void SetPriority(ChangeEventArgs e) => form.Priority = ParseInt(e.Value, form.Priority, 0, 1_000_000);
    private void SetLoadFactor(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.Trim();
        form.LoadFactor = int.TryParse(value, out var parsed) && parsed >= 1 ? Math.Min(parsed, 10_000) : null;
    }
    private void SetRateMultiplier(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.Trim();
        form.RateMultiplier = double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? Math.Clamp(parsed, 0, 100)
            : 1;
    }
    private void ProxyChanged(ChangeEventArgs e)
    {
        form.ProxyId = long.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
    }
    private void SetExpiry(ChangeEventArgs e)
    {
        expiresAtLocal = e.Value?.ToString() ?? string.Empty;
        form.ExpiresAt = DateTime.TryParse(expiresAtLocal, out var value)
            ? new DateTimeOffset(DateTime.SpecifyKind(value, DateTimeKind.Local)).ToUnixTimeSeconds()
            : null;
    }
    private void ToggleGroup(long id, bool selected)
    {
        if (id <= 0) return;
        if (selected && !form.GroupIds.Contains(id)) form.GroupIds.Add(id);
        else if (!selected) form.GroupIds.Remove(id);
    }
    private static long ParseGroupId(string value) => long.TryParse(value, out var id) ? id : 0;
    private bool IsGroupAvailable(GroupDto group) =>
        AccountGroupSelectionPolicy.IsSelectable(group, platform);
    private static int ParseInt(object? value, int fallback, int min, int max)
    {
        var parsed = int.TryParse(value?.ToString(), out var result) ? result : fallback;
        return Math.Clamp(parsed, min, max);
    }
    private void SetRuleCode(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tempRules.Count) tempRules[index].ErrorCode = int.TryParse(e.Value?.ToString(), out var code) ? Math.Clamp(code, 100, 599) : null;
    }
    private void SetRuleDuration(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tempRules.Count) tempRules[index].DurationMinutes = ParseInt(e.Value, 10, 1, 100_000);
    }
    private void SetRuleKeywords(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tempRules.Count) tempRules[index].Keywords = e.Value?.ToString() ?? string.Empty;
    }
    private void SetRuleDescription(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tempRules.Count) tempRules[index].Description = e.Value?.ToString() ?? string.Empty;
    }
    private void RemoveTempRule(int index)
    {
        if (index >= 0 && index < tempRules.Count) tempRules.RemoveAt(index);
    }
    private void ToggleSchedulable() => schedulable = !schedulable;
    private void ToggleAutoPause() => autoPauseOnExpired = !autoPauseOnExpired;
    private void ToggleProbe() => form.ProbeEnabled = !form.ProbeEnabled;
    private void ToggleRateSync() => form.RateSyncEnabled = !form.RateSyncEnabled;

    private void ToggleTempRules()
    {
        tempUnschedulableEnabled = !tempUnschedulableEnabled;
        if (tempUnschedulableEnabled && tempRules.Count == 0) AddTempRule();
    }

    private void ToggleInterceptWarmup() => interceptWarmupRequests = !interceptWarmupRequests;
    private void AddTempRule() => tempRules.Add(new TempRule { ErrorCode = 429, Keywords = "rate limit, too many requests", DurationMinutes = 10 });

    public async ValueTask DisposeAsync()
    {
        disposeCancellation.Cancel();
        StopCopilotPolling();
        if (copilotPollingTask is not null)
        {
            try { await copilotPollingTask; } catch (OperationCanceledException) { }
        }
        copilotPollGate.Dispose();
        disposeCancellation.Dispose();
    }

    private sealed record PlatformOption(string Key, string Label, string Icon);
    private sealed record CategoryOption(string Value, string Title, string Description, string Icon);
    private sealed class TempRule
    {
        public int? ErrorCode { get; set; }
        public string Keywords { get; set; } = string.Empty;
        public int DurationMinutes { get; set; } = 10;
        public string Description { get; set; } = string.Empty;
    }

}
