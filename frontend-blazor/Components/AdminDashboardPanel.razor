@using System.Globalization
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="admin-dashboard">
    @if (loading)
    {
        <LoadingState Text="正在载入系统概览" />
    }
    else if (snapshot is null)
    {
        <ErrorState Message="@(error ?? "仪表盘数据载入失败。")" OnRetry="LoadAllAsync" />
    }
    else
    {
        @if (error is not null)
        {
            <div class="inline-alert warning dashboard-alert" role="alert">
                <Icon Name="alert" Size="18" />
                <span>@error</span>
            </div>
        }

        @if (Stats.StatsStale)
        {
            <div class="inline-alert warning dashboard-alert" role="status">
                <Icon Name="clock" Size="18" />
                <span>统计数据正在后台更新，当前显示最近一次聚合结果@(string.IsNullOrWhiteSpace(Stats.StatsUpdatedAt) ? "。" : $"（{FormatStatsTime(Stats.StatsUpdatedAt)}）。")</span>
            </div>
        }

        <section class="admin-metrics-grid" aria-label="系统关键指标">
            <article class="admin-metric-card">
                <span class="admin-metric-icon blue"><Icon Name="key" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>API 密钥</span>
                    <strong>@FormatNumber(Stats.TotalApiKeys)</strong>
                    <small class="success-text">@FormatNumber(Stats.ActiveApiKeys) 启用</small>
                </div>
            </article>

            <article class="admin-metric-card">
                <span class="admin-metric-icon green"><Icon Name="server" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>账号</span>
                    <strong>@FormatNumber(Stats.TotalAccounts)</strong>
                    <small><b class="success-text">@FormatNumber(Stats.NormalAccounts) 启用</b>@if (Stats.ErrorAccounts > 0) { <b class="danger-text"> · @FormatNumber(Stats.ErrorAccounts) 错误</b> }</small>
                </div>
            </article>

            <article class="admin-metric-card">
                <span class="admin-metric-icon indigo"><Icon Name="activity" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>今日请求</span>
                    <strong>@FormatNumber(Stats.TodayRequests)</strong>
                    <small>总计: @FormatNumber(Stats.TotalRequests)</small>
                </div>
            </article>

            <article class="admin-metric-card">
                <span class="admin-metric-icon amber"><Icon Name="users" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>用户</span>
                    <strong class="success-text">+@FormatNumber(Stats.TodayNewUsers)</strong>
                    <small>总计: @FormatNumber(Stats.TotalUsers)</small>
                </div>
            </article>

            <article class="admin-metric-card wide-copy">
                <span class="admin-metric-icon cyan"><Icon Name="database" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>今日 Token</span>
                    <strong>@FormatTokens(Stats.TodayTokens)</strong>
                    <small class="cost-line">
                        <b class="success-text" title="实际扣费">$@FormatCost(Stats.TodayActualCost)</b>
                        <i>/</i>
                        <b class="account-cost" title="账号成本">$@FormatCost(Stats.TodayAccountCost)</b>
                        <i>/</i>
                        <b title="标准费用">$@FormatCost(Stats.TodayCost)</b>
                    </small>
                </div>
            </article>

            <article class="admin-metric-card wide-copy">
                <span class="admin-metric-icon orange"><Icon Name="database" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>总 Token</span>
                    <strong>@FormatTokens(Stats.TotalTokens)</strong>
                    <small class="cost-line">
                        <b class="success-text" title="实际扣费">$@FormatCost(Stats.TotalActualCost)</b>
                        <i>/</i>
                        <b class="account-cost" title="账号成本">$@FormatCost(Stats.TotalAccountCost)</b>
                        <i>/</i>
                        <b title="标准费用">$@FormatCost(Stats.TotalCost)</b>
                    </small>
                </div>
            </article>

            <article class="admin-metric-card">
                <span class="admin-metric-icon violet"><Icon Name="pulse" Size="20" /></span>
                <div class="admin-metric-content compact-values">
                    <span>性能指标</span>
                    <strong>@FormatTokens(Stats.Rpm) <em>RPM</em></strong>
                    <small><b class="violet-text">@FormatTokens(Stats.Tpm)</b> TPM</small>
                </div>
            </article>

            <article class="admin-metric-card">
                <span class="admin-metric-icon rose"><Icon Name="clock" Size="20" /></span>
                <div class="admin-metric-content">
                    <span>平均响应</span>
                    <strong>@FormatDuration(Stats.AverageDurationMs)</strong>
                    <small>@FormatNumber(Stats.ActiveUsers) 活跃用户</small>
                </div>
            </article>
        </section>

        <section class="dashboard-card dashboard-filter-card" aria-label="统计筛选">
            <div class="dashboard-filter-group primary-filter">
                <label class="filter-label" for="dashboard-start-time">时间范围：</label>
                <div class="dashboard-date-time-range">
                    <input id="dashboard-start-time"
                           class="dashboard-date-time-input"
                           type="datetime-local"
                           step="1"
                           value="@FormatDateTimeInput(startDate)"
                           aria-label="开始时间"
                           disabled="@refreshing"
                           @onchange="OnStartDateTimeChangedAsync" />
                    <span class="range-separator">至</span>
                    <input id="dashboard-end-time"
                           class="dashboard-date-time-input"
                           type="datetime-local"
                           step="1"
                           value="@FormatDateTimeInput(endDate)"
                           aria-label="结束时间"
                           disabled="@refreshing"
                           @onchange="OnEndDateTimeChangedAsync" />
                </div>
                <button type="button" class="button secondary small" disabled="@refreshing" @onclick="LoadAllAsync">刷新</button>
                <div class="dashboard-range-summary" aria-label="所选时间范围汇总">
                    <span class="admin-metric-icon orange"><Icon Name="database" Size="20" /></span>
                    <div class="admin-metric-content">
                        <span>区间 Token</span>
                        <strong>@FormatTokens(RangeTokens)</strong>
                        <small class="cost-line">
                            <b class="success-text" title="实际扣费">$@FormatCost(RangeActualCost)</b>
                            <i>/</i>
                            <b class="account-cost" title="账号成本">$@FormatCost(RangeAccountCost)</b>
                            <i>/</i>
                            <b title="标准费用">$@FormatCost(RangeCost)</b>
                        </small>
                    </div>
                </div>
            </div>
            <div class="dashboard-filter-group granularity-filter">
                <label class="filter-label" for="dashboard-granularity">粒度：</label>
                <select id="dashboard-granularity" value="@granularity" disabled="@refreshing" @onchange="OnGranularityChangedAsync">
                    <option value="day">按天</option>
                    <option value="hour">按小时</option>
                </select>
            </div>
        </section>

        <div class="dashboard-chart-grid">
            <section class="dashboard-card dashboard-chart-card model-distribution-card">
                <div class="dashboard-card-heading chart-heading">
                    <h2>@(activeDistributionView == "models" ? "模型分布" : "用户消费榜")</h2>
                    <div class="segmented-control" role="group" aria-label="分布视图">
                        <button type="button" class="@(activeDistributionView == "models" ? "active" : null)" @onclick='() => activeDistributionView = "models"'>模型分布</button>
                        <button type="button" class="@(activeDistributionView == "ranking" ? "active" : null)" @onclick='() => activeDistributionView = "ranking"'>用户消费榜</button>
                    </div>
                </div>

                @if (activeDistributionView == "models")
                {
                    @if (ModelDistributionRows.Count == 0)
                    {
                        <div class="dashboard-empty">暂无数据</div>
                    }
                    else
                    {
                        <div class="distribution-layout model-distribution-layout">
                            <div class="distribution-chart model-distribution-chart" aria-label="模型 Token 占比">
                                <DxChart T="ModelDistributionRow"
                                         Data="@ModelDistributionRows"
                                         Rotated="true"
                                         Width="100%"
                                         Height="230px"
                                         CustomizeSeriesPoint="CustomizeModelDistributionPoint"
                                         SeriesClick="OnModelDistributionClick">
                                    <DxChartBarSeries T="ModelDistributionRow"
                                                      TArgument="string"
                                                      TValue="double"
                                                      Name="Token 占比"
                                                      Color="@ModelDistributionColor"
                                                      ArgumentField="item => item.Label"
                                                      ValueField="item => item.TokenShare"
                                                      BarPadding="0.32"
                                                      CornerRadius="3">
                                        <DxChartSeriesLabel Visible="true"
                                                            Position="RelativePosition.Outside"
                                                            ValueFormat="ChartElementFormat.Percent(1)" />
                                    </DxChartBarSeries>
                                    <DxChartArgumentAxis Inverted="true" />
                                    <DxChartValueAxis>
                                        <DxChartAxisRange StartValue="0" EndValue="1" />
                                        <DxChartAxisLabel Format="ChartElementFormat.Percent(0)" />
                                    </DxChartValueAxis>
                                    <DxChartLegend Visible="false" />
                                    <DxChartTooltip Enabled="true">
                                        @{
                                            var row = context.Point.DataItems.OfType<ModelDistributionRow>().FirstOrDefault();
                                        }
                                        @if (row is not null)
                                        {
                                            <div class="model-distribution-tooltip">
                                                <strong title="@row.FullLabel">@row.FullLabel</strong>
                                                <dl>
                                                    <div><dt>占比</dt><dd>@FormatPercent(row.TokenShare * 100)</dd></div>
                                                    <div><dt>Token</dt><dd>@FormatTokens(row.TotalTokens)</dd></div>
                                                    <div><dt>请求</dt><dd>@FormatNumber(row.Requests)</dd></div>
                                                    <div><dt>实际费用</dt><dd>$@FormatCost(row.ActualCost)</dd></div>
                                                    <div><dt>账号成本</dt><dd>$@FormatCost(row.AccountCost)</dd></div>
                                                    <div><dt>标准费用</dt><dd>$@FormatCost(row.Cost)</dd></div>
                                                    @if (row.IsOther)
                                                    {
                                                        <div><dt>汇总模型</dt><dd>@ModelDistributionOtherCount</dd></div>
                                                    }
                                                </dl>
                                            </div>
                                        }
                                    </DxChartTooltip>
                                </DxChart>
                            </div>
                            <div class="compact-table-wrap model-distribution-table-wrap">
                                <table class="compact-dashboard-table model-distribution-table">
                                    <thead><tr><th>模型</th><th>请求</th><th>Token</th><th>占比</th><th>实际</th><th>账号成本</th><th>标准</th></tr></thead>
                                    <tbody>
                                        @foreach (var model in ModelRows)
                                        {
                                            <tr class="clickable-row model-row"
                                                title="查看该模型的用户用量明细"
                                                @onclick="() => ToggleModelBreakdownAsync(model)">
                                                <td title="@model.Model">
                                                    <span class="model-name-cell">
                                                        <span class="model-expand-indicator">@(expandedModel == model.Model ? "⌄" : "›")</span>
                                                        <span class="model-name-text">@model.Model</span>
                                                    </span>
                                                </td>
                                                <td>@FormatNumber(model.Requests)</td>
                                                <td>@FormatTokens(model.TotalTokens)</td>
                                                <td class="model-share">@FormatPercent(GetModelShare(model.TotalTokens))</td>
                                                <td class="success-text">$@FormatCost(model.ActualCost)</td>
                                                <td class="account-cost">$@FormatCost(model.AccountCost)</td>
                                                <td>$@FormatCost(model.Cost)</td>
                                            </tr>
                                            @if (expandedModel == model.Model)
                                            {
                                                <tr class="model-breakdown-row">
                                                    <td colspan="7">
                                                        @if (modelBreakdownLoading)
                                                        {
                                                            <div class="model-breakdown-state">正在载入用户明细…</div>
                                                        }
                                                        else if (modelBreakdown.Count == 0)
                                                        {
                                                            <div class="model-breakdown-state">暂无数据</div>
                                                        }
                                                        else
                                                        {
                                                            <table class="model-breakdown-table" aria-label="@($"{model.Model} 用户用量明细")">
                                                                <tbody>
                                                                    @foreach (var user in modelBreakdown)
                                                                    {
                                                                        <tr>
                                                                            <td title="@user.Email">@(string.IsNullOrWhiteSpace(user.Email) ? $"用户 #{user.UserId}" : user.Email)</td>
                                                                            <td>@FormatNumber(user.Requests)</td>
                                                                            <td>@FormatTokens(user.TotalTokens)</td>
                                                                            <td class="model-share">@FormatPercent(GetModelShare(user.TotalTokens))</td>
                                                                            <td class="success-text">$@FormatCost(user.ActualCost)</td>
                                                                            <td class="account-cost">$@FormatCost(user.AccountCost)</td>
                                                                            <td>$@FormatCost(user.Cost)</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                else if (rankingError)
                {
                    <div class="dashboard-empty">用户消费排行载入失败，请点击刷新重试。</div>
                }
                else if (RankingRows.Count == 0)
                {
                    <div class="dashboard-empty">暂无数据</div>
                }
                else
                {
                    <div class="distribution-layout">
                        <div class="distribution-chart">
                            <DxPieChart Data="@RankingRows" InnerDiameter="0" Width="100%" Height="210px">
                                <DxPieChartSeries T="RankingDisplayRow"
                                                  TArgument="string"
                                                  TValue="double"
                                                  ArgumentField="item => item.ChartLabel"
                                                  ValueField="item => item.ActualCost" />
                                <DxChartLegend Visible="false" />
                                <DxChartTooltip Enabled="true" />
                            </DxPieChart>
                        </div>
                        <div class="compact-table-wrap">
                            <table class="compact-dashboard-table ranking-table">
                                <thead><tr><th>用户</th><th>请求</th><th>Token</th><th>消费</th></tr></thead>
                                <tbody>
                                    @foreach (var row in RankingRows)
                                    {
                                        <tr class="@(row.IsOther ? "other-row" : "clickable-row")" @onclick="() => OpenUserUsage(row)">
                                            <td title="@row.DisplayName"><span class="ranking-index">@(row.IsOther ? "Σ" : $"#{row.Rank}")</span> @row.DisplayName</td>
                                            <td>@FormatNumber(row.Requests)</td>
                                            <td>@FormatTokens(row.Tokens)</td>
                                            <td class="success-text">$@FormatCost(row.ActualCost)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </section>

            <section class="dashboard-card dashboard-chart-card">
                <div class="dashboard-card-heading"><h2>Token 使用趋势</h2></div>
                @if (snapshot.Trend.Count == 0)
                {
                    <div class="dashboard-empty">暂无数据</div>
                }
                else
                {
                    <DxChart Data="@snapshot.Trend" Width="100%" Height="250px">
                            <DxChartLineSeries T="AdminDashboardTrendPointDto" TArgument="string" TValue="long"
                                               Name="Input" Color="@(System.Drawing.Color.FromArgb(255, 109, 0))" ArgumentField="point => point.Date" ValueField="point => point.InputTokens" />
                            <DxChartLineSeries T="AdminDashboardTrendPointDto" TArgument="string" TValue="long"
                                               Name="Output" Color="@(System.Drawing.Color.FromArgb(22, 136, 61))" ArgumentField="point => point.Date" ValueField="point => point.OutputTokens" />
                            <DxChartLineSeries T="AdminDashboardTrendPointDto" TArgument="string" TValue="long"
                                               Name="Cache Creation" Color="@(System.Drawing.Color.FromArgb(228, 17, 47))" ArgumentField="point => point.Date" ValueField="point => point.CacheCreationTokens" />
                            <DxChartLineSeries T="AdminDashboardTrendPointDto" TArgument="string" TValue="long"
                                               Name="Cache Read" Color="@(System.Drawing.Color.FromArgb(255, 152, 0))" ArgumentField="point => point.Date" ValueField="point => point.CacheReadTokens" />
                            <DxChartLineSeries T="AdminDashboardTrendPointDto" TArgument="string" TValue="double"
                                               Name="Cache Hit Rate" Color="@(System.Drawing.Color.FromArgb(11, 118, 206))" ArgumentField="point => point.Date" ValueField="point => point.CacheHitRate" Axis="PercentAxis" />
                            <DxChartValueAxis />
                            <DxChartValueAxis Name="PercentAxis" Alignment="ChartAxisAlignment.Far">
                                <DxChartAxisTitle Text="命中率 (%)" />
                            </DxChartValueAxis>
                            <DxChartLegend Visible="true"
                                           Position="RelativePosition.Outside"
                                           HorizontalAlignment="HorizontalAlignment.Center"
                                           VerticalAlignment="VerticalEdge.Top"
                                           Orientation="Orientation.Horizontal" />
                            <DxChartTooltip Enabled="true" />
                        </DxChart>
                }
            </section>
        </div>

        <section class="dashboard-card dashboard-user-trend">
            <div class="dashboard-card-heading"><h2>最近使用（Top 12）</h2></div>
            @if (UserTrendSeries.Count == 0)
            {
                <div class="dashboard-empty">暂无数据</div>
            }
            else
            {
                <DxChart T="AdminDashboardUserTrendPointDto" Width="100%" Height="270px">
                        @foreach (var series in UserTrendSeries)
                        {
                            <DxChartLineSeries T="AdminDashboardUserTrendPointDto" TArgument="string" TValue="long"
                                               Data="@series.Points"
                                               Name="@series.Name"
                                               Color="@series.ChartColor"
                                               ArgumentField="point => point.Date"
                                               ValueField="point => point.Tokens" />
                        }
                        <DxChartLegend Visible="true"
                                           Position="RelativePosition.Outside"
                                           HorizontalAlignment="HorizontalAlignment.Center"
                                           VerticalAlignment="VerticalEdge.Top"
                                           Orientation="Orientation.Horizontal" />
                        <DxChartTooltip Enabled="true" />
                    </DxChart>
            }
        </section>
    }
</div>

@code {
    private AdminDashboardSnapshotDto? snapshot;
    private AdminDashboardRankingResponseDto? ranking;
    // Dashboard datetime end values are inclusive, so this default covers today only.
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddDays(1).AddSeconds(-1);
    private string granularity = "hour";
    private string activeDistributionView = "models";
    private string? expandedModel;
    private List<AdminDashboardUserBreakdownItemDto> modelBreakdown = [];
    private bool loading = true;
    private bool refreshing;
    private bool rankingError;
    private bool modelBreakdownLoading;
    private string? error;
    private int loadGeneration;
    private int breakdownGeneration;
    private bool disposed;
    private IReadOnlyList<AdminDashboardModelStatDto> modelRows = [];
    private IReadOnlyList<ModelDistributionRow> modelDistributionRows = [];
    private long modelTotalTokens;
    private int modelDistributionOtherCount;

    private AdminDashboardStats Stats => snapshot?.Stats ?? new AdminDashboardStats();

    private IReadOnlyList<AdminDashboardModelStatDto> ModelRows => modelRows;

    private long RangeTokens => ModelRows.Sum(item => Math.Max(item.TotalTokens, 0));

    private double RangeActualCost => ModelRows.Sum(item => item.ActualCost);

    private double RangeAccountCost => ModelRows.Sum(item => item.AccountCost);

    private double RangeCost => ModelRows.Sum(item => item.Cost);

    private const int ModelDistributionLimit = 6;
    private const int ModelDistributionLabelLimit = 24;
    private const string OtherModelsLabel = "其他模型";
    private static readonly System.Drawing.Color ModelDistributionColor = System.Drawing.Color.FromArgb(22, 126, 99);
    private static readonly System.Drawing.Color ModelDistributionOtherColor = System.Drawing.Color.FromArgb(125, 136, 131);

    private long ModelTotalTokens => modelTotalTokens;

    private int ModelDistributionOtherCount => modelDistributionOtherCount;

    private IReadOnlyList<ModelDistributionRow> ModelDistributionRows => modelDistributionRows;

    private void RefreshModelDistribution()
    {
        modelRows = snapshot?.Models
            .OrderByDescending(item => item.TotalTokens)
            .ThenByDescending(item => item.Requests)
            .ThenBy(item => item.Model, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];
        modelTotalTokens = modelRows.Sum(item => Math.Max(item.TotalTokens, 0));

        var models = modelRows.Where(item => item.TotalTokens > 0).ToList();
        modelDistributionOtherCount = Math.Max(models.Count - ModelDistributionLimit, 0);
        if (models.Count == 0)
        {
            modelDistributionRows = [];
            return;
        }

        var totalTokens = models.Sum(item => item.TotalTokens);
        var chartLabels = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var rows = models.Take(ModelDistributionLimit)
            .Select(item => new ModelDistributionRow(
                CreateUniqueModelChartLabel(item.Model, chartLabels),
                item.Model,
                item.Requests,
                item.TotalTokens,
                item.ActualCost,
                item.AccountCost,
                item.Cost,
                item.TotalTokens / (double)totalTokens,
                false,
                item))
            .ToList();

        var otherModels = models.Skip(ModelDistributionLimit).ToList();
        if (otherModels.Count > 0)
        {
            var otherTokens = otherModels.Sum(item => item.TotalTokens);
            var otherChartLabel = models.Any(item => string.Equals(item.Model?.Trim(), OtherModelsLabel, StringComparison.OrdinalIgnoreCase))
                ? $"{OtherModelsLabel}（汇总）"
                : OtherModelsLabel;
            rows.Add(new ModelDistributionRow(
                CreateUniqueModelChartLabel(otherChartLabel, chartLabels),
                otherChartLabel,
                otherModels.Sum(item => item.Requests),
                otherTokens,
                otherModels.Sum(item => item.ActualCost),
                otherModels.Sum(item => item.AccountCost),
                otherModels.Sum(item => item.Cost),
                otherTokens / (double)totalTokens,
                true,
                null));
        }

        modelDistributionRows = rows;
    }

    private static readonly UserTrendColor[] UserTrendPalette =
    [
        new(System.Drawing.Color.FromArgb(217, 95, 2)),
        new(System.Drawing.Color.FromArgb(117, 112, 179)),
        new(System.Drawing.Color.FromArgb(27, 158, 119)),
        new(System.Drawing.Color.FromArgb(231, 41, 138)),
        new(System.Drawing.Color.FromArgb(102, 166, 30)),
        new(System.Drawing.Color.FromArgb(230, 171, 2)),
        new(System.Drawing.Color.FromArgb(166, 118, 29)),
        new(System.Drawing.Color.FromArgb(31, 120, 180)),
        new(System.Drawing.Color.FromArgb(177, 89, 40)),
        new(System.Drawing.Color.FromArgb(106, 61, 154)),
        new(System.Drawing.Color.FromArgb(35, 139, 69)),
        new(System.Drawing.Color.FromArgb(99, 99, 99))
    ];

    private IReadOnlyList<UserTrendSeriesRow> UserTrendSeries => snapshot?.UsersTrend
        .GroupBy(point => point.UserId)
        .Select(group => new
        {
            Name = GetUserDisplayName(group.First()),
            Points = group.OrderBy(point => point.Date).ToList()
        })
        .OrderByDescending(series => series.Points.Sum(point => point.Tokens))
        .Select((series, index) => new UserTrendSeriesRow(
            series.Name,
            series.Points,
            UserTrendPalette[index % UserTrendPalette.Length].Chart))
        .ToList() ?? [];

    private IReadOnlyList<RankingDisplayRow> RankingRows
    {
        get
        {
            if (ranking?.Ranking is not { Count: > 0 }) return [];

            var rows = ranking.Ranking.Select((item, index) => new RankingDisplayRow(
                item.UserId,
                index + 1,
                GetUserDisplayName(item),
                item.Email,
                item.Requests,
                item.Tokens,
                item.ActualCost,
                false)).ToList();

            var rankedCost = rows.Sum(item => item.ActualCost);
            var rankedRequests = rows.Sum(item => item.Requests);
            var rankedTokens = rows.Sum(item => item.Tokens);
            var otherCost = Math.Max(ranking.TotalActualCost - rankedCost, 0);
            var otherRequests = Math.Max(ranking.TotalRequests - rankedRequests, 0);
            var otherTokens = Math.Max(ranking.TotalTokens - rankedTokens, 0);
            if (otherCost > 0.000001 || otherRequests > 0 || otherTokens > 0)
            {
                rows.Add(new RankingDisplayRow(0, 0, "其他用户", string.Empty, otherRequests, otherTokens, otherCost, true));
            }

            return rows;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private Task LoadAllAsync() => LoadDashboardAsync(includeStats: true);

    private async Task LoadChartDataAsync()
    {
        await LoadDashboardAsync(includeStats: false);
    }

    private async Task LoadDashboardAsync(bool includeStats)
    {
        var generation = ++loadGeneration;
        var initialLoad = snapshot is null;
        if (initialLoad) loading = true;
        refreshing = true;
        error = null;
        rankingError = false;

        var start = FormatDashboardTime(startDate);
        var end = FormatDashboardTime(endDate);
        var timezone = TimeZoneInfo.Local.Id;
        var snapshotTask = Api.GetAdminDashboardSnapshotAsync(start, end, granularity, includeStats, timezone);
        var rankingTask = Api.GetAdminDashboardRankingAsync(start, end, 12, timezone);

        AdminDashboardSnapshotDto? nextSnapshot = null;
        AdminDashboardRankingResponseDto? nextRanking = null;
        string? snapshotError = null;
        try
        {
            nextSnapshot = await snapshotTask;
        }
        catch (ApiException ex)
        {
            snapshotError = ex.Message;
        }

        try
        {
            nextRanking = await rankingTask;
        }
        catch (ApiException)
        {
            rankingError = true;
        }

        if (disposed || generation != loadGeneration) return;

        if (nextSnapshot is not null)
        {
            if (!includeStats && nextSnapshot.Stats is null)
            {
                nextSnapshot.Stats = snapshot?.Stats;
            }
            snapshot = nextSnapshot;
            RefreshModelDistribution();
        }
        if (nextRanking is not null) ranking = nextRanking;
        if (snapshotError is not null) error = snapshotError;

        loading = false;
        refreshing = false;
    }

    private async Task OnStartDateTimeChangedAsync(ChangeEventArgs args)
    {
        if (!TryParseDateTimeInput(args.Value?.ToString(), out var value)) return;
        startDate = value;
        if (endDate <= startDate) endDate = startDate.AddSeconds(1);
        ClearModelBreakdown();
        UpdateGranularityForRange();
        await LoadChartDataAsync();
    }

    private async Task OnEndDateTimeChangedAsync(ChangeEventArgs args)
    {
        if (!TryParseDateTimeInput(args.Value?.ToString(), out var value)) return;
        endDate = value;
        if (endDate <= startDate) startDate = endDate.AddSeconds(-1);
        ClearModelBreakdown();
        UpdateGranularityForRange();
        await LoadChartDataAsync();
    }

    private async Task OnGranularityChangedAsync(ChangeEventArgs args)
    {
        granularity = string.Equals(args.Value?.ToString(), "day", StringComparison.OrdinalIgnoreCase) ? "day" : "hour";
        await LoadChartDataAsync();
    }

    private void UpdateGranularityForRange()
    {
        granularity = (endDate - startDate).TotalDays <= 1 ? "hour" : "day";
    }

    private void OpenUserUsage(RankingDisplayRow row)
    {
        if (row.IsOther || row.UserId <= 0) return;
        var start = Uri.EscapeDataString(FormatDashboardTime(startDate));
        // The usage page uses an exclusive end boundary while dashboard end values are inclusive.
        var end = Uri.EscapeDataString(FormatDashboardTime(endDate.AddSeconds(1)));
        var email = Uri.EscapeDataString(row.Email);
        Navigation.NavigateTo($"/admin/usage?user_id={row.UserId}&user_email={email}&start_date={start}&end_date={end}");
    }

    private async Task OnModelDistributionClick(ChartSeriesClickEventArgs args)
    {
        var row = args.Point?.DataItems.OfType<ModelDistributionRow>().FirstOrDefault();
        if (row?.Source is not null)
            await ToggleModelBreakdownAsync(row.Source);
    }

    private static void CustomizeModelDistributionPoint(ChartSeriesPointCustomizationSettings settings)
    {
        var row = settings.Point.DataItems.OfType<ModelDistributionRow>().FirstOrDefault();
        settings.PointAppearance.Color = row?.IsOther == true
            ? ModelDistributionOtherColor
            : ModelDistributionColor;
    }

    private async Task ToggleModelBreakdownAsync(AdminDashboardModelStatDto model)
    {
        if (string.Equals(expandedModel, model.Model, StringComparison.Ordinal))
        {
            ClearModelBreakdown();
            return;
        }

        var generation = ++breakdownGeneration;
        expandedModel = model.Model;
        modelBreakdown = [];
        modelBreakdownLoading = true;
        try
        {
            var response = await Api.GetAdminDashboardUserBreakdownAsync(
                FormatDashboardTime(startDate),
                FormatDashboardTime(endDate),
                model.Model,
                "requested",
                50,
                TimeZoneInfo.Local.Id);
            if (!disposed && generation == breakdownGeneration)
                modelBreakdown = response.Users;
        }
        catch (ApiException)
        {
            if (!disposed && generation == breakdownGeneration)
                modelBreakdown = [];
        }
        finally
        {
            if (!disposed && generation == breakdownGeneration)
                modelBreakdownLoading = false;
        }
    }

    private void ClearModelBreakdown()
    {
        breakdownGeneration++;
        expandedModel = null;
        modelBreakdown = [];
        modelBreakdownLoading = false;
    }

    private static string FormatDateTimeInput(DateTime value) => FormatDashboardTime(value);

    private static string FormatDashboardTime(DateTime value) =>
        value.ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture);

    private static bool TryParseDateTimeInput(string? value, out DateTime dateTime) =>
        DateTime.TryParseExact(
            value,
            ["yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm"],
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out dateTime);

    private static string GetUserDisplayName(AdminDashboardUserTrendPointDto item) =>
        !string.IsNullOrWhiteSpace(item.Username) ? item.Username.Trim()
            : !string.IsNullOrWhiteSpace(item.Email) ? item.Email.Trim()
            : $"用户 #{item.UserId}";

    private static string GetUserDisplayName(AdminDashboardRankingItemDto item) =>
        !string.IsNullOrWhiteSpace(item.Username) ? item.Username.Trim()
            : !string.IsNullOrWhiteSpace(item.Email) ? item.Email.Trim()
            : $"用户 #{item.UserId}";

    private static string FormatNumber(long value) => value.ToString("N0");

    private double GetModelShare(long tokens) => ModelTotalTokens > 0
        ? Math.Max(tokens, 0) * 100d / ModelTotalTokens
        : 0;

    private static string CreateUniqueModelChartLabel(string value, ISet<string> usedLabels)
    {
        var fullLabel = string.IsNullOrWhiteSpace(value) ? "未命名模型" : value.Trim();
        var textElementIndexes = System.Globalization.StringInfo.ParseCombiningCharacters(fullLabel);
        for (var index = 1; ; index++)
        {
            var suffix = index == 1 ? string.Empty : $" ({index})";
            var prefixLimit = Math.Max(4, ModelDistributionLabelLimit - suffix.Length);
            var prefix = textElementIndexes.Length <= prefixLimit
                ? fullLabel
                : $"{fullLabel[..textElementIndexes[prefixLimit - 3]]}...";
            var candidate = prefix + suffix;
            if (usedLabels.Add(candidate)) return candidate;
        }
    }

    private static string FormatPercent(double value) => value switch
    {
        >= 10 => $"{value:0.0}%",
        >= 1 => $"{value:0.00}%",
        > 0 => $"{value:0.000}%",
        _ => "0.0%"
    };

    private static string FormatTokens(long value) => value switch
    {
        >= 1_000_000_000 => $"{value / 1_000_000_000d:0.00}B",
        >= 1_000_000 => $"{value / 1_000_000d:0.00}M",
        >= 1_000 => $"{value / 1_000d:0.00}K",
        _ => value.ToString("N0")
    };

    private static string FormatCost(double value) => value switch
    {
        >= 1000 => $"{value / 1000:0.00}K",
        >= 1 => value.ToString("0.00"),
        >= 0.01 => value.ToString("0.000"),
        _ => value.ToString("0.0000")
    };

    private static string FormatDuration(double milliseconds) =>
        milliseconds >= 1000 ? $"{milliseconds / 1000:0.00}s" : $"{Math.Round(milliseconds):0}ms";

    private static string FormatStatsTime(string value) =>
        DateTimeOffset.TryParse(value, out var parsed) ? parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : value;

    public void Dispose()
    {
        disposed = true;
        loadGeneration++;
        breakdownGeneration++;
    }

    private sealed record UserTrendColor(System.Drawing.Color Chart);

    private sealed record UserTrendSeriesRow(
        string Name,
        List<AdminDashboardUserTrendPointDto> Points,
        System.Drawing.Color ChartColor);

    private sealed record ModelDistributionRow(
        string Label,
        string FullLabel,
        long Requests,
        long TotalTokens,
        double ActualCost,
        double AccountCost,
        double Cost,
        double TokenShare,
        bool IsOther,
        AdminDashboardModelStatDto? Source);

    public sealed record RankingDisplayRow(
        long UserId,
        int Rank,
        string DisplayName,
        string Email,
        long Requests,
        long Tokens,
        double ActualCost,
        bool IsOther)
    {
        public string ChartLabel => IsOther ? "其他用户" : $"#{Rank} {DisplayName}";
    }
}
