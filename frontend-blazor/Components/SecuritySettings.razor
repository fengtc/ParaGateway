    private async Task LoadTotpStatusAsync()
    {
        totpLoading = true;
        try { totp = await Api.GetTotpStatusAsync(); }
        catch (ApiException ex) { securityError = ex.Message; }
        finally { totpLoading = false; }
    }

    private async Task BeginSetupTotpAsync()
    {
        ResetTotpSetup(); showTotpSetup = true; totpMethodLoading = true; securityError = null;
        try { totpMethod = NormalizeTotpMethod((await Api.GetTotpVerificationMethodAsync()).Method); }
        catch (ApiException ex) { securityError = ex.Message; showTotpSetup = false; }
        finally { totpMethodLoading = false; }
    }

    private async Task PrepareTotpSetupAsync()
    {
        if (!CanProceedTotpSetup) return;
        totpBusy = true; securityError = null;
        try
        {
            totpSetup = await Api.SetupTotpAsync(totpMethod == "email" ? totpSetupEmailCode : null, totpMethod == "password" ? totpSetupPassword : null);
            totpQrSvgDataUri = CreateQrSvgDataUri(totpSetup.QrCodeUrl);
            totpSetupStep = 1;
        }
        catch (ApiException ex) { securityError = ex.Message; }
        finally { totpBusy = false; }
    }

    private async Task EnableTotpAsync()
    {
        if (totpSetup is null || totpEnableCode.Length != 6) return;
        totpBusy = true; securityError = null;
        try
        {
            await Api.EnableTotpAsync(totpEnableCode, totpSetup.SetupToken);
            CloseTotpSetup(); await LoadTotpStatusAsync(); Toasts.Success("双因素认证已启用");
        }
        catch (ApiException ex) { securityError = ex.Message; totpEnableCode = string.Empty; }
        finally { totpBusy = false; }
    }

    private async Task BeginDisableTotpAsync()
    {
        showTotpDisable = true; totpMethodLoading = true; totpDisableEmailCode = string.Empty; totpDisablePassword = string.Empty; securityError = null;
        try { totpMethod = NormalizeTotpMethod((await Api.GetTotpVerificationMethodAsync()).Method); }
        catch (ApiException ex) { securityError = ex.Message; showTotpDisable = false; }
        finally { totpMethodLoading = false; }
    }

    private async Task DisableTotpAsync()
    {
        if (!CanDisableTotp) return;
        totpBusy = true; securityError = null;
        try
        {
            await Api.DisableTotpAsync(totpMethod == "email" ? totpDisableEmailCode : null, totpMethod == "password" ? totpDisablePassword : null);
            CloseTotpDisable(); await LoadTotpStatusAsync(); Toasts.Success("双因素认证已禁用");
        }
        catch (ApiException ex) { securityError = ex.Message; }
        finally { totpBusy = false; }
    }

    private async Task SendTotpCodeAsync(TotpCodePurpose purpose)
    {
        if (purpose == TotpCodePurpose.Setup) totpSetupSendingCode = true; else totpDisableSendingCode = true;
        securityError = null;
        try
        {
            await Api.SendTotpVerifyCodeAsync();
            if (purpose == TotpCodePurpose.Setup) totpSetupCodeCooldown = 60; else totpDisableCodeCooldown = 60;
            EnsureCountdownTimer(); Toasts.Success("验证码已发送到您的邮箱");
        }
        catch (ApiException ex) { securityError = ex.Message; }
        finally { if (purpose == TotpCodePurpose.Setup) totpSetupSendingCode = false; else totpDisableSendingCode = false; }
    }

    private async Task CopyTotpSecretAsync()
    {
        if (totpSetup is null) return;
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", totpSetup.Secret);
        Toasts.Success("密钥已复制");
    }

    private static string? CreateQrSvgDataUri(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        using var data = QRCodeGenerator.GenerateQrCode(value, QRCodeGenerator.ECCLevel.M);
        var svg = new SvgQRCode(data).GetGraphic(5, "#17201d", "#ffffff", true);
        return $"data:image/svg+xml;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg))}";
    }

    private void CloseTotpSetup() { showTotpSetup = false; ResetTotpSetup(); }
    private void ResetTotpSetup() { totpSetup = null; totpQrSvgDataUri = null; totpSetupStep = 0; totpSetupEmailCode = string.Empty; totpSetupPassword = string.Empty; totpEnableCode = string.Empty; }
    private void CloseTotpDisable() { showTotpDisable = false; totpDisableEmailCode = string.Empty; totpDisablePassword = string.Empty; }

    private async Task LoadPasskeysAsync()
    {
        passkeyLoading = true;
        try { passkeys.Clear(); passkeys.AddRange(await Api.GetPasskeysAsync()); }
        catch (ApiException ex) when (ex.Message.Contains("PASSKEY_DISABLED", StringComparison.OrdinalIgnoreCase)) { }
        catch (ApiException) { securityError = "加载 Passkey 失败。"; }
        finally { passkeyLoading = false; }
    }

    private void ShowPasskeyAddForm() { showPasskeyAddForm = true; newPasskeyName = string.Empty; newPasskeyPassword = string.Empty; }
    private void CancelPasskeyAdd() { showPasskeyAddForm = false; newPasskeyName = string.Empty; newPasskeyPassword = string.Empty; }

    private async Task RegisterPasskeyAsync()
    {
        if (string.IsNullOrEmpty(newPasskeyPassword)) return;
        passkeyBusy = true; securityError = null;
        try
        {
            var begin = await Api.BeginPasskeyRegistrationAsync(newPasskeyPassword);
            var session = begin.TryGetProperty("session_token", out var token) ? token.GetString() : null;
            var options = begin.TryGetProperty("options", out var optionValue) ? optionValue : default;
            if (string.IsNullOrWhiteSpace(session) || options.ValueKind == JsonValueKind.Undefined) throw new ApiException("后端未返回 Passkey 注册参数。");
            var publicKey = options.TryGetProperty("publicKey", out var publicKeyValue) ? publicKeyValue : options;
            var credential = await Js.InvokeAsync<JsonElement>("paraGateway.passkeyCreate", publicKey);
            await Api.FinishPasskeyRegistrationAsync(session, newPasskeyName.Trim(), credential);
            CancelPasskeyAdd(); await LoadPasskeysAsync(); Toasts.Success("Passkey 已添加。");
        }
        catch (JSException ex) when (ex.Message.Contains("NotAllowedError", StringComparison.OrdinalIgnoreCase)) { }
        catch (JSException ex) { securityError = ex.Message; }
        catch (ApiException ex) { securityError = ex.Message; }
        finally { passkeyBusy = false; }
    }

    private async Task RenamePasskeyAsync(PasskeyCredentialDto item)
    {
        var name = (await Js.InvokeAsync<string?>("paraGateway.prompt", "请输入新的 Passkey 名称", item.Name))?.Trim();
        if (string.IsNullOrWhiteSpace(name) || name == item.Name) return;
        passkeyBusy = true; securityError = null;
        try { await Api.RenamePasskeyAsync(item.Id, name); item.Name = name; Toasts.Success("Passkey 已重命名。"); }
        catch (ApiException) { securityError = "重命名 Passkey 失败。"; }
        finally { passkeyBusy = false; }
    }

    private void OpenPasskeyDelete(PasskeyCredentialDto item) { passkeyDeleteTarget = item; passkeyDeletePassword = string.Empty; }
    private void ClosePasskeyDelete() { passkeyDeleteTarget = null; passkeyDeletePassword = string.Empty; }

    private async Task ConfirmDeletePasskeyAsync()
    {
        var target = passkeyDeleteTarget;
        if (target is null || string.IsNullOrEmpty(passkeyDeletePassword)) return;
        passkeyBusy = true; securityError = null;
        try { await Api.DeletePasskeyAsync(target.Id, passkeyDeletePassword); passkeys.Remove(target); Toasts.Success("Passkey 已删除。"); ClosePasskeyDelete(); }
        catch (ApiException ex) { securityError = ex.Message; }
        finally { passkeyBusy = false; }
    }

    private void EnsureCountdownTimer()
    {
        countdownTimer ??= new System.Threading.Timer(_ => _ = InvokeAsync(TickCountdowns), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void TickCountdowns()
    {
        if (savedVerifyCountdown > 0) savedVerifyCountdown--;
        if (totpSetupCodeCooldown > 0) totpSetupCodeCooldown--;
        if (totpDisableCodeCooldown > 0) totpDisableCodeCooldown--;
        foreach (var pending in pendingEmails)
        {
            if (pending.Countdown > 0) pending.Countdown--;
        }
        StateHasChanged();
    }

    private static bool ReadChecked(object? value) => value is bool flag ? flag : bool.TryParse(value?.ToString(), out var parsed) && parsed;
    private static double ParseThreshold(string value) => string.IsNullOrWhiteSpace(value) ? 0 : double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed) ? parsed : -1;
    private static bool IsUsableEmail(string value) => !string.IsNullOrWhiteSpace(value) && !value.EndsWith(".invalid", StringComparison.OrdinalIgnoreCase) && new EmailAddressAttribute().IsValid(value);
    private static string Digits(string? value, int maxLength) => new((value ?? string.Empty).Where(char.IsDigit).Take(maxLength).ToArray());
    private static string NormalizeTotpMethod(string value) => value.Equals("email", StringComparison.OrdinalIgnoreCase) ? "email" : "password";
    private static string FormatPasskeyDate(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy年M月d日");

    public void Dispose() => countdownTimer?.Dispose();

    private enum TotpCodePurpose { Setup, Disable }

    private sealed class PendingNotifyEmail(string email)
    {
        public string Email { get; } = email;
        public bool CodeSent { get; set; }
        public string Code { get; set; } = string.Empty;
        public bool Sending { get; set; }
        public bool Verifying { get; set; }
        public int Countdown { get; set; }
    }
}
