    private void CancelSavedEmailVerification() { savedVerifyingEmail = string.Empty; savedVerifyCode = string.Empty; savedVerifyCountdown = 0; }

    private async Task ToggleNotifyEmailAsync(NotifyEmailEntryDto entry)
